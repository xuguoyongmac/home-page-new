---
import type { Locale } from '../../../data/types';
import Icon from '../../../components/Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (cn: string, en: string) => zh ? cn : en;
---
<div class="continuity-art" aria-hidden="true">
  <div class="assignment-materials">
    <div class="assignment-entries"><span><Icon name="message" size={15}/>{t('会话交办','Conversation')}</span><span><Icon name="clock" size={15}/>{t('每周定时','Weekly schedule')}</span></div>
    <div class="assignment-request"><strong>{t('整理本周项目周报','Prepare the project weekly report')}</strong><p>{t('汇总项目进度，列出风险与下一步待办。','Summarize progress, risks, and next actions.')}</p></div>
    <div class="assignment-file"><Icon name="chart" size={19}/><span>{t('项目计划与进度.xlsx','Project plan and progress.xlsx')}</span></div>
    <div class="assignment-file"><Icon name="file" size={19}/><span>{t('周报编制规范.md','Weekly report guide.md')}</span></div>
  </div>
  <div class="continuity-arrow"><Icon name="arrow" size={26}/></div>
  <div class="employee-execution">
    <div class="execution-person"><img src="/images/product/digital-employees/employee-portrait-public-service_V1.1.webp" width="36" height="36" alt="" loading="lazy"/><div><strong>{t('项目周报专员','Project reporting specialist')}</strong><span>{t('按岗位规则执行','Execute with role rules')}</span></div></div>
    <div class="execution-checklist">{[t('归集项目进展','Collect project progress'),t('对照计划整理偏差','Compare progress against plan'),t('汇总风险与待办','Prepare risks and next actions')].map(text=><span><Icon name="check" size={14}/>{text}</span>)}</div>
  </div>
  <div class="continuity-arrow"><Icon name="arrow" size={26}/></div>
  <div class="report-delivery">
    <div class="report-preview"><div class="report-name"><Icon name="file-check" size={19}/><strong>{t('项目周报.docx','Project weekly report.docx')}</strong></div><div class="report-sections">{[t('本周进展','This week’s progress'),t('风险与依赖','Risks and dependencies'),t('下周安排','Next week’s plan')].map(text=><span><Icon name="check" size={12}/>{text}</span>)}</div></div>
    <div class="review-delivery"><Icon name="users" size={16}/>{t('交由项目负责人审阅','Project owner reviews the report')}</div>
  </div>
  <div class="work-memory"><Icon name="book" size={17}/><strong>{t('工作记忆','Work memory')}</strong><span>{t('已确认项目口径 · 上轮未结事项','Confirmed project context · Open actions')}</span><span class="memory-next"><Icon name="arrow" size={15}/>{t('接续下一轮','Carry into the next run')}</span></div>
</div>
<style>
.continuity-art{display:grid;grid-template-columns:minmax(0,1fr) 34px minmax(0,1fr) 34px minmax(0,1.08fr);gap:16px;align-items:center;position:relative;padding:20px 4px 12px;color:#bed0e2;font-size:13px;line-height:1.7}.continuity-art :global(svg){flex-shrink:0;color:#8eb6de}.continuity-art strong{font-weight:550}.assignment-entries{display:flex;flex-wrap:wrap;gap:12px;color:#9ebcdb;font-size:12px;margin-bottom:18px}.assignment-entries>span{display:flex;gap:5px;align-items:center}.assignment-entries>span:last-child :global(svg){color:#b5add5}.assignment-request{padding:17px 16px;background:#122334;border:1px solid #86aac62e;border-radius:6px;box-shadow:0 8px 20px #0003}.assignment-request>strong{font-size:15px;color:#dce8f6}.assignment-request>p{font-size:12px;line-height:1.8;color:#98afc6;margin:9px 0 0}.assignment-file{display:flex;align-items:center;gap:8px;padding:12px 11px;margin-top:9px;border:1px solid #8ba9c31a;border-radius:4px;background:#101d2b;font-size:12px}.assignment-file :global(svg){color:#97b4c8}.continuity-arrow{display:flex;align-items:center;justify-content:center}.employee-execution{padding:24px 20px;background:linear-gradient(135deg,#1c3c56,#11283c);border:1px solid #93bfe847;border-radius:8px;box-shadow:0 15px 28px -7px #0008,0 2px 8px #0004}.execution-person{display:flex;gap:10px;align-items:center}.execution-person>img{width:36px;height:36px;object-fit:cover;border-radius:7px;box-shadow:0 4px 12px #0004}.execution-person strong{display:block;color:#e4effb;font-size:15px}.execution-person div>span{display:block;font-size:11px;color:#8eabc7;margin-top:3px}.execution-checklist{display:grid;gap:15px;margin-top:24px}.execution-checklist>span{display:flex;gap:7px;align-items:center;font-size:12px}.execution-checklist :global(svg){color:#8fc7ba}.report-preview{padding:21px 19px;background:linear-gradient(135deg,#1c3047,#142131);border:1px solid #9dafd73b;border-radius:7px;box-shadow:0 14px 27px -8px #0008,0 2px 8px #0003}.report-name{display:flex;gap:8px;align-items:center;color:#dce8f5}.report-name>strong{font-size:14px}.report-name :global(svg){color:#a4b6e4}.report-sections{display:grid;gap:14px;margin-top:20px;padding-top:17px;border-top:1px solid #a8c3da22}.report-sections>span{display:flex;gap:7px;align-items:center;font-size:12px;color:#b2c6da}.report-sections :global(svg){color:#92b4c7}.review-delivery{display:flex;gap:7px;align-items:center;font-size:12px;color:#9bb7c5;margin:17px 0 0 3px}.work-memory{position:relative;grid-column:3/6;display:flex;gap:8px 12px;align-items:center;flex-wrap:wrap;padding:17px 18px;margin-top:24px;border:1px dashed #91a6d044;border-radius:5px;color:#a0b2d0;background:#0d1925;font-size:12px}.work-memory::before{content:'';position:absolute;left:22%;bottom:100%;height:29px;border-left:1px dashed #91a6d055}.work-memory>strong{font-size:13px;color:#bdcbe0}.work-memory>span:not(.memory-next){color:#94a9c1}.memory-next{display:flex;gap:5px;align-items:center;margin-left:auto;color:#a1bfdc;font-size:11px}.memory-next :global(svg){transform:rotate(-90deg)}
@media(max-width:980px) and (min-width:721px){.continuity-art{gap:11px;grid-template-columns:minmax(0,1fr) 20px minmax(0,1fr) 20px minmax(0,1fr)}.employee-execution{padding:19px 13px}.execution-person{gap:7px}.execution-person strong{font-size:13px}.report-preview{padding:18px 13px}.report-name>strong{font-size:12px}.assignment-request{padding:15px 12px}.assignment-request>strong{font-size:13px}.work-memory{grid-column:1/-1;margin-top:16px}}
@media(max-width:720px){.continuity-art{grid-template-columns:1fr;gap:14px;padding:0 3px}.assignment-entries{gap:17px;margin-bottom:14px}.assignment-request{padding:20px}.assignment-request>strong{font-size:16px}.assignment-request>p{font-size:13px}.assignment-file{padding:13px 15px;font-size:13px}.continuity-arrow{height:22px}.continuity-arrow :global(svg){transform:rotate(90deg)}.employee-execution{padding:24px}.execution-person strong{font-size:16px}.execution-checklist{gap:16px;margin-top:21px}.execution-checklist>span{font-size:13px}.report-preview{padding:24px}.report-name>strong{font-size:15px}.report-sections>span{font-size:13px}.review-delivery{font-size:12px}.work-memory{grid-column:1;margin-top:15px;padding:18px 16px;gap:8px}.work-memory::before{left:50%;height:29px}.work-memory>span:not(.memory-next){width:100%;font-size:12px}.memory-next{margin-left:0;margin-top:4px}}
</style>
