---
import Icon from '../../../components/Icon.astro';
import AgentNode from './AgentNode.astro';
import type { Locale } from '../../../data/types';
interface Props { locale: Locale; scene: 'overview' | 'assignment' | 'execution' | 'delivery'; }
const { locale, scene } = Astro.props;
const zh = locale === 'zh';
const kinds = ['search', 'extract', 'analysis'] as const;
const tasks = zh ? ['企业背景核对', '财务资料核对', '业务风险梳理'] : ['Company background', 'Financial review', 'Business review'];
const requirements = zh ? ['输入：企业与项目资料', '输入：财务报表与明细', '输入：合同与业务说明'] : ['Input: company and project records', 'Input: statements and supporting records', 'Input: contracts and business descriptions'];
const results = zh ? ['企业背景', '财务要点', '业务疑点'] : ['Company background', 'Financial highlights', 'Business questions'];
const returned = zh ? ['背景摘要与来源', '财务要点与差异', '业务疑点与复核事项'] : ['Background and sources', 'Financial points and differences', 'Questions for human review'];
const descriptions = zh ? ['企业与项目背景及来源', '财务字段与材料差异', '合同疑点与复核事项'] : ['Company and project context with sources', 'Financial figures and record differences', 'Contract questions and review items'];
const labels = zh ? {
  overview: '主 Agent 居中调度，向专业子 Agent 分派任务并接收状态和结果，再汇总输出',
  assignment: '同一尽调目标分为企业背景、财务资料和业务风险三项核对，各自使用已提供的对应资料',
  execution: '三个专业子任务各自核对对应输入资料，独立执行并将状态与结果回传主任务',
  delivery: '企业背景、财务要点和业务疑点回到主 Agent，统一组织为尽调报告材料',
} : {
  overview: 'A main Agent delegates to specialist Agents, receives their states and results, and assembles the output',
  assignment: 'One due diligence goal branches into company, finance and business review, each with its own supplied records',
  execution: 'Three specialists independently review their own supplied records and return states and results to the main task',
  delivery: 'Company background, financial points and business questions return to the main Agent for due diligence report materials',
};
const prefix = `ma-${scene}`;
---
<figure class:list={['ma-diagram', `ma-diagram-${scene}`, 'ma-artwork']} aria-label={labels[scene]}>
  <svg class="ma-art-defs" width="0" height="0" aria-hidden="true">
    <defs>
      <linearGradient id={`${prefix}-blue`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2={scene === 'execution' ? 1200 : 660} y2="0"><stop stop-color="#376b9c"/><stop offset=".55" stop-color="#83c6ff"/><stop offset="1" stop-color="#438ac3"/></linearGradient>
      <linearGradient id={`${prefix}-teal`} gradientUnits="userSpaceOnUse" x1="660" y1="0" x2="0" y2="0"><stop stop-color="#315568"/><stop offset=".55" stop-color="#6dbec4"/><stop offset="1" stop-color="#376f82"/></linearGradient>
      <marker id={`${prefix}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="m2 1 6 4-6 4" fill="none" stroke="#93c9f3" stroke-width="1.2"/></marker>
      <marker id={`${prefix}-return-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="m2 1 6 4-6 4" fill="none" stroke="#8fcbd1" stroke-width="1.2"/></marker>
    </defs>
  </svg>
  {scene === 'overview' && <div class="ma-topology ma-art-canvas">
    <svg class="ma-art-routes ma-topology-desktop" viewBox="0 0 660 520" preserveAspectRatio="none" aria-hidden="true">
      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}>
        <path d="M320 184C371 184 367 100 435 100"/><path d="M320 230H435"/><path d="M320 276C371 276 367 420 435 420"/>
      </g>
      <g class="ma-routes-teal" style={`--route-color:url(#${prefix}-teal)`}>
        <path d="M435 120C374 120 371 205 320 205"/><path d="M435 253H320"/><path d="M435 440C367 440 370 297 320 297"/>
      </g>
      <g class="ma-port-routes"><path d="M95 91C95 146 88 173 110 192" marker-end={`url(#${prefix}-arrow)`}/><path d="M110 283C86 324 95 365 95 410" marker-end={`url(#${prefix}-arrow)`}/></g>
    </svg>
    <svg class="ma-art-routes ma-topology-mobile" viewBox="0 0 354 530" preserveAspectRatio="none" aria-hidden="true">
      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}><path d="M177 185V237M53 237H301M53 237V268M177 237V268M301 237V268"/></g>
      <g class="ma-routes-teal" style={`--route-color:url(#${prefix}-teal)`}><path d="M53 372V424H322V145H270"/><path d="M177 372V424M301 372V424"/></g>
      <g class="ma-port-routes"><path d="M177 51V85" marker-end={`url(#${prefix}-arrow)`}/><path d="M80 145H30V474H142" marker-end={`url(#${prefix}-arrow)`}/></g>
    </svg>
    <div class="ma-topology-port ma-topology-input"><Icon name="message" size={26}/><strong>{zh ? '尽调目标与材料' : 'Goal and source records'}</strong></div>
    <div class="ma-topology-core"><AgentNode locale={locale} kind="main"/></div>
    <span class="ma-topology-delegate">{zh ? '任务分派' : 'Delegate'}</span><span class="ma-topology-return">{zh ? '状态与结果回传' : 'States & results'}</span>
    <div class="ma-topology-specialists">{kinds.map(kind => <div class="ma-topology-specialist"><AgentNode locale={locale} kind={kind}/></div>)}</div>
    <div class="ma-topology-port ma-topology-output"><Icon name="layers" size={27}/><strong>{zh ? '尽调报告材料' : 'Report for review'}</strong></div>
  </div>}
  {scene === 'assignment' && <div class="ma-decomposition ma-art-canvas">
    <svg class="ma-art-routes" viewBox="0 0 660 480" preserveAspectRatio="none" aria-hidden="true">

      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}><path d="M198 211C254 211 251 82 329 82"/><path d="M213 240H329"/><path d="M198 269C254 269 251 398 329 398"/></g>
    </svg>
    <div class="ma-goal-node"><AgentNode locale={locale} kind="goal"/></div>
    <div class="ma-decomposition-branches">{tasks.map((name, i) => <div class:list={['ma-decomposition-branch', `ma-tone-${i}`]}><div><strong>{name}</strong><span>{requirements[i]}</span><p class="ma-branch-return">{zh ? '返回：' : 'Returns: '}{returned[i]}</p></div></div>)}</div>
  </div>}
  {scene === 'execution' && <div class="ma-execution-map ma-art-canvas">
    <svg class="ma-art-routes ma-execution-desktop" viewBox="0 0 1200 410" preserveAspectRatio="none" aria-hidden="true">
      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}><path d="M155 205C204 205 164 87 260 87H947C1040 87 994 205 1045 205"/><path d="M155 205H1045"/><path d="M155 205C204 205 164 323 260 323H947C1040 323 994 205 1045 205"/></g>
    </svg>
    <div class="ma-execution-root"><AgentNode locale={locale} kind="main" compact/></div>
    <div class="ma-execution-lanes">{tasks.map((name, i) => <div class:list={['ma-execution-lane', `ma-tone-${i}`]}><strong>{name}</strong><span class="ma-execution-state"><Icon name="check" size={15}/>{zh ? '已完成' : 'Completed'}</span><span class="ma-execution-return">{returned[i]}</span></div>)}</div>
    <div class="ma-execution-collected"><AgentNode locale={locale} kind="result" compact/></div>
  </div>}
  {scene === 'delivery' && <div class="ma-composition ma-art-canvas">
    <svg class="ma-art-routes ma-composition-desktop" viewBox="0 0 660 500" preserveAspectRatio="none" aria-hidden="true">
      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}><path d="M146 102C232 102 203 250 250 250"/><path d="M146 250H250"/><path d="M146 398C232 398 203 250 250 250"/></g>
      <path class="ma-composition-out" d="M370 250H397" marker-end={`url(#${prefix}-arrow)`}/>
    </svg>
    <svg class="ma-art-routes ma-composition-mobile" viewBox="0 0 354 350" preserveAspectRatio="none" aria-hidden="true">
      <g class="ma-routes-blue" style={`--route-color:url(#${prefix}-blue)`}><path d="M53 90C53 164 177 133 177 202"/><path d="M177 90V202"/><path d="M301 90C301 164 177 133 177 202"/></g><path class="ma-composition-out" d="M177 297V337" marker-end={`url(#${prefix}-arrow)`}/>
    </svg>
    <div class="ma-composition-sources">{results.map((name,i)=><div class:list={['ma-composition-source',`ma-tone-${i}`]}><Icon name={['file-search','chart','clipboard-check'][i]} size={23}/><strong>{name}</strong></div>)}</div>
    <div class="ma-composition-main"><AgentNode locale={locale} kind="main" compact/></div>
    <article class="ma-outcome-document">
      <div class="ma-outcome-title"><Icon name="file-check" size={24}/><h3>{zh ? '尽调报告材料' : 'Due diligence materials'}</h3></div>
      <dl>{results.map((name,i)=><div><dt>{name}</dt><dd>{descriptions[i]}</dd></div>)}</dl>
      <div class="ma-outcome-review"><Icon name="clipboard-check" size={18}/><span>{zh ? '继续审阅与修改' : 'Ready for review and editing'}</span></div>
    </article>
  </div>}
</figure>
