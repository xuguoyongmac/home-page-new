---
import Icon from '../../../components/Icon.astro';
import type { Locale } from '../../../data/types';
interface Props { locale: Locale; kind?: 'main' | 'search' | 'extract' | 'analysis' | 'goal' | 'result'; compact?: boolean; }
const { locale, kind = 'main', compact = false } = Astro.props;
const zh = locale === 'zh';
const nodes = zh ? {
  main: { title:'主 Agent', icon:'workflow', body:'目标拆解 · 任务调度', detail:'调用子 Agent，归集返回结果' },
  search: { title:'检索 Agent', icon:'file-search', body:'按范围检索来源材料', detail:'返回来源目录与关键原文' },
  extract: { title:'提取 Agent', icon:'chart', body:'按字段与格式提取数据', detail:'返回关键字段汇总' },
  analysis: { title:'分析 Agent', icon:'clipboard-check', body:'按工作规则分析与核对', detail:'返回分析与复核事项' },
  goal: { title:'任务目标', icon:'target', body:'输入材料与工作要求', detail:'明确所需成果' },
  result: { title:'主任务', icon:'folder', body:'归集子任务返回结果', detail:'继续整理与审阅' },
} : {
  main: { title:'Main Agent', icon:'workflow', body:'Plan and delegate', detail:'Collect results' },
  search: { title:'Research Agent', icon:'file-search', body:'Configured source research', detail:'Sources and key passages' },
  extract: { title:'Extraction Agent', icon:'chart', body:'Fields and return format', detail:'A summary of extracted fields' },
  analysis: { title:'Analysis Agent', icon:'clipboard-check', body:'Analysis and review rules', detail:'Findings and review items' },
  goal: { title:'Task goal', icon:'target', body:'Materials and requirements', detail:'Define the expected output' },
  result: { title:'Main task', icon:'folder', body:'Collect specialist results', detail:'Continue preparation and review' },
};
const node = nodes[kind];
---
<div class:list={['ma-product-node', `ma-product-node-${kind}`, {'ma-product-node-compact':compact}]}>
  <div class="ma-product-node-heading"><Icon name={node.icon} size={20}/><strong>{node.title}</strong></div>
  {!compact && <><p>{node.body}</p><span>{node.detail}</span></>}
</div>
