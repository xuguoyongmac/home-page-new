---
import { serverResources } from './resources';
import Icon from '../../components/Icon.astro';
import { appFor, pathFor, site } from '../../lib/site';
import { releaseArchive, releaseDownloads } from '../../data/legacy';
import type { Locale } from '../../data/types';
import PageHeroArt from '../../components/PageHeroArt.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const products = zh ? { desktop: 'TeGo OS 桌面端', mobile: 'TeGo OS 移动端', studio: 'Tego Studio' } : { desktop: 'TeGo OS Desktop', mobile: 'TeGo OS Mobile', studio: 'Tego Studio' };
const platformNames: Record<string, string> = { macos: 'macOS', windows: 'Windows', linux: 'Linux', kylin: zh ? '银河麒麟' : 'Kylin', android: 'Android', ios: 'iOS' };
const architecture = (platform: string, arch: string) => {
  if (platform === 'macos') return arch === 'arm64' ? 'Apple silicon · ARM64' : 'Intel · x64';
  if (arch === 'x86') return zh ? 'x86 · 32 位' : 'x86 · 32-bit';
  if (arch === 'x64') return zh ? 'x64 · 64 位' : 'x64 · 64-bit';
  return arch === 'arm64' ? 'ARM64' : '';
};
const formatNames: Record<string, string> = { dmg: 'DMG', exe: 'EXE', apk: 'APK', deb: 'DEB', zip: 'ZIP', tar: 'TAR', 'tar.gz': 'TAR.GZ', flatpak: 'Flatpak', testflight: 'TestFlight', AppImage: 'AppImage' };
const date = (value: string) => {
  const parts = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(value));
  const valueFor = (type: string) => parts.find(part => part.type === type)?.value || '';
  return `${valueFor('year')}-${valueFor('month')}-${valueFor('day')}`;
};
const filters = zh ? [['all', '全部'], ['desktop', '桌面端'], ['mobile', '移动端'], ['studio', 'Tego Studio']] : [['all', 'All'], ['desktop', 'Desktop'], ['mobile', 'Mobile'], ['studio', 'Tego Studio']];
---
<section class="page-hero inner-page-hero inner-support-hero">
  <PageHeroArt variant="enterprise" compact/>
  <div class="container inner-hero-content"><div class="inner-hero-copy">
    <p class="eyebrow">DOWNLOADS</p>
    <h1>{zh ? '在熟悉的设备上，\n与数字员工一起工作。' : 'Your workspace,\non the device you choose.'}</h1>
    <p>{zh ? '选择设备平台、处理器架构和安装格式，或直接打开 Web 工作空间。' : 'Choose your platform, processor architecture, and package format, or open the workspace in your browser.'}</p>
    <div class="hero-actions"><a class="button" href={appFor(locale)}>{zh ? '打开 Web 工作空间' : 'Open web workspace'}<Icon name="external" size={18}/></a><a class="text-link" href="#server">{zh ? '服务器与镜像' : 'Server resources'}<Icon name="arrow" size={18}/></a><a class="text-link" href={`${site.docs}requirements/`}>{zh ? '环境要求' : 'System requirements'}<Icon name="arrow" size={18}/></a></div>
  </div></div>
</section>
<section id="clients" class="container downloads-section inner-downloads" aria-label={zh ? '客户端安装包' : 'Client downloads'}>
  <div class="download-tabs" role="group" aria-label={zh ? '按产品筛选' : 'Filter by product'}>
    {filters.map(([value, label]) => <button class="filter-button" type="button" data-download-filter={value} aria-pressed={value === 'all'} aria-controls="download-list">{label}</button>)}
  </div>
  <div class="download-grid" id="download-list">
    {releaseDownloads.map((item) => {
      const platform = platformNames[item.platform] || item.platform;
      const format = formatNames[item.format] || item.format;
      const arch = architecture(item.platform, item.architecture);
      const action = item.format === 'testflight' ? (zh ? '打开 TestFlight' : 'Open TestFlight') : `${zh ? '下载' : 'Download'} ${format}`;
      return <article class="download-card" data-download-product={item.product}>
        <Icon name={item.product === 'studio' ? 'terminal' : item.product === 'mobile' ? 'globe' : 'monitor'} size={28}/>
        <p class="eyebrow">{products[item.product]}</p>
        <h2>{platform}</h2>
        <p>{arch ? `${arch} · ${format}` : format}</p>
        <span class="download-version">{item.version}</span>
        <p class="download-date"><time datetime={item.releasedAt}>{date(item.releasedAt)}</time><span>{zh ? '北京时间' : 'UTC+8'}</span></p>
        <a class="button button-outline" href={item.url} aria-label={`${products[item.product]} ${platform} ${arch} ${item.version} — ${action}`}>{action}<Icon name={item.format === 'testflight' ? 'external' : 'download'} size={16}/></a>
      </article>;
    })}
  </div>
  <div class="download-footer">
    <a class="text-link" href={pathFor(locale, 'releases')}>{zh ? '查看历史版本' : 'Browse release history'}<Icon name="clock" size={16}/></a>
    <a class="text-link" href={releaseArchive.indexUrl} download="tego-release-index.json">{zh ? '下载发布清单' : 'Download release index'}<Icon name="download" size={16}/></a>
    <a class="text-link" href={`${site.docs}requirements/`}>{zh ? '安装与部署要求' : 'Installation and deployment requirements'}<Icon name="external" size={15}/></a>
  </div>
</section>

<section class="container server-resources" id="server"><div class="sl-heading"><p class="eyebrow">{zh ? '服务端资源' : 'SERVER RESOURCES'}</p><h2>{zh ? '部署包、服务镜像与版本校验' : 'Server bundles, images and release verification'}</h2></div><div class="download-grid">{serverResources.map(resource => <article class="download-card"><Icon name="cpu" size={28}/><h3>{resource.name[locale]}</h3><p>{zh ? '按发布版本选择架构、部署包与镜像。' : 'Choose architectures, deployment bundles and images by release.'}</p><span class="download-version">{resource.version}</span><div class="hero-actions"><a class="button button-outline" href={`${pathFor(locale,'releases')}?version=${resource.version}`}>{zh ? '选择部署资源' : 'Browse deployment resources'}<Icon name="arrow" size={16}/></a><a class="text-link" href={resource.manifest} download>{zh ? '发布清单' : 'Release manifest'}<Icon name="download" size={15}/></a></div></article>)}</div><div class="download-footer"><a class="text-link" href={pathFor(locale,'enterprise')}>{zh ? '查看企业部署方式' : 'Enterprise deployment'}<Icon name="arrow" size={16}/></a></div></section>
<style>.server-resources{padding-bottom:90px;scroll-margin-top:100px}.server-resources h3{font-size:22px;margin:20px 0 12px}.server-resources p{color:var(--muted);line-height:1.8}.server-resources .download-version{margin-top:18px}.server-resources .hero-actions{display:flex;flex-wrap:wrap;gap:20px}.server-resources .download-footer{margin-top:28px}</style>

<style>
  .page-hero h1{white-space:pre-line}.downloads-section{padding-bottom:95px}.download-card{display:flex;flex-direction:column;min-width:0}.download-card[hidden]{display:none}.download-card>svg{color:var(--accent)}.download-card h2{margin-top:21px}.download-version{align-self:flex-start}.download-card .download-date{display:flex;gap:9px;align-items:center;font-size:11px;margin-top:12px;flex-wrap:wrap}.download-date>span{font-size:10px}.download-card .button{margin-top:23px}.download-footer{display:flex;align-items:center;gap:25px;flex-wrap:wrap}.download-footer .text-link{font-size:12px}.download-tabs{min-width:0}@media(max-width:480px){.downloads-section{padding-bottom:65px}.page-hero .hero-actions{flex-wrap:wrap;gap:23px}.download-footer{gap:20px}}
</style>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-download-filter]');
  const downloads = document.querySelectorAll<HTMLElement>('[data-download-product]');
  filters.forEach(button => {
    button.addEventListener('click', () => {
      const selected = button.dataset.downloadFilter;
      filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
      downloads.forEach(card => { card.hidden = selected !== 'all' && card.dataset.downloadProduct !== selected; });
    });
  });
</script>
