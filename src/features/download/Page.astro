---
import { serverResources } from './resources';
import Icon from '../../components/Icon.astro';
import { appFor, pathFor } from '../../lib/site';
import { releaseDownloads } from '../../data/legacy';
import type { Locale } from '../../data/types';
import Shell from '../resources/Shell.astro';
import Hero from '../resources/Hero.astro';
import { docsLinks } from '../resources/content';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const products = zh ? { desktop: 'TeGo OS 桌面端', mobile: 'TeGo OS 移动端', studio: 'Tego Studio' } : { desktop: 'TeGo OS Desktop', mobile: 'TeGo OS Mobile', studio: 'Tego Studio' };
const platforms: Record<string, string> = { macos: 'macOS', windows: 'Windows', linux: 'Linux', kylin: zh ? '银河麒麟' : 'Kylin', android: 'Android', ios: 'iOS' };
const architecture = (platform: string, arch: string) => platform === 'macos' ? (arch === 'arm64' ? 'Apple silicon · ARM64' : 'Intel · x64') : arch === 'x86' ? (zh ? 'x86 · 32 位' : 'x86 · 32-bit') : arch === 'x64' ? (zh ? 'x64 · 64 位' : 'x64 · 64-bit') : arch === 'arm64' ? 'ARM64' : '';
const date = (value: string) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Shanghai', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(value));
const formatName = (value: string) => value === 'testflight' ? 'TestFlight' : value === 'AppImage' ? 'AppImage' : value === 'flatpak' ? 'Flatpak' : value.toUpperCase();
type Download = (typeof releaseDownloads)[number];
const sharesRelease = (files: Download[]) => files.every(file => file.version === files[0].version && file.releasedAt === files[0].releasedAt);
const grouped = new Map<string, { product: Download['product']; platform: string; variants: { arch: string; files: Download[] }[] }>();
releaseDownloads.forEach(file => {
  const key = `${file.product}-${file.platform}`;
  if (!grouped.has(key)) grouped.set(key, { product: file.product, platform: file.platform, variants: [] });
  const group = grouped.get(key)!;
  let variant = group.variants.find(entry => entry.arch === file.architecture);
  if (!variant) { variant = { arch: file.architecture, files: [] }; group.variants.push(variant); }
  variant.files.push(file);
});
const productOrder = ['desktop', 'mobile', 'studio'];
const platformOrder = ['macos', 'windows', 'linux', 'kylin', 'android', 'ios'];
const groups = [...grouped.values()].sort((a, b) => productOrder.indexOf(a.product) - productOrder.indexOf(b.product) || platformOrder.indexOf(a.platform) - platformOrder.indexOf(b.platform));
groups.forEach(group => {
  const order = group.platform === 'macos' ? ['arm64', 'x64', 'x86'] : ['x64', 'arm64', 'x86'];
  group.variants.sort((a, b) => order.indexOf(a.arch) - order.indexOf(b.arch));
});
const filters = zh ? [['desktop', '桌面端'], ['mobile', '移动端'], ['studio', 'Tego Studio']] : [['desktop', 'Desktop'], ['mobile', 'Mobile'], ['studio', 'Tego Studio']];
---
<Shell locale={locale} page="download">
  <Hero label={zh ? '客户端下载' : 'DOWNLOADS'} title={zh ? '在熟悉的设备上，开始工作' : 'Your workspace. On your device.'}>
    <div class="support-actions"><a class="button" href={appFor(locale)}>{zh ? '打开 Web 工作空间' : 'Open web workspace'}<Icon name="external" size={16}/></a><a class="text-link" href="#server">{zh ? '服务端部署资源' : 'Server resources'}<Icon name="arrow" size={16}/></a></div>
  </Hero>
  <section class="container installer-section" id="clients" data-download-browser aria-label={zh ? '选择安装包' : 'Choose an installer'}>
    <div class="installer-tabs" role="tablist" aria-label={zh ? '下载产品' : 'Download product'}>{filters.map(([id, label]) => <button id={`download-tab-${id}`} type="button" role="tab" data-download-filter={id} aria-selected={id === 'desktop'} tabindex={id === 'desktop' ? 0 : -1} aria-controls="download-list">{label}</button>)}</div>
    <div class="installer-grid" id="download-list" role="tabpanel" aria-labelledby="download-tab-desktop">{groups.map(group => <article class="installer-card support-card" data-download-product={group.product} data-download-platform={group.platform} hidden={group.product !== 'desktop'}>
      <div class="installer-card-heading"><span class="installer-icon"><Icon name={group.product === 'studio' ? 'terminal' : group.product === 'mobile' ? 'globe' : 'monitor'} size={26}/></span><span class="installer-product">{products[group.product]}</span></div>
      <h2>{platforms[group.platform]}</h2>
      <div class="installer-variants">{group.variants.map(variant => <div class="installer-variant">
        {architecture(group.platform, variant.arch) && <h3>{architecture(group.platform, variant.arch)}</h3>}
        {sharesRelease(variant.files) && <p class="installer-release">{variant.files[0].version} · <time datetime={variant.files[0].releasedAt}>{date(variant.files[0].releasedAt)}</time></p>}
        <div class="installer-files">{variant.files.map(file => <a class="installer-download" href={file.url} aria-label={`${products[file.product]} ${platforms[file.platform]} ${architecture(file.platform, file.architecture)} ${file.version} ${file.format === 'testflight' ? (zh ? '打开 TestFlight' : 'Open TestFlight') : (zh ? '下载' : 'Download')} ${formatName(file.format)}`}><span><strong>{file.format === 'testflight' ? (zh ? '打开 TestFlight' : 'Open TestFlight') : formatName(file.format)}</strong>{!sharesRelease(variant.files) && <small>{file.version} · <time datetime={file.releasedAt}>{date(file.releasedAt)}</time></small>}</span><Icon name={file.format === 'testflight' ? 'external' : 'download'} size={17}/></a>)}</div>
      </div>)}</div>
    </article>)}</div>

  </section>
  <section class="support-section support-section-alt" id="server"><div class="container"><div class="support-section-heading"><div><p class="support-kicker">{zh ? '企业部署' : 'ENTERPRISE DEPLOYMENT'}</p><h2>{zh ? '服务端部署包与镜像' : 'Server bundles and images'}</h2></div><a class="text-link" href={docsLinks.deployment}>{zh ? '查看部署文档' : 'Deployment documentation'}<Icon name="external" size={16}/></a></div>
    <div class="server-resource-grid">{serverResources.map(resource => <article class="support-card server-resource"><div><Icon name={resource.product === 'avatar' ? 'cpu' : 'network'} size={28}/><span class="support-label">{resource.product === 'avatar' ? (zh ? '数字员工平台' : 'DIGITAL EMPLOYEE PLATFORM') : (zh ? '独立产品线' : 'SEPARATE PRODUCT LINE')}</span></div><h3>{resource.product === 'avatar' ? resource.name[locale] : 'TeGo Workflow'}</h3><span class="server-version">{resource.version}</span><div class="support-link-row"><a class="button button-outline" href={`${pathFor(locale, 'releases')}?version=${resource.version}&product=${resource.product}`}>{zh ? '选择部署资源' : 'Browse server resources'}<Icon name="arrow" size={16}/></a><a class="text-link" href={resource.manifest} download>{zh ? '发布清单' : 'Manifest'}<Icon name="download" size={15}/></a></div></article>)}</div>
  </div></section>
</Shell>
<style>
  .installer-section{padding-bottom:65px;scroll-margin-top:100px}.installer-tabs{display:flex;align-items:center;gap:36px;overflow-x:auto;scrollbar-width:none;white-space:nowrap;margin-bottom:22px}.installer-tabs button{flex-shrink:0;background:none;border:0;border-bottom:2px solid transparent;border-radius:0;padding:10px 1px 14px;font:inherit;font-size:16px;color:#94acc2;cursor:pointer}.installer-tabs button[aria-selected="true"]{color:#eaf7ff;border-bottom-color:#46b4ff}.installer-tabs button:hover{color:#eaf7ff}.installer-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.installer-card{padding:26px;display:flex;flex-direction:column}.installer-card-heading{display:flex;align-items:center;gap:12px}.installer-icon{width:43px;height:43px;border-radius:12px;display:grid;place-items:center;background:#183e5b;color:#90d3ff}.installer-product{font-size:12px;color:#8eb6d5}.installer-card h2{font-size:25px;margin:22px 0 4px}.installer-variants{display:grid;gap:20px;margin-top:20px}.installer-variant h3{font-size:12px;color:#aac5dc;margin:0 0 10px;letter-spacing:0}.installer-release{font-size:11px;color:#8daac2;margin:-3px 0 11px}.installer-files{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.installer-download:only-child{grid-column:1/-1}.installer-download{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 13px;min-height:44px;border:1px solid #4d9fd34d;background:#0a2b43;border-radius:9px;color:#bce6ff}.installer-download:hover{background:#104666;border-color:#5abcf8;color:#fff}.installer-download>span{display:flex;flex-direction:column;gap:4px}.installer-download strong{font-size:14px;font-weight:500}.installer-download small{font-size:10px;color:#96b3ca;overflow-wrap:anywhere}.server-resource-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:22px}.server-resource{padding:30px}.server-resource>div:first-child{display:flex;align-items:center;gap:14px;color:#7fcbff}.server-resource h3{font-size:25px;margin:23px 0 12px}.server-resource>p{font-size:14px;line-height:1.9;color:#a1b9cf;max-width:470px}.server-version{display:block;font-size:12px;margin-top:20px;color:#7ea6c8}.server-resource .support-link-row{gap:20px;margin-top:23px}
  @media(max-width:950px){.installer-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.installer-card{padding:25px}.server-resource-grid{grid-template-columns:1fr 1fr}.server-resource{padding:25px}}
  @media(max-width:600px){.installer-grid,.server-resource-grid{grid-template-columns:1fr}.installer-section{padding-bottom:44px}.installer-tabs{gap:27px}.installer-tabs button{font-size:15px}.installer-card{padding:25px}.installer-card h2{font-size:25px}.installer-download small{font-size:11px}.server-resource h3{font-size:23px}}
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-download-browser]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-download-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-download-product]')];
    const panel = root.querySelector<HTMLElement>('#download-list')!;
    const params = new URL(location.href).searchParams;
    let product = tabs.some(tab => tab.dataset.downloadFilter === params.get('product')) ? params.get('product')! : 'desktop';
    const update = (writeUrl: boolean) => {
      cards.forEach(card => { card.hidden = card.dataset.downloadProduct !== product; });
      tabs.forEach(tab => {
        const active = tab.dataset.downloadFilter === product;
        tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', `download-tab-${product}`);
      if (writeUrl) {
        const url = new URL(location.href);
        if (product === 'desktop') url.searchParams.delete('product'); else url.searchParams.set('product', product);
        url.searchParams.delete('platform'); history.replaceState(null, '', url);
      }
    };
    const activate = (tab: HTMLButtonElement) => { product = tab.dataset.downloadFilter!; update(true); };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', event => {
        let next: number;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault(); activate(tabs[next]); tabs[next].focus(); tabs[next].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
    });
    update(false);
  }
</script>
