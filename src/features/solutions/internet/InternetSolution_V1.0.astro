---
import Icon from '../../../components/Icon.astro';
import { pathFor } from '../../../lib/site';
import type { Locale } from '../../../data/types';
import { experience } from './experience_V1.0';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = experience[locale];
---

<div class="internet-solution" lang={locale} data-internet-solution>
  <section class="internet-hero" aria-labelledby="internet-title">
    <div class="container internet-hero-grid">
      <div class="internet-hero-copy">
        <p class="internet-eyebrow"><span></span>{copy.eyebrow}</p>
        <h1 id="internet-title">{copy.headline.map(line => <span>{line}</span>)}</h1>
        <p class="internet-lead">{copy.description}</p>
        <div class="internet-actions">
          <a class="internet-button" href={pathFor(locale, 'contact')}>{copy.primary}<Icon name="arrow" size={18}/></a>
          <a class="internet-text-link" href="#team-workflows">{copy.secondary}<Icon name="chevron" size={16}/></a>
        </div>
      </div>

      <figure class="internet-delivery-map" aria-labelledby="delivery-map-title">
        <figcaption id="delivery-map-title" class="internet-map-heading"><span>{copy.hero.label}</span><strong>{copy.hero.title}</strong></figcaption>
        <div class="internet-map-glow" aria-hidden="true"></div>
        <svg class="internet-map-lines" viewBox="0 0 600 440" fill="none" aria-hidden="true">
          <defs><linearGradient id="internet-flow-gradient"><stop stop-color="#3f7dba" stop-opacity=".2"/><stop offset=".55" stop-color="#63c7ff"/><stop offset="1" stop-color="#65a6d3" stop-opacity=".35"/></linearGradient></defs>
          <path d="M188 154C228 154 220 203 272 203M188 217H272M188 280C228 280 222 231 272 231M332 217H412" stroke="url(#internet-flow-gradient)" stroke-width="1.5"/>
          <circle cx="222" cy="217" r="3" fill="#83d6ff"/><circle cx="366" cy="217" r="3" fill="#83d6ff"/>
        </svg>
        <div class="internet-source-stack">
          {copy.hero.sources.map((source, index) => <div class="internet-source-chip"><span class="internet-source-icon"><Icon name={['message', 'book', 'chart'][index]} size={19}/></span><span>{source}</span></div>)}
        </div>
        <div class="internet-map-agent"><div class="internet-agent-orbit"></div><div class="internet-agent-core"><Icon name="cpu" size={31}/></div><strong>{copy.hero.employee}</strong><span>{copy.hero.actions}</span></div>
        <div class="internet-result-stack">
          <div class="internet-result-paper">
            <span class="internet-paper-icon"><Icon name="folder" size={27}/></span>
            <h2>{copy.hero.result}</h2>
            <div class="internet-paper-files">{copy.hero.files.map((file, index) => <div><span class:list={['internet-file-dot', `internet-file-dot-${index}`]}></span><span>{file}</span><Icon name="file" size={14}/></div>)}</div>
            <div class="internet-review-label"><Icon name="message" size={13}/>{copy.hero.review}</div>
          </div>
          <div class="internet-paper-back" aria-hidden="true"></div>
        </div>
      </figure>
    </div>
    <div class="container internet-capability-strip">{copy.hero.capabilities.map((label, index) => <span><Icon name={['book', 'terminal', 'folder', 'shield'][index]} size={16}/>{label}</span>)}</div>
  </section>

  <section class="internet-workflows internet-section" id="team-workflows" aria-labelledby="workflow-title">
    <div class="container">
      <div class="internet-section-heading">
        <p class="internet-eyebrow">{copy.scenarios.eyebrow}</p>
        <h2 id="workflow-title">{copy.scenarios.title}</h2>
        <p>{copy.scenarios.description}</p>
      </div>
      <div class="internet-workflow-tabs" role="tablist" aria-label={copy.scenarios.label}>
        {copy.workflows.map((workflow, index) => <button type="button" role="tab" id={`workflow-tab-${workflow.id}`} aria-controls={`workflow-panel-${workflow.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}><Icon name={workflow.icon} size={20}/>{workflow.label}</button>)}
      </div>
      <div class="internet-workflow-panels">
        {copy.workflows.map((workflow, index) => <div class="internet-workflow-panel" id={`workflow-panel-${workflow.id}`} role="tabpanel" aria-labelledby={`workflow-tab-${workflow.id}`} tabindex="0" hidden={index !== 0}>
          <div class="internet-workflow-copy">
            <h3>{workflow.title}</h3>
            <p class="internet-workflow-description">{workflow.description}</p>
            <div class="internet-activities">{workflow.activities.map(activity => <article><span class="internet-activity-mark" aria-hidden="true"></span><div><h4>{activity.title}</h4><p>{activity.body}</p></div></article>)}</div>
          </div>
          <div class="internet-task">
            <div class="internet-task-heading"><span>{copy.labels.task}</span><Icon name={workflow.icon} size={19}/></div>
            <h3>{workflow.task}</h3>
            <div class="internet-task-sources"><span class="sr-only">{copy.labels.sources}</span>{workflow.sources.map(source => <span>{source}</span>)}</div>
            <div class="internet-task-request"><Icon name="message" size={17}/><p>{workflow.request}</p></div>
            <p class="internet-output-label">{copy.labels.outputs}</p>
            <ul class="internet-outputs">{workflow.outputs.map(output => <li><span class:list={['internet-format', output.format.toLowerCase()]}>{output.format}</span><div><strong>{output.title}</strong><span>{output.body}</span></div><Icon name="file" size={17}/></li>)}</ul>
            <div class="internet-task-review"><Icon name="shield" size={16}/><p><strong>{copy.labels.review}</strong>{workflow.review}</p></div>
          </div>
        </div>)}
      </div>
    </div>
  </section>

  <section class="internet-collaboration internet-section" aria-labelledby="collaboration-title">
    <div class="container internet-collaboration-grid">
      <div class="internet-collaboration-copy">
        <p class="internet-eyebrow">{copy.collaboration.eyebrow}</p>
        <h2 id="collaboration-title">{copy.collaboration.title.map(line => <span>{line}</span>)}</h2>
        <p>{copy.collaboration.body}</p>
        <a class="internet-text-link" href={pathFor(locale, 'product/collaboration')}>{copy.collaboration.link}<Icon name="arrow" size={16}/></a>
      </div>
      <div class="internet-project-flow">
        <div class="internet-flow-main">{copy.collaboration.main.map((stage, index) => <><div class="internet-flow-stage"><span><Icon name={stage.icon} size={23}/></span><h3>{stage.title}</h3><p>{stage.body}</p></div>{index < 2 && <Icon name="arrow" size={20} class="internet-stage-arrow"/>}</>)}</div>
        <div class="internet-flow-branch"><span class="internet-branch-stem" aria-hidden="true"></span><span class="internet-branch-condition">{copy.collaboration.branch}</span><div><Icon name="message" size={16}/><span>{copy.collaboration.question}</span><Icon name="arrow" size={16}/><span>{copy.collaboration.reply}</span></div></div>
        <div class="internet-version-note"><div class="internet-version-glyph" aria-hidden="true"><span></span><span></span><span></span><Icon name="file" size={19}/></div><div><h3>{copy.collaboration.version}</h3><p>{copy.collaboration.versionBody}</p></div></div>
      </div>
    </div>
  </section>

  <section class="internet-foundations internet-section" aria-labelledby="foundations-title">
    <div class="container">
      <div class="internet-section-heading"><p class="internet-eyebrow">{copy.foundations.eyebrow}</p><h2 id="foundations-title">{copy.foundations.title}</h2></div>
      <div class="internet-foundation-grid">
        <article class="internet-foundation-card internet-knowledge-card">
          <h3>{copy.foundations.knowledge.title}</h3><p>{copy.foundations.knowledge.body}</p>
          <div class="internet-assets">{copy.foundations.knowledge.items.map(item => <div><span><Icon name={item.icon} size={20}/></span><div><h4>{item.title}</h4><p>{item.body}</p></div></div>)}</div>
          <a class="internet-text-link" href={pathFor(locale, 'product/knowledge')}>{copy.foundations.knowledge.link}<Icon name="arrow" size={16}/></a>
        </article>
        <article class="internet-foundation-card internet-connection-card">
          <h3>{copy.foundations.connections.title}</h3><p>{copy.foundations.connections.body}</p>
          <div class="internet-connection-map">
            <div class="internet-connection-top"><span><Icon name="file" size={17}/>{copy.foundations.connections.file}</span><span><Icon name="globe" size={17}/>{copy.foundations.connections.external}</span></div>
            <div class="internet-connection-paths" aria-hidden="true"><span></span><span></span><Icon name="chevron" size={16}/><span class="internet-openapi">OpenAPI</span></div>
            <div class="internet-connection-center"><Icon name="cpu" size={22}/><strong>{copy.foundations.connections.workspace}</strong></div>
            <div class="internet-connection-bottom"><span>{copy.foundations.connections.plugin}</span><Icon name="plug" size={15}/><span>{copy.foundations.connections.tools}</span></div>
          </div>
          <p class="internet-connection-permission">{copy.foundations.connections.permission}</p>
          <a class="internet-text-link" href={pathFor(locale, 'product/integrations')}>{copy.foundations.connections.link}<Icon name="arrow" size={16}/></a>
        </article>
      </div>
    </div>
  </section>

  <section class="internet-closing" aria-labelledby="internet-closing-title">
    <div class="container"><p class="internet-eyebrow">{copy.closing.eyebrow}</p><h2 id="internet-closing-title">{copy.closing.title}</h2><p>{copy.closing.body}</p><div class="internet-actions"><a class="internet-button" href={pathFor(locale, 'contact')}>{copy.primary}<Icon name="arrow" size={18}/></a><a class="internet-text-link" href={pathFor(locale, 'solutions')}>{copy.closing.secondary}<Icon name="arrow" size={16}/></a></div></div>
  </section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-internet-solution]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach(item => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      panels.forEach(panel => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        let next: number | undefined;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        if (event.key === 'Home') next = 0;
        if (event.key === 'End') next = tabs.length - 1;
        if (next === undefined) return;
        event.preventDefault();
        const target = tabs[next];
        selectTab(target);
        target.focus();
        target.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
      });
    });
  });
</script>

<style>
  .internet-solution{--internet-ink:#f2f7fc;--internet-muted:#a4b5c9;--internet-blue:#71caff;--internet-line:#9bc5ed24;background:#060b12;color:var(--internet-ink);overflow:hidden}
  .internet-solution :is(h1,h2,h3,h4){text-wrap:balance}
  .internet-solution h4{margin:0;font-weight:600}
  .internet-solution figure{margin:0}
  .internet-solution [hidden]{display:none!important}
  .internet-solution :is(a,button):focus-visible{outline:2px solid #99daff;outline-offset:5px}
  .internet-eyebrow{display:flex;align-items:center;gap:10px;font-size:12px;line-height:1.5;font-weight:600;letter-spacing:.12em;color:var(--internet-blue)}
  .internet-eyebrow>span{width:6px;height:6px;flex:0 0 6px;background:#8bd5ff;border-radius:50%;box-shadow:0 0 15px #6fcaff70}
  .internet-hero{position:relative;padding:76px 0 36px;background:radial-gradient(ellipse at 82% 30%,#0c3f6b45,transparent 55%)}
  .internet-hero-grid{display:grid;grid-template-columns:.94fr 1.06fr;gap:34px;align-items:center;min-height:460px}
  .internet-hero-copy{position:relative;z-index:1;padding-bottom:16px}
  .internet-hero h1{margin:24px 0;font-size:clamp(38px,4.05vw,58px);font-weight:600;letter-spacing:-.055em;line-height:1.3}
  .internet-hero h1 span{display:block;white-space:nowrap}
  .internet-hero h1 span:last-child{color:#a6dbff}
  .internet-lead{max-width:480px;color:var(--internet-muted);font-size:16px;line-height:1.95}
  .internet-actions{display:flex;align-items:center;flex-wrap:wrap;gap:26px;margin-top:33px}
  .internet-button{display:inline-flex;justify-content:center;align-items:center;gap:25px;min-height:48px;padding:12px 21px;background:#149ef0;border:1px solid #42b8ff;border-radius:8px;font-size:14px;font-weight:600;color:#fff;transition:background .18s,transform .18s,box-shadow .18s}
  .internet-button:hover{background:#33b1fb;transform:translateY(-2px);box-shadow:0 10px 35px #008de52b}
  .internet-text-link{display:inline-flex;align-items:center;gap:10px;min-height:40px;font-size:14px;font-weight:500;color:#b9d9f0;transition:color .18s}
  .internet-text-link:hover{color:#fff}
  .internet-delivery-map{position:relative;container-type:inline-size;width:100%;aspect-ratio:1.36;isolation:isolate}
  .internet-map-heading{position:absolute;left:2%;top:3%;display:flex;flex-direction:column;gap:8px;font-size:11px;letter-spacing:.04em;color:#8299b1}
  .internet-map-heading strong{font-size:15px;letter-spacing:.02em;font-weight:500;color:#c0d2e5}
  .internet-map-glow{position:absolute;inset:8% -9% -9% 5%;z-index:-1;background:radial-gradient(ellipse at center,#146c9c21,transparent 67%);border-radius:50%}
  .internet-map-lines{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .internet-source-stack{position:absolute;left:1%;top:28%;display:grid;gap:3.6cqw;width:32%}
  .internet-source-chip{display:flex;align-items:center;gap:1.9cqw;min-height:7.5cqw;padding:1.3cqw 1.6cqw;border:1px solid #7196b635;border-radius:9px;background:linear-gradient(110deg,#13263ce6,#0e1d2de6);font-size:2cqw;color:#c7d6e5;box-shadow:0 10px 25px #00000016;white-space:nowrap}
  .internet-source-icon{display:grid;place-items:center;color:#8ab8db}
  .internet-map-agent{position:absolute;left:40.5%;top:33%;width:19%;display:flex;align-items:center;flex-direction:column;text-align:center}
  .internet-agent-orbit{position:absolute;width:22cqw;height:22cqw;top:-3cqw;left:50%;transform:translateX(-50%);border:1px solid #6bbdff16;border-radius:50%;box-shadow:0 0 0 2.7cqw #468ac506,0 0 0 5.3cqw #468ac504}
  .internet-agent-core{display:grid;place-items:center;width:15cqw;height:15cqw;margin-bottom:2.4cqw;border-radius:28%;background:radial-gradient(circle at 20% 10%,#277daf,#12385b 70%);box-shadow:inset 0 1px 0 #a6dfff66,0 0 0 1px #8ed4ff60,0 18px 40px #0006,0 0 44px #159bec29;color:#bceaff}
  .internet-agent-core svg{width:6cqw;height:6cqw}
  .internet-map-agent>strong{font-size:2.1cqw;font-weight:500;color:#d9eeff}
  .internet-map-agent>span{margin-top:1.4cqw;font-size:1.65cqw;color:#7ea9cb;white-space:nowrap}
  .internet-result-stack{position:absolute;left:66%;top:18%;width:34%;perspective:900px}
  .internet-result-paper{position:relative;z-index:2;min-height:48cqw;padding:4cqw 3.3cqw 2.5cqw;background:linear-gradient(125deg,#f8fcff,#dceaf5);border:1px solid #fff;border-radius:11px;box-shadow:0 24px 55px #0005;transform:rotate(-4deg);color:#17384f}
  .internet-paper-back{position:absolute;inset:7px -9px -9px 9px;z-index:1;background:#7aa6c84a;border:1px solid #9fc8e442;border-radius:11px;transform:rotate(2deg)}
  .internet-paper-icon{display:grid;place-items:center;width:7.3cqw;height:7.3cqw;border-radius:9px;color:#277cb3;background:#176cb614}
  .internet-paper-icon svg{width:4.4cqw;height:4.4cqw}
  .internet-result-paper h2{font-size:3cqw;line-height:1.5;font-weight:650;letter-spacing:-.03em;margin:2.6cqw 0 4cqw;text-wrap:wrap}
  .internet-paper-files{display:grid;gap:3.1cqw}
  .internet-paper-files>div{display:flex;align-items:center;gap:1.4cqw;font-size:1.9cqw;line-height:1.5;color:#4b6478}
  .internet-paper-files>div>span:nth-child(2){min-width:0;flex:1;overflow-wrap:anywhere}
  .internet-paper-files>div>svg{margin-left:auto;color:#849cb0;flex-shrink:0;width:2.3cqw}
  .internet-file-dot{display:block;width:.9cqw;height:.9cqw;flex:0 0 .9cqw;border-radius:2px;background:#4d99ce}
  .internet-file-dot-1{background:#679f94}.internet-file-dot-2{background:#a79772}
  .internet-review-label{display:flex;align-items:center;gap:1.2cqw;margin-top:4.6cqw;padding-top:2.5cqw;border-top:1px solid #23486820;font-size:1.7cqw;color:#5e798d}
  .internet-review-label svg{width:2.3cqw;flex-shrink:0}
  .internet-capability-strip{display:flex;align-items:center;gap:35px;padding-top:32px;color:#8196ad;font-size:12px}
  .internet-capability-strip>span{display:flex;align-items:center;gap:9px}
  .internet-capability-strip svg{color:#759fbd}
  .internet-section{padding:100px 0}
  .internet-section-heading{margin-bottom:38px}
  .internet-section-heading h2{font-size:clamp(28px,2.8vw,39px);letter-spacing:-.04em;line-height:1.5;font-weight:550;margin-top:17px}
  .internet-section-heading>p:last-child:not(.internet-eyebrow){color:var(--internet-muted);font-size:15px;line-height:1.85;margin-top:16px}
  .internet-workflows{padding-top:85px}
  .internet-workflow-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:6px;border:1px solid #9ac1e420;border-radius:12px;background:#0b1623;margin-bottom:22px}
  .internet-workflow-tabs>button{display:flex;align-items:center;justify-content:center;gap:11px;min-height:54px;padding:10px 15px;border-radius:7px;background:transparent;color:#95a9bd;font-size:14px;font-weight:500;transition:background .18s,color .18s,box-shadow .18s}
  .internet-workflow-tabs>button:hover{background:#24415a44;color:#d6eaff}
  .internet-workflow-tabs>button[aria-selected='true']{background:#173b58;color:#c7edff;box-shadow:inset 0 0 0 1px #6cb8e444,0 3px 12px #0002}
  .internet-workflow-panel{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--internet-line);border-radius:17px;background:linear-gradient(110deg,#102033,#0c1929);overflow:hidden;min-height:579px}
  .internet-workflow-copy{padding:43px 42px}
  .internet-workflow-copy>h3{font-size:28px;font-weight:550;line-height:1.6;letter-spacing:-.035em;max-width:380px}
  .internet-workflow-description{font-size:14px;line-height:1.95;color:#a4b8cd;margin-top:15px;max-width:430px}
  .internet-activities{display:grid;gap:25px;margin-top:35px}
  .internet-activities>article{display:flex;gap:14px;align-items:flex-start}
  .internet-activity-mark{width:5px;height:5px;flex:0 0 5px;margin-top:9px;border-radius:50%;background:#68b7ed;box-shadow:0 0 0 4px #7fc2f00b}
  .internet-activities h4{font-size:15px;line-height:1.6;color:#d7e5f3}
  .internet-activities p{font-size:13px;line-height:1.9;margin-top:5px;color:#91aac2}
  .internet-task{margin:20px 20px 20px 0;padding:29px 28px 24px;border:1px solid #9cbdda2b;border-radius:12px;background:linear-gradient(130deg,#1a3048,#12273c);box-shadow:0 14px 36px #00000016}
  .internet-task-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:10px;letter-spacing:.12em;color:#91b6d3}
  .internet-task-heading svg{color:#78bde7}
  .internet-task>h3{margin-top:12px;font-size:22px;line-height:1.5;font-weight:550;letter-spacing:-.03em}
  .internet-task-sources{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}
  .internet-task-sources>span:not(.sr-only){font-size:10px;line-height:1.5;padding:5px 8px;background:#93b6d40b;border:1px solid #93b6d426;border-radius:5px;color:#acc3d8}
  .internet-task-request{display:flex;align-items:flex-start;gap:11px;margin-top:21px;padding:14px;background:#07172677;border-radius:8px;color:#b7cde0;font-size:12px;line-height:1.9}
  .internet-task-request svg{margin-top:3px;flex-shrink:0;color:#7cb9e1}
  .internet-output-label{font-size:10px;letter-spacing:.09em;color:#799ab5;margin:22px 0 10px}
  .internet-outputs{display:grid;gap:9px}
  .internet-outputs>li{display:flex;align-items:center;gap:12px;background:#d7eaff08;border:1px solid #a2c7e21d;border-radius:7px;padding:12px}
  .internet-format{display:grid;place-items:center;width:37px;flex:0 0 37px;height:40px;border-radius:5px;font-size:8px;font-weight:700;letter-spacing:.02em;background:#72b6f222;color:#9acff7}
  .internet-format.xlsx{background:#70bbaa1a;color:#8bc9b7}.internet-format.pptx{background:#d2a67d1a;color:#dec2a7}
  .internet-outputs>li>div{display:grid;gap:4px;min-width:0}
  .internet-outputs strong{font-size:12px;font-weight:550;line-height:1.5;color:#e0ecf7}
  .internet-outputs>li>div>span{font-size:10px;line-height:1.6;color:#8faac2}
  .internet-outputs>li>svg{flex-shrink:0;color:#7298b8;margin-left:auto}
  .internet-task-review{display:flex;gap:9px;align-items:flex-start;margin-top:19px;color:#8da8c0}
  .internet-task-review>svg{flex-shrink:0;margin-top:2px;color:#8fb9d8}
  .internet-task-review p{font-size:10px;line-height:1.85}
  .internet-task-review strong{font-weight:500;color:#accbdf;margin-right:8px}
