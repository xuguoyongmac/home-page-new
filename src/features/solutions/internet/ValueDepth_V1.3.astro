  .report-support{display:grid;gap:22px}.report-support article{padding:25px;background:#15252e;border-radius:7px}.report-support h3{display:flex;gap:12px;align-items:center;color:#cfebdc;font-size:20px;line-height:1.5}.report-support p{font-size:16px;line-height:1.9;margin-top:21px;color:#c2cfd7}.calculation-row{font-size:15px;line-height:1.8;margin-top:21px;color:#c4d4dc;padding:12px;background:#233a42;border-radius:3px}.calculation-row+.calculation-row{margin-top:11px}.report-audience{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:29px;font-size:16px;color:#c0e1cd}.report-audience>span{display:flex;align-items:center;gap:9px}.report-audience svg{flex-shrink:0}
  .human-relay{padding:30px;background:#142630;border-radius:12px}.human-relay>h3{font-size:21px;line-height:1.6;margin-bottom:27px;color:#d4e6ed}.relay-conversation{display:grid;grid-template-columns:1fr 1fr;gap:25px}.relay-conversation article{display:flex;gap:18px;border-radius:7px;padding:25px;background:#1c333e}.relay-conversation article>svg{flex-shrink:0;color:#a2cedd}.relay-conversation .relay-answer{background:#254137}.relay-conversation .relay-answer>svg{color:#b1dac0}.relay-conversation h4{font-size:16px;line-height:1.6}.relay-conversation p{font-size:16px;line-height:1.9;color:#c1d1da;margin-top:12px}.relay-return{display:flex;align-items:center;justify-content:center;gap:22px;font-size:16px;line-height:1.7;padding:26px 0;color:#b7d9c6}.relay-return strong{font-weight:500}.version-line{display:flex;align-items:center;justify-content:center;gap:20px;flex-wrap:wrap}.version-line>span{display:flex;gap:8px;align-items:center;padding:13px 18px;background:#203945;color:#bed1db;border-radius:4px;font-size:15px;line-height:1.6}.version-line>svg{color:#6f968b}.version-line>span.current{background:#c0e0c9;color:#264a34}
  .value-three{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:38px}.value-three h3{font-size:22px;line-height:1.5}.value-three p{font-size:16px;line-height:1.85;color:var(--depth-muted);margin-top:13px}
  .method-section{background:#12222a}.method-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:33px;margin-top:40px}.method-grid article{padding:28px;background:#1c3039;border-radius:8px}.method-grid article>svg{color:#a4d0bc;margin-bottom:23px}.method-grid h3{font-size:23px;line-height:1.5;letter-spacing:-.03em}.method-grid p{font-size:16px;line-height:1.85;margin-top:18px;color:#d5e1e7}.method-grid p.method-friction{color:#9db3c0}.method-examples{font-size:14px;line-height:1.8;margin-top:23px;color:#b3d7c4}
  .role-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:24px}.role-tabs button{font:inherit;font-size:16px;line-height:1.5;border:0;border-radius:5px;padding:14px 10px;background:#172a35;color:#a9c0ce;cursor:pointer}.role-tabs button:hover{background:#253f48;color:#e1f2e9}.role-tabs button[aria-selected='true']{background:#c2e7d2;color:#214630}.role-panel{display:grid;grid-template-columns:1fr 1fr;gap:40px;background:#152832;border-radius:11px;padding:35px}.role-work>h3{font-size:27px;line-height:1.6;letter-spacing:-.03em}.role-work dl{display:grid;gap:24px;margin-top:28px}.role-work dt,.role-condition h4{font-size:15px;line-height:1.6;color:#b9dbcc}.role-work dd,.role-condition p{font-size:16px;line-height:1.85;color:#b0c4d0;margin-top:8px}.role-condition{margin-top:26px}.role-delivery{padding:28px;background:#eaf0e6;color:#233f2e;border-radius:6px}.role-delivery>h4{font-size:19px;line-height:1.6}.role-outputs{display:grid;gap:25px;margin-top:28px}.role-outputs article{display:flex;gap:14px;align-items:flex-start}.role-outputs svg{flex-shrink:0;color:#6a8b71;margin-top:2px}.role-outputs h5{font-size:19px;line-height:1.5}.role-outputs p{font-size:15px;line-height:1.8;color:#617164;margin-top:6px}.role-human{padding:19px;background:#dbe6d7;border-radius:4px;margin-top:28px}.role-human h4{font-size:15px;line-height:1.6}.role-human p{font-size:15px;line-height:1.85;color:#526a57;margin-top:8px}
  .scale-section{background:#13232b}.scale-layers{display:grid;grid-template-columns:repeat(3,1fr);gap:27px}.scale-layers article{padding:28px;background:#20363e;border-radius:7px}.scale-layers svg{color:#afd8be;margin-bottom:22px}.scale-layers h3{font-size:21px;line-height:1.6}.scale-layers p{font-size:16px;color:#b0c2cc;line-height:1.85;margin-top:12px}.reusable-assets{display:grid;grid-template-columns:repeat(3,1fr);gap:27px;margin-top:22px}.reusable-assets>div{padding:20px 23px;background:#293d39;border-radius:5px}.reusable-assets strong{display:block;font-size:16px;line-height:1.6;font-weight:500;color:#c2e2ce}.reusable-assets span{display:block;font-size:15px;line-height:1.8;color:#a7c3b4;margin-top:7px}.operating-owners{display:grid;grid-template-columns:.75fr 1.25fr;gap:45px;margin-top:45px;align-items:start}.operating-owners h3{font-size:24px;line-height:1.6;letter-spacing:-.025em}.operating-owners ul{display:grid;grid-template-columns:1fr 1fr;gap:17px;list-style:none;padding:0}.operating-owners li{display:flex;gap:8px;font-size:15px;color:#afc6ce;line-height:1.8}.operating-owners svg{flex-shrink:0;color:#90b69f;margin-top:4px}
  .trust-grid{display:grid;grid-template-columns:1fr 1fr;gap:36px 60px;margin-top:43px}.trust-grid h3{font-size:23px;line-height:1.6}.trust-grid p{font-size:16px;line-height:1.9;color:#a9c0cc;margin-top:13px}
  .delivery-section{background:#13232b}.delivery-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-top:45px}.delivery-steps article{position:relative}.step-marker{display:inline-flex;align-items:center;justify-content:center;width:54px;height:54px;border-radius:50%;background:#294638;color:#b7e3c3;margin-bottom:23px}.delivery-steps h3{font-size:22px;line-height:1.6;letter-spacing:-.03em}.delivery-steps p{font-size:16px;line-height:1.85;color:#a7bdc9;margin-top:14px}.delivery-scope{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:44px;padding:29px;background:#1b3039;border-radius:8px}.delivery-scope h3{font-size:18px;line-height:1.6;color:#c4e5d1}.delivery-scope p{font-size:15px;line-height:1.85;color:#acbfca;margin-top:12px}.delivery-environment{margin-top:43px}.delivery-environment>h3{font-size:25px;line-height:1.6}.delivery-environment>div{display:grid;grid-template-columns:1fr 1fr;gap:45px;margin-top:25px}.delivery-environment h4{font-size:18px;line-height:1.6}.delivery-environment p{font-size:15px;line-height:1.9;color:#a3bcc9;margin-top:12px}
  .effort-calculator{display:grid;grid-template-columns:1.2fr 1fr;gap:34px;padding:34px;background:#1b3039;border-radius:12px}.calculator-fields{display:grid;grid-template-columns:1fr 1fr;gap:23px}.calculator-fields>div{min-width:0}.calculator-fields label{display:block;font-size:15px;line-height:1.7;color:#bdcfd8}.calculator-fields input{display:block;width:100%;min-width:0;background:#0c1d27;border:1px solid #3d5661;color:#edf7f2;border-radius:5px;font:inherit;font-size:22px;padding:12px 14px;margin-top:10px;height:58px}.calculator-fields input[aria-invalid='true']{border-color:#d7ac7b}.calculator-error{grid-column:1/-1;font-size:14px;color:#e4be91;line-height:1.8}.calculator-results{display:flex;flex-direction:column;justify-content:space-around;gap:28px;background:#c3dfc9;color:#234831;border-radius:7px;padding:30px}.calculator-results span{display:block;font-size:15px;line-height:1.6}.calculator-results output{display:block;font-size:clamp(30px,3.5vw,49px);line-height:1.5;letter-spacing:-.04em;overflow-wrap:anywhere;margin-top:7px;font-variant-numeric:tabular-nums}.calculator-basis{grid-column:1/-1}.calculator-basis p{font-size:15px;line-height:1.85;color:#bad0c3}.calculator-basis p+p{margin-top:9px;font-size:14px;color:#a2bac7}.cost-pair{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:34px}.cost-pair h3{font-size:21px;line-height:1.6}.cost-pair p{font-size:16px;line-height:1.85;color:#a9bfca;margin-top:10px}.evaluation-criteria{margin-top:43px}.evaluation-criteria>h3{font-size:24px;line-height:1.6}.evaluation-criteria>div{display:grid;grid-template-columns:repeat(4,1fr);gap:25px;margin-top:26px}.evaluation-criteria h4{font-size:18px;line-height:1.6;color:#c9e2d1}.evaluation-criteria p{font-size:15px;line-height:1.85;color:#a5bdca;margin-top:11px}
