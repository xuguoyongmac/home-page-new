---
import Icon from '../../../components/Icon.astro';
import type { Locale } from '../../../data/types';
import { depthCopy } from './depth_V1.3';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = depthCopy[locale];
---
<div class="value-depth" data-value-depth data-locale={locale}>
  <section class="depth-section report-section" aria-labelledby="report-value-title">
    <div class="container">
      <div class="section-heading"><h2 id="report-value-title">{c.report.title.map(line => <span>{line}</span>)}</h2><p>{c.report.body}</p></div>
      <div class="report-work">
        <div class="report-inputs">{c.report.inputs.map(input => <span><Icon name="file" size={18}/>{input}</span>)}</div>
        <div class="report-delivery">
          <article class="main-report"><p class="report-context">{c.report.context}</p><h3>{c.report.name}</h3><div class="report-questions">{c.report.questions.map(question => <p><Icon name="check" size={20}/>{question}</p>)}</div><div class="report-purpose"><strong>{c.report.reportLabel}</strong><p>{c.report.reportLine}</p></div></article>
          <div class="report-support"><article><h3><Icon name="chart" size={24}/>{c.report.detailLabel}</h3><div class="calculation-row">{c.report.detailLine}</div><div class="calculation-row">{c.report.detailSecond}</div></article><article><h3><Icon name="message" size={24}/>{c.report.issueLabel}</h3><p>{c.report.issueLine}</p></article></div>
        </div>
        <div class="report-audience">{c.report.result.map(result => <span><Icon name="check" size={18}/>{result}</span>)}</div>
      </div>
    </div>
  </section>

  <section class="depth-section collaboration-section" aria-labelledby="human-value-title">
    <div class="container">
      <div class="section-heading"><h2 id="human-value-title">{c.collaboration.title.map(line => <span>{line}</span>)}</h2><p>{c.collaboration.body}</p></div>
      <div class="human-relay">
        <h3>{c.collaboration.context}</h3>
        <div class="relay-conversation"><article class="relay-question"><Icon name="cpu" size={28}/><div><h4>{c.collaboration.questionTitle}</h4><p>{c.collaboration.question}</p></div></article><article class="relay-answer"><Icon name="message" size={28}/><div><h4>{c.collaboration.answerTitle}</h4><p>{c.collaboration.answer}</p></div></article></div>
        <div class="relay-return"><span>{c.collaboration.continuation}</span><Icon name="arrow" size={23}/><strong>{c.collaboration.revision}</strong></div>
        <div class="version-line">{c.collaboration.versions.map((version,index) => <><span class={index===2?'current':''}><Icon name="file" size={19}/>{version}</span>{index<2&&<Icon name="arrow" size={22}/>}</>)}</div>
      </div>
      <div class="value-three">{c.collaboration.values.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div>
    </div>
  </section>

  <section class="depth-section method-section" aria-labelledby="methods-title"><div class="container"><h2 id="methods-title">{c.methods.title}</h2><div class="method-grid">{c.methods.items.map((item,index) => <article><Icon name={['book','network','chart'][index]} size={34}/><h3>{item.title}</h3><p class="method-friction">{item.problem}</p><p>{item.value}</p><div class="method-examples">{item.examples}</div></article>)}</div></div></section>

  <section class="depth-section scenes-section" aria-labelledby="role-value-title">
    <div class="container">
      <div class="section-heading stacked"><h2 id="role-value-title">{c.scenesTitle}</h2><p>{c.scenesBody}</p></div>
      <div class="role-tabs" role="tablist" aria-label={c.sceneLabel}>{c.scenes.map((scene,index) => <button type="button" id={`role-tab-${scene.id}`} role="tab" aria-selected={index===2?'true':'false'} aria-controls={`role-panel-${scene.id}`} tabindex={index===2?0:-1}>{scene.label}</button>)}</div>
      {c.scenes.map((scene,index) => <div class="role-panel" role="tabpanel" id={`role-panel-${scene.id}`} aria-labelledby={`role-tab-${scene.id}`} tabindex="0" hidden={index!==2}>
        <div class="role-work"><h3>{scene.title}</h3><dl><div><dt>{c.inputLabel}</dt><dd>{scene.input}</dd></div><div><dt>{c.actionLabel}</dt><dd>{scene.action}</dd></div></dl><div class="role-condition"><h4>{c.conditionLabel}</h4><p>{scene.condition}</p></div></div>
        <div class="role-delivery"><h4>{c.outputLabel}</h4><div class="role-outputs">{scene.outputs.map(output => <article><Icon name="file" size={24}/><div><h5>{output.title}</h5><p>{output.body}</p></div></article>)}</div><div class="role-human"><h4>{c.humanLabel}</h4><p>{scene.human}</p></div></div>
      </div>)}
    </div>
  </section>

  <section class="depth-section scale-section" aria-labelledby="scale-title"><div class="container">
    <div class="section-heading"><h2 id="scale-title">{c.scale.title.map(line => <span>{line}</span>)}</h2><p>{c.scale.body}</p></div>
    <div class="scale-layers">{c.scale.layers.map((layer,index) => <article><Icon name={['book','terminal','layers'][index]} size={28}/><h3>{layer.title}</h3><p>{layer.body}</p></article>)}</div>
    <div class="reusable-assets">{c.scale.assets.map(asset => <div><strong>{asset.name}</strong><span>{asset.meaning}</span></div>)}</div>
    <div class="operating-owners"><h3>{c.scale.ownersTitle}</h3><ul>{c.scale.owners.map(owner => <li><Icon name="check" size={18}/>{owner}</li>)}</ul></div>
  </div></section>

  <section class="depth-section trust-section" aria-labelledby="trust-title"><div class="container"><h2 id="trust-title">{c.trust.title}</h2><div class="trust-grid">{c.trust.items.map(item => <article><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></div></section>

  <section class="depth-section delivery-section" aria-labelledby="delivery-title"><div class="container">
    <h2 id="delivery-title">{c.delivery.title}</h2>
    <div class="delivery-steps">{c.delivery.steps.map((step,index) => <article><span class="step-marker" aria-hidden="true"><Icon name={['file','plug','layers'][index]} size={25}/></span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div>
    <div class="delivery-scope">{c.delivery.scopes.map(scope => <article><h3>{scope.title}</h3><p>{scope.body}</p></article>)}</div>
    <div class="delivery-environment"><h3>{c.delivery.environmentTitle}</h3><div>{c.delivery.environment.map(item => <article><h4>{item.title}</h4><p>{item.body}</p></article>)}</div></div>
  </div></section>

  <section class="depth-section measure-section" aria-labelledby="measure-title"><div class="container">
    <div class="section-heading"><h2 id="measure-title">{c.measure.title.map(line => <span>{line}</span>)}</h2><p>{c.measure.body}</p></div>
    <div class="effort-calculator">
      <div class="calculator-fields">{c.measure.labels.map((label,index) => <div><label for={`effort-input-${index}`}>{label}</label><input id={`effort-input-${index}`} type="number" min="0" step={index===0?'1':'any'} inputmode={index===0?'numeric':'decimal'} data-effort-input aria-describedby="effort-basis" autocomplete="off"/></div>)}<p class="calculator-error" data-calculator-error hidden>{c.measure.error}</p></div>
      <div class="calculator-results" aria-live="polite" aria-atomic="true"><div><span>{c.measure.outputLabels[0]}</span><output data-hours>—</output></div><div><span>{c.measure.outputLabels[1]}</span><output data-time-value>—</output></div></div>
      <div class="calculator-basis" id="effort-basis"><p>{c.measure.formula}</p><p>{c.measure.basis}</p></div>
    </div>
    <div class="cost-pair">{c.measure.costs.map(cost => <article><h3>{cost.title}</h3><p>{cost.body}</p></article>)}</div>
    <div class="evaluation-criteria"><h3>{c.measure.criteriaTitle}</h3><div>{c.measure.criteria.map(item => <article><h4>{item.title}</h4><p>{item.body}</p></article>)}</div></div>
  </div></section>

  <section class="depth-section rollout-section" aria-labelledby="rollout-title"><div class="container">
    <h2 id="rollout-title">{c.rollout.title}</h2><div class="rollout-stages">{c.rollout.stages.map(stage => <article><h3>{stage.title}</h3><p>{stage.body}</p></article>)}</div>
    <div class="workshop-result"><h3>{c.rollout.workshop}</h3><ul>{c.rollout.outputs.map(output => <li><Icon name="check" size={18}/>{output}</li>)}</ul></div>
  </div></section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-value-depth]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.role-tabs [role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.role-panel')];
    const selectTab = (tab: HTMLButtonElement) => {
      tabs.forEach(item => { const selected = item === tab; item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1; });
      panels.forEach(panel => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
    };
    tabs.forEach((tab,index) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', event => {
        const next = event.key === 'ArrowRight' ? (index+1)%tabs.length : event.key === 'ArrowLeft' ? (index+tabs.length-1)%tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length-1 : undefined;
        if (next === undefined) return;
        event.preventDefault(); selectTab(tabs[next]); tabs[next].focus();
      });
    });
    const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-effort-input]')];
    const hours = root.querySelector<HTMLOutputElement>('[data-hours]')!;
    const timeValue = root.querySelector<HTMLOutputElement>('[data-time-value]')!;
    const error = root.querySelector<HTMLElement>('[data-calculator-error]')!;
    const format = new Intl.NumberFormat(root.dataset.locale === 'zh' ? 'zh-CN' : 'en-US', {minimumFractionDigits:2,maximumFractionDigits:2});
    const update = () => {
      let invalid = false;
      inputs.forEach(input => {
        const failed = !input.validity.valid || (input.value !== '' && !Number.isFinite(Number(input.value)));
        input.setAttribute('aria-invalid', String(failed)); invalid ||= failed;
      });
      error.hidden = !invalid;
      const values = inputs.map(input => Number(input.value));
      if (invalid || inputs.some(input => input.value.trim() === '')) {hours.value='—';timeValue.value='—';return;}
      const savedHours = values[0] * (values[1]-values[2]) / 60;
      const worth = savedHours * values[3];
      if (!Number.isFinite(savedHours) || !Number.isFinite(worth)) {hours.value='—';timeValue.value='—';error.hidden=false;return;}
      hours.value=format.format(savedHours === 0 ? 0 : savedHours);
      timeValue.value=format.format(worth === 0 ? 0 : worth);
    };
    inputs.forEach(input => input.addEventListener('input',update));
  });
</script>

<style>
  .value-depth{--depth-muted:#a8bac6;--depth-accent:#c2e7d2;background:#0a1218;color:#e9f1f6}
  .value-depth :is(h2,h3,h4,h5,p,dl,dd,ul){margin:0}.value-depth :is(h2,h3,h4,h5){font-weight:550}.value-depth [hidden]{display:none!important}
  .value-depth :is(button,input,[role='tabpanel']):focus-visible{outline:2px solid #b7e3ca;outline-offset:5px}
  .depth-section{padding:84px 0}.depth-section h2{scroll-margin-top:110px;font-size:clamp(29px,3vw,41px);line-height:1.45;letter-spacing:-.035em;text-wrap:balance}.depth-section h2 span{display:block}
