---
import Icon from '../../../components/Icon.astro';
import { pathFor } from '../../../lib/site';
import { appliancePage } from './content';
import type { Locale } from '../../../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = appliancePage[locale];
---

<section class="station-hero" aria-labelledby="station-title">
  <div class="container">
    <div class="station-hero-grid">
      <div class="station-copy">
        <h1 id="station-title">{copy.name}</h1>
        <p class="station-headline">{copy.headline}</p>
        <p class="station-description">{copy.description}</p>
        <a class="station-contact" href={pathFor(locale, 'contact')}>{copy.action}</a>
      </div>
      <div class="station-product">
        <img src="/images/appliance/tego-station_V1.0.webp" width="1449" height="759" alt="TeGo Station" fetchpriority="high" decoding="async"/>
      </div>
    </div>
    <dl class="station-highlights">
      {copy.highlights.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </div>
</section>

<section class="station-section station-delivery" aria-labelledby="station-delivery-title">
  <div class="container">
    <h2 id="station-delivery-title">{copy.titles.delivery}</h2>
    <div class="station-delivery-grid">
      {copy.delivery.map(item => <article class="station-feature">
        <Icon name={item.icon} size={27}/>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>)}
    </div>
  </div>
</section>

<section class="station-section station-scenarios" aria-labelledby="station-scenarios-title">
  <div class="container">
    <h2 id="station-scenarios-title">{copy.titles.scenarios}</h2>
    <div class="station-scenario-grid">
      {copy.scenarios.map(item => <article class="station-feature">
        <Icon name={item.icon} size={25}/>
        <h3>{item.title}</h3>
        <p>{item.description}</p>
      </article>)}
    </div>
  </div>
</section>

<section class="station-section station-specifications" aria-labelledby="station-specs-title">
  <div class="container">
    <h2 id="station-specs-title">{copy.titles.specs}</h2>
    <dl class="station-specs">
      {copy.specs.map(item => <div><dt>{item.name}</dt><dd>{item.value}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .station-hero{padding:65px 0 46px;background:radial-gradient(ellipse at 80% 35%,#193d5c55,transparent 52%),#070f19;overflow:hidden}
  .station-hero-grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.25fr);align-items:center;gap:32px}
  .station-copy h1{margin:0;color:#edf5ff;font-size:clamp(40px,4.4vw,58px);font-weight:550;letter-spacing:-1.8px;line-height:1.2}
  .station-headline{margin:21px 0 0;color:#dceafb;font-size:clamp(26px,2.6vw,36px);font-weight:500;line-height:1.5;letter-spacing:-.7px;white-space:pre-line}
  .station-description{max-width:470px;margin:20px 0 0;color:#adbed0;font-size:15px;line-height:1.9}
  .station-contact{display:inline-flex;align-items:center;justify-content:center;min-height:46px;margin-top:28px;padding:10px 25px;border:1px solid #7895ac66;border-radius:8px;background:transparent;color:#e3effb;font-size:15px;transition:background-color .18s,border-color .18s}
  .station-contact:hover,.station-contact:focus-visible{border-color:#8ecbff;background:#4c93c52b}
  .station-contact:focus-visible{outline:2px solid #8ecbff;outline-offset:4px}
  .station-product{min-width:0;display:flex;align-items:center;justify-content:center;padding:16px 0}
  .station-product img{display:block;width:100%;height:auto;filter:drop-shadow(0 28px 24px #0008)}
  .station-highlights{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px;margin:44px 0 0;padding:0}
  .station-highlights>div{display:grid;grid-template-rows:auto 1fr;gap:8px}
  .station-highlights dt{grid-row:2;font-size:13px;line-height:1.6;color:#9eb6cb}
  .station-highlights dd{grid-row:1;margin:0;color:#edf5ff;font-size:30px;font-weight:500;line-height:1.25;letter-spacing:-.5px}
  .station-section{padding:68px 0;background:#0a1420}
  .station-section h2{margin:0 0 34px;color:#edf5ff;font-size:30px;line-height:1.5;font-weight:550;letter-spacing:-.6px}
  .station-feature{min-width:0}
  .station-feature>:global(svg){color:#8fb9dc}
  .station-feature h3{margin:17px 0 10px;color:#e4effa;font-size:18px;line-height:1.5;font-weight:500}
  .station-feature p{margin:0;color:#a9bacb;font-size:14px;line-height:1.85}
  .station-scenario-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .station-scenario-grid article{padding:25px 22px;background:#102033;border:1px solid #8bb0cb22;border-radius:14px}
  .station-specifications{background:#0d1927}
  .station-specs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:56px;margin:0}
  .station-specs>div{display:grid;grid-template-columns:116px minmax(0,1fr);gap:20px;padding:19px 0;border-bottom:1px solid #99bfda24}
  .station-specs dt{color:#9db5ca;font-size:14px;line-height:1.8}
  .station-specs dd{margin:0;color:#d6e5f2;font-size:14px;line-height:1.8;overflow-wrap:anywhere}
  .station-specs>div:nth-last-child(-n+2){border-bottom:0}
  .station-delivery{background:#0d1927}
  .station-delivery-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:36px}
  @media(max-width:1100px){
    .station-hero{padding-top:48px}
    .station-hero-grid{gap:20px;grid-template-columns:minmax(0,1fr) minmax(0,1.1fr)}
    .station-copy h1{font-size:46px}.station-headline{font-size:28px}
    .station-scenario-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .station-specs{column-gap:34px}.station-specs>div{grid-template-columns:98px minmax(0,1fr);gap:14px}
    .station-delivery-grid{gap:24px}
  }
  @media(max-width:800px){
    .station-hero{padding:38px 0 38px}
    .station-hero-grid{grid-template-columns:minmax(0,1fr);gap:20px}
    .station-copy h1{font-size:44px}.station-headline{font-size:28px;line-height:1.5;margin-top:18px}
    .station-description{margin-top:16px;max-width:540px}.station-contact{margin-top:23px}
    .station-product{max-width:600px;justify-self:center;padding:10px 0 0}
    .station-highlights{gap:20px;margin-top:24px}.station-highlights dd{font-size:27px}.station-highlights dt{font-size:12px}
    .station-section{padding:46px 0}.station-section h2{font-size:27px;margin-bottom:28px}
    .station-specs{grid-template-columns:minmax(0,1fr)}.station-specs>div{grid-template-columns:124px minmax(0,1fr);gap:22px;padding:16px 0}
    .station-specs>div:nth-last-child(2){border-bottom:1px solid #99bfda24}
    .station-delivery-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
  }
  @media(max-width:480px){
    .station-copy h1{font-size:40px;letter-spacing:-1.3px}.station-headline{font-size:26px;letter-spacing:-.4px}
    .station-description{font-size:14px}.station-highlights{gap:12px}.station-highlights dd{font-size:24px}
    .station-scenario-grid,.station-delivery-grid{grid-template-columns:minmax(0,1fr);gap:27px}
    .station-delivery-grid .station-feature{display:grid;grid-template-columns:28px minmax(0,1fr);gap:8px 15px}
    .station-delivery-grid .station-feature>:global(svg){grid-row:1/3;margin-top:2px}
    .station-delivery-grid .station-feature h3{margin:0}
    .station-delivery-grid .station-feature p{grid-column:2}
    .station-scenario-grid article{padding:22px}.station-specs>div{grid-template-columns:96px minmax(0,1fr);gap:16px}
  }
  @media(prefers-reduced-motion:reduce){.station-contact{transition:none}}
</style>
