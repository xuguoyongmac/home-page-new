---
import { pathFor } from '../../../lib/site';
import type { Locale } from '../../../data/types';
import type { IndustrySolutionCopy } from './types';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import EmployeeCarousel from '../banking/EmployeeCarousel.astro';
import '../../../styles/banking-page.css';
import '../../../styles/industry-solutions.css';

interface Props { locale: Locale; slug: string; presentation: IndustrySolutionCopy; Visual: AstroComponentFactory; backgroundSize?: { width: number; height: number }; }
const { locale, slug, presentation, Visual, backgroundSize = { width: 1600, height: 800 } } = Astro.props;
const zh = locale === 'zh';
---
<div class:list={['banking-solution', 'industry-solution', `industry-solution-${slug}`]} data-industry-solution={slug}>
  <section class="banking-hero" aria-labelledby={`${slug}-title`}>
    <img class="banking-banner-background" src={presentation.hero.background} alt="" width={backgroundSize.width} height={backgroundSize.height} sizes={`(max-width: 1080px) ${zh ? 2400 : 2800}px, 100vw`} loading="eager" decoding="async" fetchpriority="high" aria-hidden="true"/>
    <div class="container banking-hero-grid">
      <div class="banking-hero-copy">
        <h1 id={`${slug}-title`} aria-label={presentation.home.title}>{presentation.hero.lines.map(line => <span>{line}</span>)}</h1>
        <div class="banking-hero-summary">
          <p>{presentation.home.value}</p>
          <a class="button banking-contact" href={pathFor(locale, 'contact')}>{zh ? '预约方案交流' : 'Discuss your solution'}</a>
        </div>
      </div>
      <div class="banking-hero-product industry-hero-overview"><Visual locale={locale} index={-1}/></div>
    </div>
  </section>

  {presentation.features.map((feature, index) => <section class:list={['banking-feature-section', {'banking-feature-reversed': index % 2 === 1}]} aria-labelledby={`${slug}-feature-${index}`}>
    <div class="container banking-feature-grid">
      <div class="banking-feature-copy">
        <h2 id={`${slug}-feature-${index}`}>{feature.title.split('，').map((line, lineIndex, lines) => <span>{line}{lineIndex < lines.length - 1 ? '，' : ''}</span>)}</h2>
        <dl class="banking-feature-details">
          <div class="banking-feature-problem"><dt>{zh ? '业务痛点' : 'Challenge'}</dt><dd>{feature.problem}</dd></div>
          <div class="banking-feature-body"><dt>{zh ? '方案' : 'Solution'}</dt><dd>{feature.body}</dd></div>
        </dl>
      </div>
      <div class="banking-feature-visual"><Visual locale={locale} index={index}/></div>
    </div>
  </section>)}

  <section class="banking-section banking-scenarios" aria-labelledby={`${slug}-team-title`}>
    <div class="container"><h2 id={`${slug}-team-title`}>{presentation.teamTitle}</h2></div>
    <EmployeeCarousel locale={locale} employees={presentation.employees} teamLabel={presentation.teamTitle}/>
  </section>

  <section class="banking-deployment" aria-labelledby={`${slug}-deployment-title`}>
    <div class="container banking-deployment-grid">
      <h2 id={`${slug}-deployment-title`}>{presentation.deployment.title}</h2>
      <p>{presentation.deployment.body}</p>
    </div>
  </section>
</div>

<style>
  @media (max-width: 600px) {
    .industry-solution .banking-banner-background { object-position: 12% center; }
  }
</style>
