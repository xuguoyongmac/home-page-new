---
import { pathFor } from '../../../lib/site';
import type { Locale } from '../../../data/types';
import type { IndustrySolutionCopy } from './types';
import SolutionArtwork from '../../../components/SolutionArtwork.astro';
import '../../../styles/industry-value-page.css';

interface Props { locale: Locale; slug: string; presentation: IndustrySolutionCopy; }
const { locale, slug, presentation: copy } = Astro.props;
const zh = locale === 'zh';
---
<div class="industry-value-page" data-industry-solution={slug}>
  <section class="industry-value-hero" aria-labelledby={`${slug}-title`}>
    <img class="industry-value-landscape" src={copy.hero.background} alt="" width="1600" height="1067" loading="eager" decoding="async" fetchpriority="high" aria-hidden="true"/>
    <div class="container industry-value-hero-content">
      <h1 id={`${slug}-title`}>{copy.hero.lines.map(line => <span>{line}</span>)}</h1>
      <p>{copy.home.value}</p>
      <a class="button" href={pathFor(locale, 'contact')}>{zh ? '预约方案交流' : 'Discuss your solution'}</a>
      <ul class="industry-value-scenarios" aria-label={zh ? '业务场景' : 'Business scenarios'}>{copy.home.scenarios.map(item => <li>{item}</li>)}</ul>
    </div>
  </section>

  <section class="industry-value-story" aria-label={zh ? '方案价值' : 'Business value'}>
    <div class="container industry-value-story-grid">
      <figure class="industry-value-artwork">
        <SolutionArtwork src={copy.hero.illustration} alt={copy.home.title} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1216px) calc(100vw - 96px), 1120px"/>
      </figure>
      <div class="industry-value-propositions">
        {copy.features.map((feature, index) => <article aria-labelledby={`${slug}-feature-${index}`}>
          <h2 id={`${slug}-feature-${index}`}>{feature.title}</h2>
          <p>{feature.body}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section class="industry-value-deployment" aria-labelledby={`${slug}-deployment-title`}>
    <div class="container industry-value-deployment-grid">
      <h2 id={`${slug}-deployment-title`}>{copy.deployment.title}</h2>
      <p>{copy.deployment.body}</p>
    </div>
  </section>
</div>
