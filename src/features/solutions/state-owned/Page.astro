---
import type { Locale } from '../../../data/types';
import { pathFor } from '../../../lib/site';
import EmployeeCarousel from '../banking/EmployeeCarousel.astro';
import SolutionVisual from './SolutionVisual.astro';
import { stateOwnedPresentation } from './page-content';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = stateOwnedPresentation[locale];
const zh = locale === 'zh';
---

<div class:list={['soe-solution', { 'soe-solution-en': !zh }]} data-industry-solution="state-owned">
  <section class="soe-hero" aria-labelledby="soe-title">
    <img class="soe-industrial-site" src={copy.hero.background} width="3548" height="1774" alt="" sizes={`(max-width: 800px) ${zh ? 1600 : 2000}px, 100vw`} aria-hidden="true" loading="eager" decoding="async" fetchpriority="high"/>
    <div class="soe-shell soe-hero-main">
      <h1 id="soe-title" aria-label={copy.home.title}>{copy.hero.lines.map(line => <span>{line}</span>)}</h1>
      <p>{copy.home.value}</p>
      <a class="button soe-contact" href={pathFor(locale, 'contact')}>{zh ? '预约方案交流' : 'Discuss your solution'}</a>
    </div>
    <div class="soe-shell soe-hero-axis"><SolutionVisual locale={locale} index={-1}/></div>
  </section>

  <section class="soe-project-control" aria-labelledby="soe-control-title">
    <svg class="soe-engineering-drawing" viewBox="0 0 1240 410" fill="none" aria-hidden="true"><path d="M43 340V144h156v196m-144-196V97h31v47m32 0V75h32v69m19 0v196M43 200h156M43 266h156M232 340V194h103v146m-103-97h103m-75-49V88h47v106M370 340V108h265v232m-265-158h265m-265 78h265m-222-152v232m87-232v232m91-232v232M674 340V195h178v145m-178-145 89-69 89 69m-178 70h178m-136-70v145m91-145v145M893 340V96h45v244m-45-185h45m-45 89h45M983 340V172h196v168m-196-168 98-70 98 70m-196 82h196m-147-82v168m96-168v168M199 220h33m103 0h35m265 0h39m178 0h41m45 0h45M32 341h1160M32 357h1160"/><path class="soe-drawing-foundation" d="M32 358v22h179v-22m11 0v22h123v-22m15 0v22h285v-22m20 0v22h199v-22m19 0v22h66v-22m22 0v22h221v-22"/></svg>
    <div class="soe-shell">
      <div class="soe-control-intro">
        <h2 id="soe-control-title">{copy.features[0].title.split(zh ? '，' : '\n').map(line => <span>{line}</span>)}</h2>
        <p>{copy.features[0].body}</p>
      </div>
      <SolutionVisual locale={locale} index={0}/>
    </div>
  </section>

  <section class="soe-commercial" aria-labelledby="soe-commercial-title">
    <div class="soe-shell">
      <div class="soe-commercial-intro">
        <h2 id="soe-commercial-title">{copy.features[1].title}</h2>
        <p>{copy.features[1].body}</p>
      </div>
      <SolutionVisual locale={locale} index={1}/>
    </div>
  </section>

  <section class="soe-field-delivery" aria-labelledby="soe-delivery-title">
    <div class="soe-field-context" aria-hidden="true"><img src="/images/solutions/state-owned/state-owned-industrial-site_V1.1.webp" width="1600" height="900" alt="" loading="lazy" decoding="async"/></div>
    <div class="soe-shell">
      <div class="soe-delivery-intro">
        <h2 id="soe-delivery-title">{copy.features[2].title.split(zh ? '，' : '\n').map(line => <span>{line}</span>)}</h2>
        <p>{copy.features[2].body}</p>
      </div>
      <SolutionVisual locale={locale} index={2}/>
    </div>
  </section>

  <section class="soe-employees" aria-labelledby="soe-team-title">
    <div class="soe-shell"><h2 id="soe-team-title">{copy.teamTitle}</h2></div>
    <EmployeeCarousel locale={locale} employees={copy.employees} teamLabel={copy.teamTitle}/>
  </section>

  <section class="soe-deployment" aria-labelledby="soe-deployment-title">
    <div class="soe-shell soe-deployment-layout">
      <h2 id="soe-deployment-title">{copy.deployment.title}</h2>
      <p>{copy.deployment.body}</p>
    </div>
  </section>
</div>

<style>
  .soe-solution { --soe-heading: #edece6; --soe-copy: #b0b9bd; --soe-copper: #d1aa78; color: var(--soe-heading); background: #0e151b; overflow: clip; }
  .soe-shell { width: min(1280px, calc(100% - 96px)); margin-inline: auto; }
  .soe-solution h1, .soe-solution h2, .soe-solution p { margin: 0; }
  .soe-solution h2 { color: #ecece7; font-size: clamp(31px, 3.3vw, 44px); font-weight: 550; line-height: 1.4; letter-spacing: -.035em; text-wrap: balance; }
  .soe-solution h2 > span { display: block; }
  .soe-solution p { color: var(--soe-copy); font-size: 15px; line-height: 1.95; text-wrap: pretty; }
  .soe-hero { position: relative; isolation: isolate; min-height: 680px; padding: 67px 0 32px; background: #1a242b; }
  .soe-industrial-site { position: absolute; z-index: -3; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 56%; filter: brightness(1.04) contrast(1.03); }
  .soe-hero::before { content: ''; position: absolute; z-index: -2; inset: 0; background: linear-gradient(90deg, #09141d9c 0%, #0d1a264d 34%, transparent 77%), linear-gradient(0deg, #11181be6 0%, #11181b66 14%, transparent 45%); }
  .soe-hero-main { position: relative; min-height: 365px; }
  .soe-hero h1 { max-width: 970px; color: #f3f0e8; font-size: clamp(39px, 4.5vw, 61px); line-height: 1.4; font-weight: 550; letter-spacing: -.05em; text-shadow: 0 3px 24px #00000030; }
  .soe-hero h1 > span { display: block; }
  .soe-hero h1 > span:last-child { color: #e8c79b; }
  .soe-hero-main > p { max-width: 575px; margin-top: 24px; color: #e1e5e5; font-size: 16px; line-height: 1.9; text-shadow: 0 1px 8px #08111ecc; }
  .soe-contact { margin-top: 29px; min-height: 46px; padding-inline: 23px; }
  .soe-hero-axis { position: relative; margin-top: 34px; text-shadow: 0 1px 6px #000c; }
  .soe-project-control { position: relative; isolation: isolate; padding: 80px 0 82px; background: linear-gradient(135deg, #11181b, #182023 67%, #1b211f); }
  .soe-project-control > .soe-shell { position: relative; z-index: 1; }
  .soe-engineering-drawing { position: absolute; z-index: 0; top: 30px; right: -2%; width: min(1240px, 91%); height: auto; color: #a3916b; opacity: .065; pointer-events: none; stroke: currentColor; stroke-width: 1.2; stroke-linecap: square; }
  .soe-engineering-drawing .soe-drawing-foundation { stroke: #b7ad93; }
  .soe-control-intro { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1fr); gap: 100px; align-items: start; margin-bottom: 44px; }
  .soe-control-intro p { max-width: 565px; padding-top: 7px; }
  .soe-commercial { position: relative; isolation: isolate; padding: 75px 0 83px; background: linear-gradient(115deg, #202424 0%, #1a2427 43%, #121c22 100%); }
  .soe-commercial::before { content: ''; position: absolute; z-index: -1; top: 0; bottom: 0; left: 0; width: 34%; background: linear-gradient(135deg, #9c744319, #80604406 67%, transparent); pointer-events: none; }
  .soe-commercial-intro { max-width: 925px; margin-bottom: 39px; }
  .soe-commercial-intro h2 { max-width: 890px; }
  .soe-commercial-intro > p { max-width: 785px; margin-top: 24px; }
  .soe-field-delivery { position: relative; isolation: isolate; padding: 79px 0 86px; background: linear-gradient(145deg, #151c21 0%, #141b20 50%, #211d18 100%); }
  .soe-field-delivery > .soe-shell { position: relative; z-index: 1; }
  .soe-field-context { position: absolute; z-index: 0; top: 0; right: 0; width: min(1060px, 77%); height: 550px; overflow: hidden; pointer-events: none; }
  .soe-field-context > img { width: 100%; height: 100%; object-fit: cover; object-position: right 73%; opacity: .2; filter: saturate(.6); }
  .soe-field-context::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #151c21 0%, #151c2100 34%, #141b2033 84%, #141b20 100%), linear-gradient(0deg, #141b20 0%, #141b2000 43%, #151c2100 78%, #151c21 100%); }
  .soe-delivery-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 90px; align-items: end; margin-bottom: 44px; }
  .soe-delivery-intro h2 { max-width: 560px; }
  .soe-delivery-intro p { max-width: 595px; padding-bottom: 4px; }
  .soe-employees { padding: 57px 0 36px; background: linear-gradient(180deg, #181d1c, #111a20 57%); }
  .soe-employees h2 { font-size: clamp(28px, 2.6vw, 36px); }
  .soe-deployment { padding: 44px 0 50px; background: linear-gradient(110deg, #2a2c25, #222d30 50%, #1a272d); }
  .soe-deployment-layout { display: grid; grid-template-columns: minmax(0, .86fr) minmax(0, 1.2fr); gap: 90px; align-items: center; }
  .soe-deployment h2 { font-size: clamp(25px, 2.2vw, 31px); }
  .soe-deployment p { font-size: 14px; }
  .soe-solution-en .soe-hero h1 { max-width: 1010px; font-size: clamp(38px, 4.3vw, 59px); line-height: 1.25; letter-spacing: -.035em; }
  .soe-solution-en .soe-hero-main > p { max-width: 600px; font-size: 15px; line-height: 1.85; }
  .soe-solution-en h2 { font-size: clamp(31px, 3vw, 41px); line-height: 1.3; letter-spacing: -.025em; }
  .soe-solution-en .soe-deployment h2 { font-size: 28px; }
  @media (max-width: 1100px) {
    .soe-shell { width: calc(100% - 64px); }
    .soe-hero { min-height: 680px; padding-top: 55px; }
    .soe-hero-main { min-height: 365px; }
    .soe-hero h1 { font-size: 51px; }
    .soe-control-intro, .soe-delivery-intro { gap: 50px; }
    .soe-deployment-layout { gap: 55px; }
  }
  @media (max-width: 800px) {
    .soe-hero { min-height: 0; padding-top: 55px; }
    .soe-hero-main { min-height: 390px; }
    .soe-hero h1 { font-size: 43px; }
    .soe-hero-main > p { max-width: 550px; }
    .soe-hero::before { background: linear-gradient(90deg, #09141db3, #0d1a2673 62%, #10202a14), linear-gradient(0deg, #11181be6 0%, #11181b73 20%, transparent 65%); }
    .soe-engineering-drawing { top: 85px; width: 110%; right: -10%; opacity: .055; }
    .soe-field-context { width: 100%; height: 540px; }
    .soe-field-context > img { opacity: .15; object-position: right 70%; }
    .soe-project-control, .soe-commercial, .soe-field-delivery { padding-block: 56px; }
    .soe-control-intro, .soe-delivery-intro, .soe-deployment-layout { grid-template-columns: 1fr; gap: 23px; }
    .soe-control-intro, .soe-commercial-intro, .soe-delivery-intro { margin-bottom: 30px; }
    .soe-control-intro p, .soe-delivery-intro p { max-width: 650px; padding: 0; }
    .soe-commercial-intro > p { margin-top: 23px; }
    .soe-solution h2, .soe-solution-en h2 { font-size: 34px; }
    .soe-employees { padding-top: 45px; }
    .soe-employees h2 { font-size: 29px; }
    .soe-deployment h2, .soe-solution-en .soe-deployment h2 { font-size: 28px; }
  }
  @media (max-width: 600px) {
    .soe-shell { width: calc(100% - 40px); }
    .soe-hero { padding: 37px 0 24px; }
    .soe-industrial-site { object-position: 62% center; }
    .soe-hero-main { min-height: 0; }
    .soe-hero h1 { font-size: clamp(30px, 7.7vw, 41px); line-height: 1.5; letter-spacing: -.045em; }
    .soe-solution-en .soe-hero h1 { font-size: clamp(33px, 8.4vw, 42px); }
    .soe-hero-main > p, .soe-solution-en .soe-hero-main > p { margin-top: 20px; font-size: 14px; line-height: 1.9; }
    .soe-contact { margin-top: 23px; min-height: 44px; }
    .soe-hero-axis { margin-top: 36px; }
    .soe-project-control, .soe-commercial, .soe-field-delivery { padding-block: 42px; }
    .soe-engineering-drawing { top: 66px; width: 170%; right: -35%; opacity: .045; }
    .soe-commercial::before { width: 78%; }
    .soe-field-context { height: 485px; }
    .soe-field-context > img { opacity: .13; object-position: 72% 70%; }
    .soe-solution h2, .soe-solution-en h2 { font-size: clamp(28px, 7vw, 32px); line-height: 1.4; }
    .soe-solution p { font-size: 14px; }
    .soe-control-intro, .soe-delivery-intro { gap: 19px; }
    .soe-commercial-intro > p { margin-top: 20px; }
    .soe-employees { padding-top: 36px; }
    .soe-employees h2 { font-size: 26px; }
    .soe-deployment { padding-block: 32px; }
    .soe-deployment h2, .soe-solution-en .soe-deployment h2 { font-size: 25px; }
    .soe-deployment-layout { gap: 18px; }
  }
</style>
