---
import type { Locale } from '../../data/types';
import { pathFor, site } from '../../lib/site';
import Icon from '../../components/Icon.astro';
import './styles.css';
interface Props { locale: Locale; page: string; navigation?: boolean; }
const { locale, page, navigation = true } = Astro.props;
const zh = locale === 'zh';
const links = [['resources', zh ? '资源中心' : 'Resources'], ['download', zh ? '客户端下载' : 'Downloads'], ['releases', zh ? '历史版本' : 'Release archive'], ['faq', zh ? '常见问题' : 'FAQ']];
---
<div class="support-shell" data-support-locale={locale}>
  {navigation && <nav class="support-nav container" aria-label={zh ? '资源与支持导航' : 'Resources and support'}><div>{links.map(([slug, name]) => <a href={pathFor(locale, slug)} aria-current={page === slug ? 'page' : undefined}>{name}</a>)}</div><a class="support-docs-link" href={site.docs}>{zh ? '文档中心' : 'Documentation'}<Icon name="external" size={14}/></a></nav>}
  <slot/>
</div>
<script>
  const languageLink = document.querySelector<HTMLAnchorElement>('.language-link');
  if (languageLink && document.querySelector('.support-shell')) {
    languageLink.addEventListener('click', () => {
      const destination = new URL(languageLink.href);
      const current = new URL(location.href);
      for (const key of ['version', 'product', 'platform']) {
        const value = current.searchParams.get(key);
        if (value) destination.searchParams.set(key, value);
        else destination.searchParams.delete(key);
      }
      destination.hash = current.hash;
      languageLink.href = destination.pathname + destination.search + destination.hash;
    });
  }
</script>
