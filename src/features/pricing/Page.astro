---
import { pricingPlans, capabilityGroups, pricingFaqs } from './content';
import Icon from '../../components/Icon.astro';
import Shell from '../resources/Shell.astro';
import Hero from '../resources/Hero.astro';
import { pathFor } from '../../lib/site';
import type { Locale } from '../../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const groups = capabilityGroups[locale];
---
<Shell locale={locale} page="pricing" navigation={false}>
  <Hero label={zh ? '价格方案' : 'PRICING'} title={zh ? '选择适合企业的版本' : 'Choose the right edition for your business.'} description={zh ? '从免费社区版到年度订阅与企业定制，按能力与服务范围选择。' : 'From Community to an annual subscription and enterprise customization, choose the capabilities and service you need.'}>
    <div class="pricing-hero-links"><a href="#plans">{zh ? '选择方案' : 'Explore plans'}</a><a href="#capabilities">{zh ? '查看功能清单' : 'Explore capabilities'}<Icon name="arrow" size={15}/></a></div>
  </Hero>
  <section class="container pricing-plans" id="plans" aria-label={zh ? '方案选择' : 'Plan options'}>
    <div class="pricing-grid">{pricingPlans[locale].map(plan => <article class:list={['pricing-card', { 'pricing-card-featured': plan.id === 'subscription' }]} id={plan.id}>
      <div class="pricing-card-icon"><Icon name={plan.icon} size={25}/><span>{plan.audience}</span></div>
      <h2>{plan.name}</h2><p class="pricing-description">{plan.description}</p>
      <div class="pricing-quote"><strong>{plan.price}</strong><span>{plan.unit}</span></div>
      <a class:list={['button', { 'button-outline': plan.id !== 'subscription' }]} href={`${pathFor(locale, 'contact')}?plan=${plan.id}`}>{plan.action}<Icon name="arrow" size={16}/></a>
      <p class="pricing-includes">{plan.includes}</p><ul>{plan.items.map(item => <li><Icon name="check" size={16}/><span>{item}</span></li>)}</ul>
    </article>)}</div>
    <div class="pricing-delivery"><span>{zh ? '交付方式' : 'Deployment & delivery'}</span><a class="text-link" href={pathFor(locale, 'enterprise')}>{zh ? '私有化部署' : 'Private deployment'}<Icon name="arrow" size={15}/></a><a class="text-link" href={pathFor(locale, 'solutions/appliance')}>{zh ? 'TeGo Station 一体机' : 'TeGo Station appliance'}<Icon name="arrow" size={15}/></a></div>
  </section>
  <section class="support-section support-section-alt" id="capabilities" aria-labelledby="capabilities-title"><div class="container">
    <div class="support-section-heading"><div><p class="support-kicker">{zh ? '功能清单' : 'PLATFORM CAPABILITIES'}</p><h2 id="capabilities-title">{zh ? '从交办工作，到协作交付' : 'From assigning work to delivering together.'}</h2><p>{zh ? '按工作环节查看平台能力。版本权益见上方方案，集成与服务范围在报价中确定。' : 'Explore capabilities by workflow. Edition capabilities are listed above; integration and service scope are defined in the quote.'}</p></div><a class="text-link" href={pathFor(locale, 'product')}>{zh ? '产品全景' : 'Platform overview'}<Icon name="arrow" size={16}/></a></div>
    <div class="capability-browser" data-capability-browser>
      <nav class="capability-index" aria-label={zh ? '功能分类' : 'Capability categories'}>{groups.map((group, index) => <a href={`#capability-${group.id}`} data-capability-link={group.id} aria-current={index === 0 ? 'true' : undefined}><Icon name={group.icon} size={19}/><span>{group.title}</span><Icon name="arrow" size={14}/></a>)}</nav>
      <div class="capability-content">{groups.map(group => <section class="capability-group" id={`capability-${group.id}`} data-capability-group={group.id} aria-labelledby={`capability-title-${group.id}`}>
        <div class="capability-group-heading"><h3 id={`capability-title-${group.id}`}>{group.title}</h3><a class="text-link" href={pathFor(locale, group.path)}>{zh ? '了解更多' : 'Explore'}<Icon name="arrow" size={14}/></a></div>
        <dl>{group.rows.map(row => <div class="capability-row"><dt>{row.name}</dt><dd><p>{row.capability}</p><span>{row.boundary}</span></dd></div>)}</dl>
      </section>)}</div>
    </div>
  </div></section>
  <section class="support-section"><div class="container pricing-questions"><div class="pricing-questions-heading"><p class="support-kicker">{zh ? '报价与交付' : 'SCOPING YOUR PLAN'}</p><h2>{zh ? '采购与费用' : 'Purchasing and costs'}</h2><a class="text-link" href={pathFor(locale, 'faq')}>{zh ? '更多产品问题' : 'More product questions'}<Icon name="arrow" size={16}/></a></div><div class="support-accordion">{pricingFaqs[locale].map(item => <details><summary>{item.question}<Icon name="plus" size={18}/></summary><p>{item.answer}</p></details>)}</div></div></section>
  <section class="container pricing-closing"><div class="support-context"><div><h2>{zh ? '获取企业报价' : 'Get an enterprise quote'}</h2><p>{zh ? '提供使用规模、部署环境与集成要求，确认版本、服务范围和采购费用。' : 'Share your scale, deployment environment and integrations to confirm your edition, service scope and price.'}</p></div><a class="button" href={pathFor(locale, 'contact')}>{zh ? '联系销售' : 'Contact sales'}<Icon name="arrow" size={16}/></a></div></section>
</Shell>
<style>
  .pricing-hero-links{display:flex;justify-content:center;gap:28px;margin-top:23px;font-size:14px;color:#acc4d8}.pricing-hero-links a{display:flex;align-items:center;gap:8px}.pricing-hero-links a:hover{color:#74c8ff}.pricing-plans{padding-bottom:66px;scroll-margin-top:100px}.pricing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.pricing-card{display:flex;flex-direction:column;padding:29px 27px;background:linear-gradient(140deg,#112338,#0c1928);border:1px solid #a3c7df26;border-radius:18px;scroll-margin-top:100px}.pricing-card-featured{background:radial-gradient(ellipse at 50% 0,#0c588348,transparent 75%),#102338;border-color:#279bdc80;box-shadow:0 14px 50px #00142540}.pricing-card-icon{display:flex;align-items:center;gap:12px;color:#79c6fa}.pricing-card-icon>span{font-size:11px;letter-spacing:.3px;color:#8fb0cc}.pricing-card h2{font-size:24px;margin:24px 0 11px}.pricing-description{color:#adbed0;font-size:14px;line-height:1.9;min-height:80px}.pricing-quote{display:flex;flex-direction:column;margin:25px 0 24px;gap:6px}.pricing-quote strong{font-size:36px;line-height:1.5;font-weight:550;letter-spacing:-.7px}.pricing-quote>span{font-size:12px;color:#8eabc5}.pricing-card>.button{width:100%;padding-inline:12px}.pricing-includes{font-size:12px;color:#a3bed3;margin:24px 0 0}.pricing-card ul{list-style:none;padding:17px 0 0;margin:0;display:grid;gap:15px;flex:1}.pricing-card li{display:flex;align-items:flex-start;gap:10px;color:#c5d6e6;font-size:13px;line-height:1.9}.pricing-card li>svg{margin-top:4px;color:#67bdf4}.pricing-delivery{display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;margin-top:28px;font-size:13px}.pricing-delivery>span{color:#829fb7}.pricing-delivery .text-link{font-size:13px}.capability-browser{display:grid;grid-template-columns:240px minmax(0,1fr);gap:36px;align-items:start}.capability-index{position:sticky;top:110px;display:grid;gap:6px}.capability-index>a{display:flex;align-items:center;gap:12px;padding:14px;font-size:13px;color:#96b3cc;border-radius:10px;border:1px solid transparent}.capability-index>a>:global(svg:last-child){margin-left:auto;opacity:0}.capability-index>a:hover,.capability-index>a[aria-current]{color:#b8e2ff;background:#13344e;border-color:#3684b233}.capability-index>a[aria-current]>:global(svg:last-child){opacity:1}.capability-content{display:grid;gap:22px}.capability-group{border:1px solid #90bddd22;background:#0d1e30;border-radius:14px;padding:24px 28px;scroll-margin-top:100px}.capability-group-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:10px}.capability-group h3{font-size:19px;margin:0}.capability-group-heading>a{font-size:12px}.capability-group dl{margin:0}.capability-row{display:grid;grid-template-columns:135px minmax(0,1fr);gap:22px;padding:20px 0;border-bottom:1px solid #99bfda1c}.capability-row:last-child{border-bottom:0;padding-bottom:3px}.capability-row dt{font-size:14px;font-weight:500;color:#d8e9f7}.capability-row dd{margin:0}.capability-row p{font-size:14px;color:#bed0e1;margin:0;line-height:1.9}.capability-row dd>span{display:block;font-size:12px;color:#859fb7;line-height:1.8;margin-top:7px}.pricing-questions{display:grid;grid-template-columns:1fr 1.7fr;gap:65px;align-items:start}.pricing-questions h2{font-size:29px;line-height:1.6;margin:0 0 22px}.pricing-closing{padding-bottom:72px}
  @media(max-width:1000px){.pricing-card{padding:25px 22px}.pricing-card h2{font-size:22px}.pricing-description{min-height:110px}.pricing-card-icon{align-items:flex-start;flex-direction:column;gap:10px}.capability-browser{grid-template-columns:210px minmax(0,1fr);gap:23px}.capability-row{grid-template-columns:1fr;gap:8px}.pricing-questions{gap:35px}}
  @media(max-width:760px){.pricing-grid{grid-template-columns:1fr}.pricing-card{padding:28px}.pricing-card-icon{flex-direction:row;align-items:center}.pricing-description{min-height:0}.pricing-card h2{font-size:25px;margin-top:20px}.pricing-quote{margin-top:20px}.pricing-delivery{justify-content:flex-start;gap:14px 22px}.capability-browser{grid-template-columns:1fr}.capability-index{position:static;display:flex;flex-wrap:wrap;gap:8px}.capability-index>a{padding:9px 11px;font-size:12px;border-color:#6695b433;border-radius:99px}.capability-index>a>:global(svg){display:none}.capability-group{padding:22px}.capability-group h3{font-size:18px}.capability-row{padding-block:18px;gap:7px}.pricing-questions{grid-template-columns:1fr;gap:10px}.pricing-questions h2{font-size:25px}.pricing-questions-heading{margin-bottom:12px}.pricing-closing{padding-bottom:46px}.pricing-plans{padding-bottom:45px}}
</style>
<script>
  const browser = document.querySelector('[data-capability-browser]');
  if (browser) {
    const links = [...browser.querySelectorAll<HTMLAnchorElement>('[data-capability-link]')];
    const observer = new IntersectionObserver(entries => {
      const current = entries.find(entry => entry.isIntersecting);
      if (!current) return;
      const id = (current.target as HTMLElement).dataset.capabilityGroup;
      links.forEach(link => {
        if (link.dataset.capabilityLink === id) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    }, { rootMargin: '-18% 0px -58% 0px' });
    browser.querySelectorAll('[data-capability-group]').forEach(group => observer.observe(group));
  }
</script>
