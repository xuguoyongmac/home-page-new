---
import Layout from '../../../layouts/Layout.astro';
import { capabilities } from '../../../features/product';
import { locales } from '../../../lib/site';
const views = import.meta.glob('../../../features/product/*/Page.astro', { eager: true, import: 'default' });
export function getStaticPaths() {
  return locales.flatMap(locale => capabilities.map(entry => ({ params: { locale, capability: entry.slug }, props: { locale, entry } })));
}
const { locale, entry } = Astro.props;
const content = entry.copy[locale];
const Page = views[`../../../features/product/${entry.slug}/Page.astro`] as typeof import('../../../features/product/knowledge/Page.astro').default;
if (!Page) throw new Error(`Missing capability view: ${entry.slug}`);
---
<Layout locale={locale} title={content.name} description={content.description} page={`product/${entry.slug}`}>
  <Page locale={locale}/>
</Layout>
