---
import Layout from '../../layouts/Layout.astro';
import DetailPage from '../../components/DetailPage.astro';
import SolutionsPage from '../../components/SolutionsPage.astro';
import ResourcesPage from '../../components/ResourcesPage.astro';
import FaqPage from '../../components/FaqPage.astro';
import ContactPage from '../../components/ContactPage.astro';
import LegalPage from '../../components/LegalPage.astro';
import ReleaseHistoryPage from '../../components/ReleaseHistoryPage.astro';
import { detailPages } from '../../data/pages';
import { legalContent } from '../../data/legacy';
import type { Locale, DetailPageId } from '../../data/types';

export function getStaticPaths() {
  const pages = ['product','solutions','ecosystem','enterprise','resources','faq','contact','releases','privacy','terms'];
  return ['zh','en'].flatMap(locale => pages.map(page => ({params:{locale,page}})));
}
const locale = Astro.params.locale as Locale;
const page = Astro.params.page as string;
const detail = detailPages[locale][page as DetailPageId];
const otherMeta = {
  zh: {
    resources: {title:'资源中心',description:'TeGo 产品文档、部署资料、客户端、博客与开发资源。'},
    faq: {title:'常见问题',description:'了解 TeGo 的数字员工、团队协作、知识授权、办公成果与企业部署。'},
    contact: {title:'预约产品交流',description:'围绕团队工作、业务系统集成或私有化部署，与 TeGo 团队交流。'},
    download: {title:'下载中心',description:'下载 TeGo OS 桌面端、移动端与 Tego Studio，查看真实版本与发布清单。'},
    releases: {title:'历史版本',description:'查阅 TeGo OS 官方历史发布清单、客户端和服务包，选择对应版本与平台。'},
    privacy: {title:legalContent.zh.privacy.title,description:'TeGo OS 个人信息与数据处理、访问和删除政策。'},
    terms: {title:legalContent.zh.terms.title,description:'TeGo OS 官网与产品服务使用协议。'},
  },
  en: {
    resources: {title:'Resources',description:'Find TeGo documentation, deployment guides, clients, product updates, and developer resources.'},
    faq: {title:'Frequently asked questions',description:'Learn about digital employees, shared projects, knowledge permissions, editable deliverables, and deployment.'},
    contact: {title:'Talk to the TeGo team',description:'Discuss team workflows, business integrations, and private deployment with the TeGo team.'},
    download: {title:'Downloads',description:'Download TeGo OS desktop and mobile clients and Tego Studio, with release versions and manifests.'},
    releases: {title:'Release history',description:'Explore official TeGo OS release manifests, client packages, and server packages by version and platform.'},
    privacy: {title:legalContent.en.privacy.title,description:'How TeGo OS handles personal information, data access, and deletion.'},
    terms: {title:legalContent.en.terms.title,description:'Terms governing the use of the TeGo OS website and services.'},
  },
};
const meta = page === 'solutions' ? (locale === 'zh' ? {title:'行业解决方案',description:'探索证券、银行、保险、政务、央国企、互联网与通用办公的数字员工工作方案，明确输入资料、执行动作、交付成果与实施范围。'} : {title:'Industry solutions',description:'Explore digital employee workflows for securities, banking, insurance, government, state-owned enterprises, internet and general business.'}) : detail || otherMeta[locale][page as keyof typeof otherMeta.zh];
---
<Layout locale={locale} title={meta.title} description={meta.description} page={page}>
  {page === 'solutions' && <SolutionsPage locale={locale}/>}
  {detail && page !== 'solutions' && <DetailPage locale={locale} page={page as DetailPageId}/>}
  {page === 'resources' && <ResourcesPage locale={locale}/>}
  {page === 'faq' && <FaqPage locale={locale}/>}
  {page === 'contact' && <ContactPage locale={locale}/>}
  {page === 'releases' && <ReleaseHistoryPage locale={locale}/>}
  {(page === 'privacy' || page === 'terms') && <LegalPage locale={locale} kind={page}/>}
</Layout>
