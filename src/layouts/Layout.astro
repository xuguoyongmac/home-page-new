---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import '../styles/saaslauncher.css';
import '../styles/product-interface.css';
import '../styles/home-rich.css';
import '../styles/visual-craft.css';
import '../styles/value-home.css';
import '../styles/hero-workspace.css';
import '../styles/business-dashboard.css';
import '../styles/brand-nightblue.css';
import '../styles/hero-landscape.css';
import '../styles/hero-motion.css';
import '../styles/insight-typewriter.css';
import '../styles/render-quality.css';
import '../styles/work-anywhere.css';
import '../styles/hero-luminance.css';
import '../styles/hero-spectrum.css';
import '../styles/hero-space.css';
import '../styles/site-scale.css';
import Brand from '../components/Brand.astro';
import Icon from '../components/Icon.astro';
import { site, pathFor, appFor, nav, ui } from '../lib/site';
import { industries } from '../data/industries';
import type { Locale } from '../data/types';
interface Props { locale: Locale; title: string; description: string; page?: string; noindex?: boolean; }
const { locale, title, description, page = '', noindex = false } = Astro.props;
const zh = locale === 'zh';
const t = ui[locale];
const other = zh ? 'en' : 'zh';
const canonical = new URL(pathFor(locale, page), site.origin).href;
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060b12" />
    <meta name="color-scheme" content="dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{title} · TeGo</title>
    <link rel="icon" href="/images/zhama-symbol_V1.0.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(pathFor('zh', page), site.origin).href} />
    <link rel="alternate" hreflang="en" href={new URL(pathFor('en', page), site.origin).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('zh', page), site.origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · TeGo`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/saaslauncher/team-workspace_V1.2.webp', site.origin).href} />
    <meta property="og:locale" content={zh ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={zh ? 'TeGo 产品博客' : 'TeGo Blog'} href={`/${locale}/blog/rss.xml`} />
  </head>
  <body class:list={{'is-home':page === ''}}>
    {page === '' && <div class="header-scroll-marker" aria-hidden="true"></div>}
    <a class="skip-link" href="#main">{zh ? '跳转到正文' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand-link" href={pathFor(locale)} aria-label={zh ? 'TeGo 数字员工协作平台首页' : 'TeGo home'}><Brand locale={locale}/></a>
        <nav class="desktop-nav" aria-label={zh ? '主导航' : 'Main navigation'}>
          {nav[locale].map(([slug, label]) => slug === 'solutions' ?
            <div class="nav-solutions">
              <a href={pathFor(locale, slug)} aria-current={page.startsWith(slug) ? 'page' : undefined}>{label}</a>
              <button class="nav-expand" aria-label={zh ? '展开解决方案' : 'Expand solutions'} aria-expanded="false" aria-controls="solution-menu"><Icon name="chevron" size={13}/></button>
              <div id="solution-menu" class="solution-menu" inert>
                {industries[locale].map(industry => <a href={pathFor(locale, `solutions/${industry.slug}`)}><Icon name={industry.icon} size={18}/><span>{industry.name}</span><Icon name="arrow" size={14}/></a>)}
              </div>
            </div>
          : <a href={pathFor(locale, slug)} aria-current={page === slug ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-tools">
          <a class="language-link" href={pathFor(other, page)} lang={other} aria-label={zh ? 'Switch to English' : '切换至中文'}><Icon name="globe" size={14}/>{zh ? 'EN' : '中'}</a>
          <a class="button button-small header-cta" href={pathFor(locale, 'contact')}>{t.contact}<Icon name="external" size={13}/></a>
          <button class="menu-toggle icon-button" aria-label={t.menu} aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu"/></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label={zh ? '移动端导航' : 'Mobile navigation'} inert>
        {nav[locale].map(([slug, label]) => <a href={pathFor(locale, slug)}>{label}<Icon name="arrow" size={18}/></a>)}
        {industries[locale].map(industry => <a class="mobile-industry" href={pathFor(locale, `solutions/${industry.slug}`)}>{industry.name}<Icon name="arrow" size={15}/></a>)}
        <a href={pathFor(locale, 'download')}>{t.download}<Icon name="download" size={18}/></a>
        <a href={pathFor(locale, 'contact')}>{t.contact}<Icon name="arrow" size={18}/></a>
      </nav>
    </header>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand"><a href={pathFor(locale)}><Brand locale={locale}/></a><p>{zh ? 'TeGo 数字员工协作平台' : 'TeGo digital workforce collaboration platform.'}</p><a class="text-link" href={`mailto:${site.email}`}>{site.email}<Icon name="external" size={12}/></a></div>
        <div><h2>{zh ? '产品与平台' : 'Platform'}</h2><a href={pathFor(locale,'product')}>{zh ? '产品特性' : 'Product'}</a><a href={pathFor(locale,'ecosystem')}>{zh ? '开放生态' : 'Ecosystem'}</a><a href={pathFor(locale,'enterprise')}>{zh ? '部署方式' : 'Deployment'}</a><a href={appFor(locale)}>{zh ? 'Web 工作空间' : 'Web workspace'}</a></div>
        <div><h2>{zh ? '解决方案' : 'Solutions'}</h2>{industries[locale].map(industry=><a href={pathFor(locale,`solutions/${industry.slug}`)}>{industry.name}</a>)}</div>
        <div><h2>{zh ? '资源与支持' : 'Resources'}</h2><a href={site.docs}>{t.docs}</a><a href={pathFor(locale,'download')}>{t.download}</a><a href={pathFor(locale,'blog')}>{t.blog}</a><a href={pathFor(locale,'faq')}>{t.faq}</a><a href={pathFor(locale,'contact')}>{t.contact}</a></div>
      </div>
      <div class="container footer-bottom"><span>{zh ? '© 2026 深圳市扎马未来科技有限公司' : '© 2026 Shenzhen Zhama Future Technology Co., Ltd.'}</span><a href="https://beian.miit.gov.cn/" rel="external">粤ICP备2025426259号-1</a><div class="footer-legal"><a href={pathFor(locale,'privacy')}>{t.privacy}</a><a href={pathFor(locale,'terms')}>{t.terms}</a></div></div>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>('.is-home .site-header');
      const scrollMarker = document.querySelector<HTMLElement>('.header-scroll-marker');
      if (header && scrollMarker) {
        header.dataset.scrolled = String(window.scrollY > 24);
        const headerObserver = new IntersectionObserver(([entry]) => {
          header.dataset.scrolled = String(!entry.isIntersecting);
        });
        headerObserver.observe(scrollMarker);
      }
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
      const closeMenu = () => { menu?.setAttribute('aria-expanded', 'false'); mobileNav?.classList.remove('is-open'); if (mobileNav) mobileNav.inert = true; };
      menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded', String(open)); mobileNav?.classList.toggle('is-open', open); if (mobileNav) mobileNav.inert = !open; });
      const expand = document.querySelector<HTMLButtonElement>('.nav-expand');
      const dropdown = document.querySelector<HTMLElement>('#solution-menu');
      const closeDropdown = () => { expand?.setAttribute('aria-expanded','false'); if (dropdown) dropdown.inert = true; };
      expand?.addEventListener('click',() => { const open = expand.getAttribute('aria-expanded') !== 'true'; expand.setAttribute('aria-expanded',String(open)); if(dropdown) dropdown.inert = !open; });
      document.addEventListener('click', event => { if(!(event.target as Element).closest('.nav-solutions')) closeDropdown(); });
      document.addEventListener('keydown', event => { if(event.key === 'Escape') { if(menu?.getAttribute('aria-expanded') === 'true'){closeMenu();menu.focus();} if(expand?.getAttribute('aria-expanded') === 'true'){closeDropdown();expand.focus();} } });
      window.matchMedia('(min-width: 1101px)').addEventListener('change', event => { if(event.matches) closeMenu(); else closeDropdown(); });
      document.querySelectorAll<HTMLAnchorElement>('#mobile-nav a').forEach(link => link.addEventListener('click',closeMenu));
      const languageLink = document.querySelector<HTMLAnchorElement>('.language-link');
      if(languageLink) { const destination = new URL(languageLink.href); destination.hash = location.hash; if(location.pathname.endsWith('/releases/')) { const version = new URLSearchParams(location.search).get('version'); if(version) destination.searchParams.set('version',version); } languageLink.href = destination.pathname+destination.search+destination.hash; }
    </script>
  </body>
</html>
