---
import { industries, homeIndustrySlugs } from '../data/industries';
import { homeIndustries } from '../data/home-industries';
import type { Locale } from '../data/types';
import { pathFor } from '../lib/site';
import Icon from './Icon.astro';
import OutcomeExhibit from './pages/OutcomeExhibit.astro';
interface Props { locale: Locale; home?: boolean; }
const { locale, home = false } = Astro.props;
const zh = locale === 'zh';
const visibleIndustries = home ? homeIndustrySlugs.map(slug => industries[locale].find(item => item.slug === slug)!) : industries[locale];
const defaultSlug = home ? homeIndustrySlugs[0] : 'general';
---
<div class:list={["solution-explorer", {"home-solutions":home}]} data-solution-explorer style={`--industry-tab-count: ${visibleIndustries.length}`}>
  <div class="solution-tabs" role="tablist" aria-label={zh ? '行业解决方案' : 'Industry solutions'}>
    {visibleIndustries.map((industry) => <button type="button" role="tab" id={`tab-${industry.slug}`} aria-selected={industry.slug === defaultSlug} aria-controls={`panel-${industry.slug}`} tabindex={industry.slug === defaultSlug ? 0 : -1}><Icon name={industry.icon} size={18}/>{home && zh ? industry.name.replace("解决方案","") : industry.name}</button>)}
  </div>
  {visibleIndustries.map((industry) => (
    <div class="solution-panel" role="tabpanel" id={`panel-${industry.slug}`} aria-labelledby={`tab-${industry.slug}`} tabindex="0" hidden={industry.slug !== defaultSlug}>
      {home ? <>
        <div class="industry-backdrop" aria-hidden="true">
          <img src={`/images/industries/${industry.slug}-background_V1.0.webp`} alt="" width="1536" height="1024" loading="lazy" decoding="async"/>
        </div>
        <div class="industry-intro">
          <h3>{homeIndustries[locale][industry.slug].title}</h3>
        </div>
        <div class="industry-panel-body">
          <div class="solution-copy">
            <section class="industry-copy-block" aria-labelledby={`pain-title-${industry.slug}`}>
              <h4 id={`pain-title-${industry.slug}`}>{zh ? '业务痛点' : 'Business challenges'}</h4>
              <p class="industry-pain">{homeIndustries[locale][industry.slug].pain}</p>
            </section>
            <section class="industry-copy-block" aria-labelledby={`approach-title-${industry.slug}`}>
              <h4 id={`approach-title-${industry.slug}`}>{zh ? '解决方案' : 'Our solution'}</h4>
              <p class="industry-approach">{homeIndustries[locale][industry.slug].value}</p>
              <ul class="industry-scenario-tags" aria-label={zh ? '应用场景' : 'Use cases'}>
                {homeIndustries[locale][industry.slug].scenarios.map(scenario => <li>{scenario}</li>)}
              </ul>
              <a class="industry-details-link" href={pathFor(locale,`solutions/${industry.slug}`)}>{zh ? '了解更多' : 'Learn more'}<Icon name="arrow" size={17}/></a>
            </section>
          </div>
          <section class="industry-benefits" aria-labelledby={`benefits-title-${industry.slug}`}>
            <h4 id={`benefits-title-${industry.slug}`}>{zh ? '业务价值' : 'Business value'}</h4>
            <ul>
              {homeIndustries[locale][industry.slug].benefits.map(benefit => (
                <li>
                  <span class="industry-benefit-check"><Icon name="check" size={18}/></span>
                  <div><h5>{benefit.title}</h5><p>{benefit.description}</p></div>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </> : <>
        <div class="solution-outcome"><OutcomeExhibit locale={locale} compact exhibit={industry.story?.exhibit ?? {title:industry.name,request:industry.description,sources:industry.tasks.map(task=>task.title),columns:zh?['工作','业务动作','交付成果']:['Work','Action','Deliverable'],rows:industry.tasks.map(task=>[task.title,task.action,task.output]),deliverables:[]}}/></div>
        <div class="solution-copy">
          <h3>{industry.title}</h3><p>{industry.description}</p>
          <ul class="task-chips">{industry.tasks.map(task => <li><Icon name="check" size={13}/>{task.title}</li>)}</ul>
          <a class="button button-small" href={pathFor(locale,`solutions/${industry.slug}`)}>{zh ? '查看解决方案' : 'Explore solution'}</a>
        </div>
      </>}
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-solution-explorer]').forEach(explorer=>{
    const tabs = [...explorer.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...explorer.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const tablist = explorer.querySelector<HTMLElement>('[role="tablist"]');
    const animateHome = explorer.classList.contains('home-solutions');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = Math.max(0, tabs.findIndex(tab=>tab.getAttribute('aria-selected')==='true'));
    let panelAnimation: Animation | undefined;
    const positionHighlight = () => {
      if (!animateHome || !tablist) return;
      const tab = tabs[activeIndex];
      tablist.style.setProperty('--industry-tab-left', `${tab.offsetLeft}px`);
      tablist.style.setProperty('--industry-tab-width', `${tab.offsetWidth}px`);
    };
    if (animateHome && tablist) {
      positionHighlight();
      new ResizeObserver(positionHighlight).observe(tablist);
    }
    const select = (tab: HTMLButtonElement, direction?: number) => {
      const nextIndex = tabs.indexOf(tab);
      if (nextIndex === activeIndex) return;
      const slideDirection = direction ?? Math.sign(nextIndex - activeIndex);
      panelAnimation?.cancel();
      activeIndex = nextIndex;
      tabs.forEach(item=>{item.setAttribute('aria-selected',String(item === tab));item.tabIndex=item === tab ? 0 : -1;});
      panels.forEach(panel=>{panel.hidden=panel.id!==tab.getAttribute('aria-controls');});
      positionHighlight();
      const panel = panels.find(item=>!item.hidden);
      if (animateHome && panel && !reducedMotion.matches) {
        panelAnimation = panel.animate([
          { opacity: .35, transform: `translateX(${slideDirection * 28}px)` },
          { opacity: 1, transform: 'translateX(0)' },
        ], { duration: 320, easing: 'cubic-bezier(.22, 1, .36, 1)' });
      }
    };
    tabs.forEach((tab,index)=>{
      tab.addEventListener('click',()=>select(tab));
      tab.addEventListener('keydown',event=>{
        let next:number|undefined;
        if(event.key==='ArrowRight') next=(index+1)%tabs.length;
        if(event.key==='ArrowLeft') next=(index-1+tabs.length)%tabs.length;
        if(event.key==='Home') next=0;
        if(event.key==='End') next=tabs.length-1;
        if(next!==undefined){event.preventDefault();const target=tabs[next];select(target,event.key==='ArrowRight'?1:event.key==='ArrowLeft'?-1:undefined);target.focus();}
      });
    });
  });
</script>
