const activeLabels = labels[scene] || [];
---
<svg class="artwork-labels" data-mode={mode || 'standard'} data-locale={locale} data-label-scene={scene} viewBox={`0 0 ${width} ${height}`} preserveAspectRatio={mode === 'hero' ? 'xMidYMid slice' : 'xMidYMid meet'} aria-hidden="true" focusable="false">
  {activeLabels.map(label => <foreignObject x={width * label.x / 100} y={height * label.y / 100} width={width * label.w / 100} height={height * label.h / 100} style={`--label-size:${width * (label.size || 2.6) / 100}px;--label-pad:${width * 0.35 / 100}px;--label-feather:${width * 0.45 / 100}px`}>
    <div class:list={['label-plate', { 'label-neutral': label.neutral }]}>
      <strong>{locale === 'zh' ? label.zh : label.en}</strong>
      {label.detail && <span>{label.detail[locale === 'zh' ? 0 : 1]}</span>}
    </div>
  </foreignObject>)}
</svg>
<style>
  .artwork-labels{position:absolute;inset:0;display:block;width:100%;height:100%;pointer-events:none;overflow:hidden}
  .artwork-labels foreignObject{overflow:visible}
  .label-plate{box-sizing:border-box;width:100%;height:100%;display:flex;flex-direction:column;justify-content:center;gap:.28em;padding:0 var(--label-pad);background:#161716;box-shadow:0 0 var(--label-feather) var(--label-feather) #161716;border-radius:3px;color:#ecedec;font-family:'Plus Jakarta Sans Variable','PingFang SC','Microsoft YaHei',sans-serif;font-size:var(--label-size);line-height:1.18;text-align:left;overflow:hidden}
  .label-plate strong{display:block;font-size:1em;font-weight:500;line-height:1.18;letter-spacing:0;white-space:nowrap}
  .artwork-labels[data-mode='hero'][data-locale='en'] .label-plate strong{font-size:.93em}
  .label-plate span{display:block;color:#b0b2b1;font-size:.6em;font-weight:400;line-height:1.3;letter-spacing:0;white-space:normal}
  .label-neutral{padding:.4em .55em;background:#161716}
</style>
