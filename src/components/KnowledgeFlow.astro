---
import type { Locale } from '../data/types';
import '../styles/knowledge-flow.css';

interface Props {
  locale: Locale;
  launch?: boolean;
  pageHero?: boolean;
  decorative?: boolean;
  class?: string;
}

const { locale, launch = false, pageHero = false, decorative = false, class: className } = Astro.props;
const copy = {
  zh: {
    label: '资料汇入知识库，数字员工检索并引用原文回答问题',
    alt: '六类文件、装满企业资料的玻璃知识柜与数字员工执行核心。',
    intake: '资料汇入',
    knowledge: '企业知识库',
    employee: '数字员工',
    question: '用户提问',
    questionShort: '提问',
    prompt: 'TeGo 支持内网部署吗？',
    retrieve: '检索资料',
    retrieveShort: '检索',
    cite: '引用原文',
    citeShort: '引用',
    answer: '数字员工回答',
    answerShort: '回答',
    points: '支持企业私有化部署',
    source: '原文出处',
    sourceTitle: '企业部署 · 私有化部署',
    sourceShort: '原文出处',
    steps: ['文档、表格、演示稿、图片与文本汇入企业知识库。', '向数字员工提问：TeGo 支持内网部署吗？', '数字员工检索企业知识库，引用资料原文。', '回答：支持企业私有化部署。原文出处：企业部署页面的私有化部署。'],
  },
  en: {
    label: 'Materials enter the knowledge base; a digital employee retrieves and cites sources in its answer',
    alt: 'Six file types, a glass cabinet filled with company materials and a digital employee execution core.',
    intake: 'Add materials',
    knowledge: 'Knowledge base',
    employee: 'Digital employee',
    question: 'Your question',
    questionShort: 'Question',
    prompt: 'Can TeGo run on our network?',
    retrieve: 'Find sources',
    retrieveShort: 'Find',
    cite: 'Cite original',
    citeShort: 'Cite',
    answer: 'Employee answer',
    answerShort: 'Answer',
    points: 'Yes. Private deployment.',
    source: 'Original source',
    sourceTitle: 'Enterprise deployment',
    sourceShort: 'Source',
    steps: ['Documents, spreadsheets, presentations, images and text enter the company knowledge base.', 'Ask the digital employee whether TeGo can run on your network.', 'The digital employee retrieves company materials and cites the original text.', 'Answer: private deployment is supported. Source: the enterprise deployment page.'],
  },
}[locale];

const fileTypes = [
  { label: 'Word', position: 'word' },
  { label: 'PDF', position: 'pdf' },
  { label: 'Excel', position: 'excel' },
  { label: 'PPT', position: 'ppt' },
  { label: locale === 'zh' ? '图片' : 'Images', position: 'image' },
  { label: locale === 'zh' ? '文本' : 'TXT', position: 'text' },
];
---
<div
  class:list={['product-art', 'semantic-flow', 'knowledge-flow', { 'knowledge-flow-launch': launch, 'knowledge-flow-page-hero': pageHero }, className]}
  data-product-scene="knowledge"
  data-art-kind="illustrated-flow"
  role={decorative ? undefined : 'group'}
  aria-label={decorative ? undefined : copy.label}
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="knowledge-flow-plane">
    <picture class="knowledge-flow-base">
      <source srcset="/artwork/knowledge-flow-base_V1.0.webp" type="image/webp" />
      <img
        src="/artwork/knowledge-flow-base_V1.0.webp"
        width="1536"
        height="1024"
        alt={decorative ? '' : copy.alt}
        loading={launch || pageHero ? 'eager' : 'lazy'}
        fetchpriority={launch || pageHero ? 'high' : undefined}
        decoding="async"
      />
    </picture>

    <div class="knowledge-flow-lines" aria-hidden="true">
      <svg class="knowledge-flow-connections" viewBox="0 0 1536 1024" fill="none" focusable="false">
        <g class="knowledge-flow-intake-lines">
          <path d="M392 340H432M392 540H432M392 740H432" />
          <path class="knowledge-flow-arrow" d="m430 333 11 7-11 7zm0 200 11 7-11 7zm0 200 11 7-11 7z" />
        </g>
        <g class="knowledge-flow-retrieve-line">
          <path d="M1150 477H978" />
          <path class="knowledge-flow-arrow" d="m981 469-14 8 14 8z" />
        </g>
        <g class="knowledge-flow-cite-line">
          <path d="M970 566H1137" />
          <path class="knowledge-flow-arrow" d="m1134 558 14 8-14 8z" />
        </g>
        <g class="knowledge-flow-question-line">
          <path d="M1266 327V397" />
          <path class="knowledge-flow-arrow" d="m1258 393 8 14 8-14z" />
        </g>
        <g class="knowledge-flow-answer-line">
          <path d="M1370 610C1420 650 1420 704 1284 704H1266V724" />
          <path class="knowledge-flow-arrow" d="m1258 720 8 14 8-14z" />
        </g>
      </svg>
    </div>

    <div class="knowledge-flow-labels" aria-hidden="true">
      <div class="knowledge-flow-sources" data-flow-role="sources">
        <span class="knowledge-flow-intake-label">{copy.intake}</span>
        {fileTypes.map(file => <span class:list={['knowledge-flow-file', `knowledge-flow-file-${file.position}`]}>{file.label}</span>)}
      </div>
      <span class="knowledge-flow-object-label knowledge-flow-library-label" data-flow-role="knowledge-base">{copy.knowledge}</span>
      <span class="knowledge-flow-object-label knowledge-flow-employee-label" data-flow-role="employee">{copy.employee}</span>
      <span class="knowledge-flow-relation knowledge-flow-retrieve-label" data-flow-role="retrieval"><span class="knowledge-flow-full-label">{copy.retrieve}</span><span class="knowledge-flow-short-label">{copy.retrieveShort}</span></span>
      <span class="knowledge-flow-relation knowledge-flow-cite-label" data-flow-role="citation"><span class="knowledge-flow-full-label">{copy.cite}</span><span class="knowledge-flow-short-label">{copy.citeShort}</span></span>

      <div class="knowledge-flow-callout knowledge-flow-question" data-flow-role="question">
        <span class="knowledge-flow-callout-title"><span class="knowledge-flow-full-label">{copy.question}</span><span class="knowledge-flow-short-label">{copy.questionShort}</span></span>
        <p class="knowledge-flow-question-text">{copy.prompt}</p>
      </div>

      <div class="knowledge-flow-callout knowledge-flow-answer" data-flow-role="answer">
        <span class="knowledge-flow-callout-title"><span class="knowledge-flow-full-label">{copy.answer}</span><span class="knowledge-flow-short-label">{copy.answerShort}</span></span>
        <strong class="knowledge-flow-answer-text">{copy.points}</strong>
        <span class="knowledge-flow-source">
          <svg viewBox="0 0 20 20" fill="none" focusable="false"><path d="M5 3h7l3 3v11H5V3Z"/><path d="M12 3v4h3M8 10h4M8 13h4"/></svg>
          <span class="knowledge-flow-full-label">{copy.sourceTitle}</span><span class="knowledge-flow-short-label">{copy.sourceShort}</span>
        </span>
      </div>
    </div>
  </div>
  <div class="knowledge-mobile-summary" aria-hidden="true">
    <div><span>{copy.question}</span><p>{copy.prompt}</p></div>
    <div><span>{copy.answerShort}</span><p><strong>{copy.points}</strong><small>{copy.source} · {copy.sourceTitle}</small></p></div>
  </div>
  {!decorative && <ol class="knowledge-flow-accessible">{copy.steps.map(step => <li>{step}</li>)}</ol>}
</div>
