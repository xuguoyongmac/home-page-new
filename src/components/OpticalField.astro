---
interface Props { compact?:boolean; }
const {compact=false}=Astro.props;
const particles=Array.from({length:116},(_,i)=>{const a=i*2.39996;const r=100+((i*79)%430);return {x:760+Math.cos(a)*r,y:430+Math.sin(a)*r*.51,r:i%19===0?1.7:i%7===0?1:.55,o:.1+(i%9)*.055};});
---
<div class:list={['optical-field',{compact}]} aria-hidden="true">
 <svg viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" fill="none">
  <defs><radialGradient id="field-light"><stop stop-color="#c4cbc8" stop-opacity=".22"/><stop offset=".45" stop-color="#788980" stop-opacity=".1"/><stop offset="1" stop-color="#788980" stop-opacity="0"/></radialGradient><linearGradient id="field-rim" x1="320" y1="170" x2="1180" y2="670" gradientUnits="userSpaceOnUse"><stop stop-color="#b6beba" stop-opacity="0"/><stop offset=".4" stop-color="#c5ccc8" stop-opacity=".28"/><stop offset=".57" stop-color="#7d8983" stop-opacity=".09"/><stop offset="1" stop-color="#6d7a74" stop-opacity="0"/></linearGradient></defs>
  <ellipse cx="790" cy="446" rx="590" ry="330" fill="url(#field-light)"/>
  <g transform="rotate(-18 790 425)" stroke="url(#field-rim)"><ellipse cx="790" cy="425" rx="555" ry="212" stroke-width=".65"/><ellipse cx="790" cy="425" rx="529" ry="196" stroke-width=".35"/><ellipse cx="790" cy="425" rx="499" ry="175" stroke-width=".3"/></g>
  <g fill="#d9dddb">{particles.map(p=><circle cx={p.x} cy={p.y} r={p.r} opacity={p.o}/>)}</g>
 </svg>
</div>
