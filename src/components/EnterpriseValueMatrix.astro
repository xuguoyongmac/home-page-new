---
import type { Locale } from '../data/types';
import Icon from './Icon.astro';
import layout from '../data/enterprise-matrix-layout.json';
import '../styles/enterprise-value-matrix.css';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const profiles = [
  { ...layout.nodes[2], className:'employee-profile-primary', description:zh?'依托业务数据，解答经营问题':'Answer business questions with operational data.', icons:['chart','search','file'] },
  { ...layout.nodes[1], className:'employee-profile-secondary', description:zh?'整合业务材料，输出完整方案':'Bring business materials together into complete proposals.', icons:['layers','file','monitor'] },
];
---
<section class="enterprise-value-section value-section" id="work-scenarios" aria-labelledby="domain-title" data-enterprise-value>
  <div class="container matrix-section-layout">
    <header class="value-heading matrix-heading">
      <h2 id="domain-title">{zh ? <>以数字员工，<br/>重塑企业生产力</> : <>Digital employees.<br/>Enterprise productivity.</>}</h2>
      <p>{zh ? '覆盖八大业务场景，把智能能力转化为业务成果，形成可复用的岗位能力矩阵' : 'Turn intelligence into business outcomes across eight scenarios, building a reusable matrix of role capabilities.'}</p>
    </header>
    <div class:list={['value-matrix', { 'value-matrix-en': !zh }]} data-matrix-motion="paused">
      <div class="employee-stack-ground" aria-hidden="true"></div>
      <div class="employee-phone employee-directory" tabindex="0" aria-labelledby="employee-team-title">
        <div class="employee-directory-heading"><Icon name="layers" size={18}/><h3 id="employee-team-title">{zh?'数字员工':'Digital workforce'}</h3></div>
        <ul class="employee-directory-list" aria-label={zh?'八大领域岗位技能':'Roles and skills across eight business domains'}>
          {layout.nodes.map(node=><li><img src={`/images/home/employee-avatar-${node.key}_V1.0.webp`} width="256" height="256" loading="lazy" decoding="async" alt=""/><div><strong>{zh?node.role:node.roleEn}</strong><span>{(zh?node.skills:node.skillsEn).slice(0,2).join(' · ')}</span></div></li>)}
        </ul>
      </div>
      {profiles.map(profile=><div class:list={['employee-phone','employee-profile-card',profile.className]} tabindex="0" aria-labelledby={`employee-role-${profile.key}`}>
        <div class="employee-profile-portrait"><img src={`/images/home/employee-avatar-${profile.key}_V1.0.webp`} width="256" height="256" loading="lazy" decoding="async" alt=""/></div>
        <h3 id={`employee-role-${profile.key}`}>{zh?profile.role:profile.roleEn}</h3>
        <p class="employee-profile-description">{profile.description}</p>
        <div class="employee-skills"><h4>{zh?'技能':'Skills'}</h4><ul>{(zh?profile.skills:profile.skillsEn).map((skill,index)=><li><span><Icon name={profile.icons[index]} size={22}/></span><strong>{skill}</strong></li>)}</ul></div>
      </div>)}
      <button class="matrix-motion-toggle" type="button" data-matrix-toggle aria-label={zh ? '播放动效' : 'Play animation'} data-label-play={zh ? '播放动效' : 'Play animation'} data-label-pause={zh ? '暂停动效' : 'Pause animation'} hidden>
        <svg class="matrix-pause-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="matrix-play-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m8 5 11 7-11 7Z"/></svg>
      </button>
    </div>
  </div>
</section>
<script>
  import { observeMotion } from '../lib/motion';
  const matrix = document.querySelector<HTMLElement>('[data-enterprise-value]');
  if (matrix) {
    const stage = matrix.querySelector<HTMLElement>('[data-matrix-motion]')!;
    const toggle = matrix.querySelector<HTMLButtonElement>('[data-matrix-toggle]')!;
    const playback = observeMotion(stage, state => {
      stage.dataset.matrixMotion = state.running ? 'playing' : 'paused';
      stage.dataset.motionSuspended = String(state.suspended);
      toggle.hidden = state.reduced;
      toggle.setAttribute('aria-pressed', String(state.paused));
      toggle.setAttribute('aria-label', (state.paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause)!);
    });
    toggle.addEventListener('click', () => playback.setPaused(toggle.getAttribute('aria-pressed') !== 'true'));
  }
</script>
