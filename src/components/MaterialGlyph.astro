---
interface Props { name?:string; size?:number; class?:string; }
const {name='network',size=104,class:className}=Astro.props;
const uid=`tg-${crypto.randomUUID()}`;
const shapes:Record<string,string[]>={
 network:['M60 19 91 36 60 54 29 36Z','M29 36v34l31 18 31-18V36','M60 54v34','M29 70 60 52 91 70','M60 19v33','M43 28v33l32 18','M77 28v33L45 79'],
 folder:['M25 49 42 29 88 39 75 83 27 72Z','M21 53 37 34 82 45 69 88 23 78Z','M28 56 41 43 56 46 62 43 94 52 78 91 28 80Z','M28 56v24l50 11','M40 61 78 71M38 67l27 7'],
 layers:['M60 18 97 38 60 59 23 38Z','M23 51 60 72 97 51','M23 64 60 85 97 64','M23 38v9M97 38v9M60 59v8','M23 51v8M97 51v8M60 72v7','M42 28 79 49M79 28 42 49'],
 book:['M60 34C48 19 33 19 22 24v52c13-4 26-1 38 14 12-15 25-18 38-14V24c-11-5-26-5-38 10Z','M60 34v56','M29 23v46c10-1 19 4 25 12','M37 23v40c6 1 12 5 17 11','M91 23v46c-10-1-19 4-25 12','M83 23v40c-6 1-12 5-17 11','M45 26v31M75 26v31'],
 plug:['M39 27C17 38 17 66 39 78l22-13c10-6 10-17 0-23l-8-5','M39 27l21-12c22 12 22 40 0 52L39 79','M82 85c23-13 23-40 1-53L61 45c-10 6-10 17 0 23l8 5','M82 85 61 97c-22-12-22-40 0-52l21-12','M34 38c-10 9-10 21 0 29M87 45c10 9 10 21 0 29'],
 shield:['M60 16 91 29v26c0 20-14 34-31 44-17-10-31-24-31-44V29Z','M60 25 83 35v20c0 15-10 27-23 35-13-8-23-20-23-35V35Z','M60 16v9M29 29l8 6M91 29l-8 6M60 90v9','M48 57l9 9 17-23','M42 40 60 32 78 40'],
 chart:['M27 87V31l17-9v55Z','M51 87V50l17-9v36Z','M75 87V20l17-9v66Z','M27 31l10 6 7-15M51 50l10 6 7-15M75 20l10 6 7-15','M37 37v56M61 56v37M85 26v67','M27 87l10 6 7-16M51 87l10 6 7-16M75 87l10 6 7-16'],
 file:['M35 18 74 24 90 44 85 94 31 83Z','M74 24l-1 21 17-1','M43 48l20 4M42 57l34 7M41 66l28 6','M31 83l-9-6 4-64 42 6','M35 18l-9-5'],
 cpu:['M60 23 93 41 60 60 27 41Z','M27 41v31l33 19 33-19V41','M60 60v31','M60 35 73 42 60 50 47 42Z','M36 28l-9-5M48 21l-9-5M72 21l9-5M84 28l9-5','M27 53l-12-7M27 66l-12-7M93 53l12-7M93 66l12-7','M42 81v11M55 89v11M78 81v11M65 89v11'],
 message:['M60 20c23 0 40 12 40 29S83 79 60 79H36L21 91l4-26C7 40 29 20 60 20Z','M26 41c10-15 45-20 63-4','M43 48h34M43 58h22'],
 terminal:['M26 29 94 38v49L26 78Z','M26 29l9-9 68 9v49l-9 9','M39 47l12 12-12 9M60 72l19 3','M26 40l68 9']
};
const aliases:Record<string,string>={key:'shield',globe:'plug',monitor:'terminal',clock:'chart',sun:'layers',check:'shield',download:'file'};
const key=shapes[name]?name:(aliases[name]||'network');
const paths=shapes[key];
const particles=Array.from({length:37},(_,i)=>{const a=i*2.39996;const r=35+(i*13%23);return{x:60+Math.cos(a)*r,y:58+Math.sin(a)*r*.78,r:i%8===0?.95:.42,opacity:.18+(i%6)*.1};});
---
<svg class:list={['material-glyph',`glyph-${key}`,className]} width={size} height={size} viewBox="0 0 120 120" fill="none" aria-hidden="true">
 <defs>
  <linearGradient id={`${uid}-metal`} x1="24" y1="18" x2="92" y2="97" gradientUnits="userSpaceOnUse"><stop stop-color="#f7f8f8"/><stop offset=".26" stop-color="#bcc4c0"/><stop offset=".5" stop-color="#636866"/><stop offset=".72" stop-color="#d7dcda"/><stop offset="1" stop-color="#535856"/></linearGradient>
  <linearGradient id={`${uid}-glass`} x1="34" y1="15" x2="82" y2="99" gradientUnits="userSpaceOnUse"><stop stop-color="#c1c9c5" stop-opacity=".18"/><stop offset=".5" stop-color="#8f9a94" stop-opacity=".035"/><stop offset="1" stop-color="#7f8e86" stop-opacity=".18"/></linearGradient>
  <radialGradient id={`${uid}-aura`}><stop stop-color="#b0bab5" stop-opacity=".6"/><stop offset=".55" stop-color="#798a82" stop-opacity=".17"/><stop offset="1" stop-color="#798a82" stop-opacity="0"/></radialGradient>
  <filter id={`${uid}-bloom`} x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="3.2"/></filter>
 </defs>
 <ellipse cx="61" cy="70" rx="57" ry="43" fill={`url(#${uid}-aura)`} opacity=".47"/>
 <g stroke="#bec6c2" opacity=".38" filter={`url(#${uid}-bloom)`} stroke-width="2.5">{paths.slice(0,2).map(d=><path d={d}/>)}</g>
 <path d={paths[0]} fill={`url(#${uid}-glass)`}/>
 <g stroke={`url(#${uid}-metal)`} stroke-width="1.05" stroke-linecap="round" stroke-linejoin="round">{paths.map(d=><path d={d}/>)}</g>
 <path d={paths[0]} stroke="#e8ebea" stroke-width=".7" stroke-dasharray="15 130" opacity=".8"/>
 <g fill="#dadedc">{particles.map(p=><circle cx={p.x} cy={p.y} r={p.r} opacity={p.opacity}/>)}</g>
 <circle cx="31" cy="37" r="1.4" fill="#f3f5f4"/><circle cx="31" cy="37" r="4.5" fill="#c0c8c4" opacity=".6" filter={`url(#${uid}-bloom)`}/>
</svg>
