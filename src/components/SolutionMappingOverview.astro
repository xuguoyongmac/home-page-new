---
import type { Locale } from '../data/types';
import type { IndustrySolutionMapping } from '../features/solutions/shared/types';
import Icon from './Icon.astro';
import '../styles/solution-mapping-overview.css';

interface Props { locale: Locale; solution: IndustrySolutionMapping; compact?: boolean; }
const { locale, solution, compact = false } = Astro.props;
const zh = locale === 'zh';
---
<div class:list={['solution-mapping-overview', { 'solution-mapping-overview--compact': compact }]} role="group" aria-label={solution.mappingsTitle}>
  <div class="smo-head" aria-hidden="true">
    <span>{zh ? '业务问题' : 'Challenge'}</span>
    <span>{zh ? '平台能力' : 'Capability'}</span>
    <span>{zh ? '交付成果' : 'Deliverable'}</span>
  </div>
  <ul class="smo-relations">
    {solution.mappings.map(mapping => <li>
      <span class="smo-problem">{mapping.problemTitle}</span>
      <span class="smo-link" aria-hidden="true"><Icon name="arrow" size={20}/></span>
      <span class="smo-capability"><Icon name={mapping.icon} size={22}/><span>{mapping.capabilities[0]}</span></span>
      <span class="smo-link" aria-hidden="true"><Icon name="arrow" size={20}/></span>
      <span class="smo-deliverable"><Icon name="file-check" size={17}/>{mapping.deliverables[0]}</span>
    </li>)}
  </ul>
</div>
