---
import type { Locale } from '../data/types';
import SolutionExplorer from './SolutionExplorer.astro';
import CapabilityEvidence from './pages/CapabilityEvidence.astro';
import '../styles/inner-overview.css';
import CallToAction from './CallToAction.astro';
import { pathFor } from '../lib/site';
interface Props {locale:Locale;}
const {locale}=Astro.props;
const zh=locale==='zh';
const steps=zh?[
 ['选择岗位工作','明确希望处理的资料、任务与成果，从一个具体工作开始。'],
 ['组合平台能力','配置知识、技能与插件，连接获得授权的系统和设备。'],
 ['衔接人工判断','约定需要问询、审批与接手的环节，核对内容与业务依据。'],
 ['形成项目成果','在项目中审阅、修改和定稿，保留文件版本并导出成果。'],
]:[
 ['Choose a task','Define the sources, work and deliverables for a specific role.'],
 ['Configure capabilities','Connect authorized knowledge, skills, plugins and systems.'],
 ['Involve people','Define questions, approvals and review points.'],
 ['Deliver the result','Review, edit and export, with project versions retained.'],
];
---
<div class="inner-overview">
<section class="overview-hero"><div class="container overview-hero-grid"><div class="overview-hero-copy"><h1>{zh?'把行业经验变成数字员工的工作能力':'Turn industry expertise into digital work'}</h1><p>{zh?'从行业真正关心的经营、服务与协作问题出发，把企业知识、岗位方法和业务系统接到具体工作，交付团队能够继续使用的成果。':'Start with the industry’s operating, service and collaboration needs. Connect company knowledge, specialist methods and systems to deliver work your team can use.'}</p><a class="button" href={pathFor(locale,'contact')}>{zh?'预约方案交流':'Discuss your solution'}</a></div><CapabilityEvidence slug="multi-agent" locale={locale}/></div></section>
<section class="sl-section sl-solutions-page"><div class="container"><SolutionExplorer locale={locale}/></div></section>
<section class="sl-section sl-alt"><div class="container"><div class="sl-heading"><h2>{zh?'先明确工作与成果，再组合能力':'Define the result, then combine capabilities'}</h2></div><div class="workflow-strip">{steps.map(([title,body],index)=><article><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
<CallToAction locale={locale}/>

</div>
