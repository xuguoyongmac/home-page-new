---
import Icon from './Icon.astro';
import { appFor, pathFor } from '../lib/site';
import type { Locale } from '../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const channels = [ ['wecom', zh?'企业微信':'WeCom'], ['dingtalk', zh?'钉钉':'DingTalk'], ['feishu', zh?'飞书':'Feishu'], ['qq','QQ'], ['weixin',zh?'微信':'WeChat'] ];
const clients = [ ['monitor','PC'], ['globe','Web'], ['android','Android'], ['ios','iOS'], ['harmonyos',zh?'鸿蒙 Web':'HarmonyOS Web'] ];
const steps = zh ? [
 ['多端输入','电脑、手机、办公消息，随手交办'],
 ['数字员工执行','连接知识与工具，协同完成任务'],
 ['交付工作成果','分析报告、业务表格、汇报材料']
] : [
 ['Assign from anywhere','Desktop, mobile, or your everyday chat'],
 ['Digital employees get to work','Knowledge, tools, and coordinated execution'],
 ['Receive work you can use','Reports, spreadsheets, and presentations']
];
---
<section class="work-anywhere" aria-labelledby="anywhere-title">
 <div class="container">
  <header class="anywhere-heading">
   <h2 id="anywhere-title">{zh?<><span>随时随地，</span><span>把任务交给数字员工</span></>:'Your work moves forward, wherever you are.'}</h2>
  </header>
  <figure class="anywhere-flow">
   <img class="anywhere-flow-art" src="/images/anywhere/multi-entry-workforce_V1.0.webp" width="2172" height="724" alt={zh?'电脑、手机与办公消息汇入数字员工，连接知识和工具，交付分析报告、表格与演示文稿的概念图':'Concept illustration: desktop, mobile and chat connect to a digital employee, which uses knowledge and tools to deliver reports, spreadsheets and presentations.'} loading="lazy" decoding="async"/>
   <figcaption class="anywhere-flow-steps">
    {steps.map(([title,description],index)=><div class:list={['anywhere-flow-step',`anywhere-flow-step-${index}`]}><h3>{title}</h3><p>{description}</p>{index<2&&<Icon name="arrow" size={23}/>}</div>)}
   </figcaption>
  </figure>
  <div class="anywhere-access">
   <div class="anywhere-access-group anywhere-access-clients">
    <div class="anywhere-platform-row" aria-label={zh?'客户端与浏览器入口':'Client and browser access'}>
     {clients.map(([key,label])=><span title={key==='harmonyos'?(zh?'鸿蒙通过浏览器访问':'Browser access on HarmonyOS'):undefined}>{['monitor','globe'].includes(key)?<Icon name={key} size={21}/>:<img src={`/images/platforms/${key}_V1.0.svg`} width="21" height="21" alt="" loading="lazy"/>}<b>{label}</b></span>)}
    </div>
    <div class="anywhere-access-links"><a href={appFor(locale)}>{zh?'打开 Web 工作台':'Open web workspace'}<Icon name="external" size={14}/></a><a href={pathFor(locale,'download')}>{zh?'下载客户端':'Get the apps'}<Icon name="download" size={14}/></a></div>
   </div>
   <div class="anywhere-access-group anywhere-access-channels">
    <div class="anywhere-platform-row" aria-label={zh?'消息渠道与业务系统':'Messaging channels and business systems'}>
     {channels.map(([key,label])=><span><img src={`/images/platforms/${key}_V1.0.svg`} width="22" height="22" alt="" loading="lazy"/><b>{label}</b></span>)}
     <span title={zh?'通过 OpenAPI 对接 OA 与业务系统':'Connect OA and business systems through OpenAPI'}><Icon name="network" size={21}/><b>OA</b></span>
    </div>
    <div class="anywhere-access-links"><span>{zh?'OA 通过 OpenAPI 接入':'OA connects through OpenAPI'}</span><a href={pathFor(locale,'ecosystem')+'#build'}>{zh?'渠道与系统接入':'Channels & integrations'}<Icon name="arrow" size={15}/></a></div>
   </div>
  </div>
 </div>
</section>
