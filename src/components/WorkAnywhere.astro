---
import type { Locale } from '../data/types';
import { renderAnywhereTopology } from '../lib/anywhere-topology';
import '../styles/anywhere-topology.css';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
---
<section class="work-anywhere" aria-labelledby="anywhere-title">
 <div class="container">
  <header class="anywhere-heading">
   <h2 id="anywhere-title">{zh?<><span>随时随地，</span><span>把任务交给数字员工</span></>:'Your work moves forward, wherever you are.'}</h2>
   <p>{zh?'支持 PC、Web、平板、移动端与常用 IM 入口。一句话交办任务，让数字员工协同完成处理，把沟通转成可交付的业务成果。':'Delegate through desktop, web, tablet, mobile, and familiar messaging tools. Digital employees work together to turn each request into a usable business deliverable.'}</p>
  </header>
  <div set:html={renderAnywhereTopology(locale)} />
 </div>
</section>
<script>
 const diagram = document.querySelector<HTMLElement>('.anywhere-topology');
 const flow = diagram?.querySelector<SVGSVGElement>('.topology-links');
 if (diagram && flow) {
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const hero = document.querySelector<HTMLElement>('[data-hero-motion]');
  let visible = false;
  const sync = () => {
   const paused = !visible || document.hidden || preference.matches || hero?.dataset.heroMotion === 'paused';
   diagram.dataset.topologyMotion = paused ? 'paused' : 'running';
   if (paused) flow.pauseAnimations(); else flow.unpauseAnimations();
  };
  flow.pauseAnimations();
  new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(diagram);
  document.addEventListener('visibilitychange', sync);
  preference.addEventListener('change', sync);
  if (hero) new MutationObserver(sync).observe(hero, { attributes:true, attributeFilter:['data-hero-motion'] });
 }
</script>
