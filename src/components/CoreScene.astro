---
import type { Locale } from '../data/types';
import Icon from './Icon.astro';
const { locale, variant } = Astro.props as {locale:Locale;variant:'team'|'collaboration'|'knowledge'|'review'|'deliverables'|'solutions'};
const zh=locale==='zh';
const t=(cn:string,en:string)=>zh?cn:en;
const nav=zh?['项目','资料','知识','员工']:['Projects','Files','Knowledge','Employees'];
const staff=zh?['资料研究','文稿编制','人工审阅']:['Research','Drafting','Human review'];
const steps=zh?['整理研究资料','编制研究简报','确认研究范围']:['Organize research sources','Draft the research brief','Confirm research scope'];
const states=zh?['已完成','进行中','等待']:['Completed','In progress','Waiting'];
const project=t('行业研究项目','Industry research');
const doc=t('行业研究简报（草稿）','Industry research brief (draft)');
const question=t('本期简报是否纳入政策变化？','Should this brief cover policy changes?');
const roles=zh?['研究助理','文稿助理','知识助理']:['Research assistant','Writing assistant','Knowledge assistant'];
const ability=zh?['知识','技能','插件']:['Knowledge','Skills','Plugins'];
const abilityText=zh?['授权的行业资料与研究要求','资料整理 · 简报编制','按业务需要连接工具']:['Authorized sources & requirements','Source review · Brief drafting','Connect tools for the work'];
---
<div class:list={['core-scene', `core-${variant}`]} data-scene-content={variant}>
 {variant==='collaboration' && <>
  <aside class="project-rail"><div class="rail-title">{t('工作空间','Workspace')}</div>{nav.map((item,i)=><div class:list={['rail-item',{'is-selected':i===0}]}><Icon name={['folder','file','book','layers'][i]}/><span>{item}</span></div>)}<div class="rail-caption">{t('项目资料','Project sources')}</div>{[t('行业研究资料','Industry sources'),t('研究框架与要求','Research requirements')].map(s=><div class="rail-source"><Icon name="file"/><span>{s}</span></div>)}<div class="rail-foot"><span class="small-dot"/>TeGo Workspace</div></aside>
  <div class="project-main"><div class="scene-breadcrumb">{t('项目 / 工作台','Projects / Workbench')}</div><h3 class="scene-title">{project}</h3><div class="project-goal"><span class="field-label">{t('项目目标','Project objective')}</span><p>{t('整理行业资料，形成可供团队审阅的研究简报。','Organize industry sources into a brief for team review.')}</p></div><div class="items-heading"><strong>{t('事项','Work items')}</strong><span class="active-tab">{t('我的','Mine')}</span><span>{t('全部','All')}</span></div><div class="work-items">{steps.map((step,i)=><div class:list={['work-item',{'current-item':i===1}]}><span class:list={['item-symbol',`tone-${i}`]}><Icon name={['book','file','message'][i]}/></span><div><strong>{step}</strong><span>{staff[i]}</span></div><span class="item-status">{states[i]}</span></div>)}</div><div class="recent-label">{t('最近成果','Recent deliverables')}<Icon name="arrow"/></div><div class="recent-file"><span class="document-icon"><Icon name="file"/></span><div><strong>{doc}</strong><span>DOCX · {t('版本记录','Version history')}</span></div><Icon name="chevron"/></div></div>
  <aside class="project-inbox"><div class="inbox-heading"><Icon name="message"/>{t('待处理','Inbox')}<span class="inbox-dot"/></div><div class="inquiry-card"><span class="inquiry-state">{t('待我回应','Awaiting my reply')}</span><h4>{question}</h4><p>{t('确认范围后，继续编制简报。','Resume drafting after the scope is confirmed.')}</p><span class="reply-chip">{t('提交回复','Submit reply')}<Icon name="arrow"/></span></div><div class="context-mini"><Icon name="folder"/><span>{project}</span></div><div class="context-mini"><Icon name="file"/><span>{t('研究简报','Research brief')}</span></div></aside>
 </>}
 {variant==='team' && <>
  <div class="scene-wide-heading"><span class="field-label">{t('岗位与能力','ROLES & CAPABILITIES')}</span><h3>{t('面向岗位，配置工作能力','Capabilities for each role')}</h3></div><div class="role-layout"><aside class="role-list">{roles.map((r,i)=><div class:list={['role-option',{'is-selected':i===0}]}><span class="role-symbol"><Icon name={['book','file','layers'][i]}/></span><span>{r}</span>{i===0&&<span class="small-dot"/>}</div>)}</aside><div class="role-detail"><div class="role-detail-head"><span class="role-symbol large"><Icon name="book"/></span><div><span class="field-label">{t('岗位职责','Role responsibilities')}</span><h4>{roles[0]}</h4></div></div><p class="role-description">{t('围绕研究目标整理资料、梳理观点，形成研究初稿。','Organize sources and findings around research objectives, then prepare a draft.')}</p><div class="ability-list">{ability.map((a,i)=><div><Icon name={['book','layers','plug'][i]}/><strong>{a}</strong><span>{abilityText[i]}</span></div>)}</div><div class="role-project"><Icon name="folder"/>{t('进入项目工作','Bring the role into a project')}<Icon name="arrow"/></div></div></div>
 </>}
 {variant==='knowledge' && <>
  <div class="scene-wide-heading"><span class="field-label">{t('知识与引用','KNOWLEDGE & SOURCES')}</span><h3>{t('让工作有据可查','Work grounded in sources')}</h3></div><div class="knowledge-layout"><div class="source-document"><div class="mini-heading"><Icon name="book"/>{t('授权知识','Authorized knowledge')}</div><h4>{t('行业研究框架','Research framework')}</h4><div class="source-section">{t('研究范围','Research scope')}</div><p class="source-extract">{t('研究需覆盖产业链结构、主要参与方与业务变化。','Cover the value chain, key participants and changes in the business.')}</p><div class="source-bottom"><Icon name="file"/>{t('研究框架与要求','Research requirements')}</div></div><div class="citation-bridge"><Icon name="arrow"/><span>{t('引用片段','Citation')}</span></div><div class="cited-document"><div class="mini-heading"><Icon name="file"/>{t('行业研究简报','Industry research brief')}</div><h4>{t('研究范围','Research scope')}</h4><p>{t('从产业链结构出发，梳理主要参与方及业务变化。','Map the value chain, key participants and changes in the business.')}<sup>[1]</sup></p><div class="citation-source"><span>[1]</span><div><strong>{t('行业研究框架','Research framework')}</strong><span>{t('来源对应','Linked to its source')}</span></div><Icon name="book"/></div></div></div>
 </>}
 {variant==='review' && <>
  <div class="scene-wide-heading"><span class="field-label">{t('人机协同','HUMAN–AI COLLABORATION')}</span><h3>{t('需要判断的工作，找到人','Bring people into decisions')}</h3></div><div class="review-layout"><div class="review-context"><span class="field-label">{t('当前事项','Current work item')}</span><h4>{steps[2]}</h4><div class="context-file"><Icon name="folder"/>{project}</div><div class="context-file"><Icon name="file"/>{t('行业研究简报','Industry research brief')}</div><div class="await-position"><Icon name="clock"/><span>{t('收到回应后继续工作','Continue after receiving a reply')}</span></div></div><div class="review-question"><div class="question-top"><span class="question-icon"><Icon name="message"/></span><span class="inquiry-state">{t('待我回应','Awaiting my reply')}</span></div><h4>{question}</h4><p>{t('确认范围后，继续编制简报。','Resume drafting after the scope is confirmed.')}</p><div class="response-area"><Icon name="message"/>{t('回复内容','Response')}</div><span class="reply-chip">{t('提交回复','Submit reply')}<Icon name="arrow"/></span></div></div>
 </>}
 {variant==='deliverables' && <>
  <div class="scene-wide-heading"><span class="field-label">{t('成果与版本','DELIVERABLES & VERSIONS')}</span><h3>{t('从工作稿，到可交付成果','From working draft to delivery')}</h3></div><div class="delivery-layout"><aside class="document-outline"><span>{t('内容','Contents')}</span>{(zh?['研究范围','行业结构','主要观察']:['Research scope','Industry structure','Key observations']).map((s,i)=><div class:list={{selected:i===2}}>{s}</div>)}</aside><div class="delivery-document"><div class="doc-meta"><Icon name="file"/><span>DOCX</span></div><h4>{doc}</h4><strong class="document-subtitle">{t('主要观察','Key observations')}</strong><p>{t('围绕研究目标汇集资料，梳理行业结构与业务变化，保留需要进一步核对的问题。','Bring sources together around the research objective. Map industry structure and changes, retaining questions for further review.')}</p><div class="document-source"><Icon name="book"/>{t('资料引用','Source references')}</div><div class="edit-actions"><span><Icon name="file"/>{t('继续编辑','Keep editing')}</span><span><Icon name="message"/>{t('修改与批注','Edit & annotate')}</span></div></div><aside class="version-list"><span class="field-label">{t('版本历史','Version history')}</span><div class="version-entry active"><span class="small-dot"/><strong>{t('当前版本','Current version')}</strong><span>{t('可继续编辑','Editable')}</span></div><div class="version-entry"><span class="small-dot"/><strong>{t('历史版本','Earlier version')}</strong><span>{t('保留修改记录','Retain revision history')}</span></div><div class="version-publish"><Icon name="layers"/>{t('保存新版本','Save a new version')}</div></aside></div>
 </>}
 {variant==='solutions' && <>
  <div class="scene-wide-heading"><span class="field-label">{t('从业务目标开始','START WITH A BUSINESS OBJECTIVE')}</span><h3>{t('把业务目标，交给岗位团队','Turn objectives into work')}</h3></div><div class="brief-layout"><div class="work-brief"><div class="mini-heading"><Icon name="folder"/>{t('工作委托','Work brief')}</div><h4>{t('行业研究与简报编制','Industry research & drafting')}</h4>{(zh?[['输入资料','研究资料 · 研究框架'],['交付要求','研究简报 · 来源引用'],['人工参与','研究范围确认 · 关键判断审阅']]:[['Source material','Research sources · Framework'],['Delivery requirements','Research brief · Citations'],['Human involvement','Scope confirmation · Judgment review']]).map(([a,b])=><div class="brief-field"><span>{a}</span><strong>{b}</strong></div>)}</div><div class="brief-roles">{staff.map((s,i)=><div class="brief-role"><span class:list={['item-symbol',`tone-${i}`]}><Icon name={['book','file','message'][i]}/></span><div><strong>{s}</strong><span>{i===2?t('关键判断审阅','Review key judgments'):steps[i]}</span></div></div>)}<div class="brief-delivery"><Icon name="file"/><div><strong>{t('行业研究简报','Industry research brief')}</strong><span>{t('可编辑 · 可核对来源','Editable · With source references')}</span></div></div></div></div>
 </>}
</div>
<style>
 .core-scene{color:#f5f7f6;font-size:1.65cqw;line-height:1.5;min-width:0;height:calc(100% - 7.6cqw);text-align:left;letter-spacing:0}.core-scene :is(h3,h4,p){margin:0}.core-scene :global(svg){width:2.3cqw;height:2.3cqw;flex:none}.core-scene strong{font-weight:550}.field-label{font-size:1.35cqw;color:#b3bdb8;letter-spacing:.04em}.small-dot{width:.8cqw;height:.8cqw;background:#b9c2be;border-radius:50%;flex:none}.core-collaboration{display:grid;grid-template-columns:17% 55% 28%}
 .project-rail{padding:3cqw 1.5cqw;background:#1c1e1d;border-right:1px solid #494f4c;position:relative}.rail-title{font-size:1.3cqw;color:#b1bbb6;padding:0 .9cqw 1.7cqw}.rail-item{display:flex;align-items:center;gap:1.1cqw;padding:1.25cqw .9cqw;margin-bottom:.75cqw;color:#c7cecb;border-radius:.8cqw;font-size:1.55cqw}.rail-item.is-selected{background:#71817966;color:#e1e5e3}.rail-caption{font-size:1.3cqw;color:#9eaaa4;margin:4cqw .9cqw 1.2cqw}.rail-source{display:flex;gap:.65cqw;font-size:1.2cqw;color:#c7cecb;padding:1cqw .6cqw;align-items:flex-start}.rail-source :global(svg){width:1.6cqw;height:1.6cqw;margin-top:.2cqw}.rail-foot{position:absolute;bottom:2.3cqw;left:2.4cqw;display:flex;gap:.7cqw;align-items:center;font-size:1cqw;color:#9faaa4}
 .project-main{padding:2.5cqw 2.8cqw;min-width:0}.scene-breadcrumb{font-size:1.2cqw;color:#aab4af;margin-bottom:1.1cqw}.scene-title{font-size:3.45cqw!important;letter-spacing:-.05em!important;font-weight:600;line-height:1.3}.project-goal{margin-top:2.8cqw;padding:1.65cqw 1.8cqw;background:linear-gradient(100deg,#78898035,#32373544);border:1px solid #697870;border-radius:1cqw}.project-goal p{font-size:1.55cqw;line-height:1.7;margin-top:.6cqw;color:#e3e7e5}.items-heading{display:flex;align-items:center;gap:1.8cqw;margin:3cqw 0 1cqw;font-size:1.3cqw;color:#acb6b1}.items-heading strong{font-size:1.7cqw;margin-right:auto;color:#ebedec}.active-tab{background:#4f5a54;padding:.4cqw .9cqw;border-radius:.6cqw;color:#dbe0de}.work-item{display:flex;align-items:center;gap:1.25cqw;padding:1.1cqw .8cqw;border-radius:.8cqw}.work-item.current-item{background:linear-gradient(110deg,#626f68,#474e4a);border:1px solid #97a39d;box-shadow:0 0 2cqw #74847c23}.item-symbol{display:grid;place-items:center;width:4.2cqw;height:4.2cqw;border-radius:1cqw;background:#56615c;color:#ccd2cf;flex:none}.tone-1{background:#65736c;color:#dfe3e1}.tone-2{background:#3e4340;color:#cbd1ce}.work-item>div{display:grid;gap:.35cqw;min-width:0}.work-item strong{font-size:1.6cqw;white-space:nowrap}.work-item>div>span{font-size:1.2cqw;color:#b7bfbb}.item-status{font-size:1.1cqw;color:#d5dad8;margin-left:auto;white-space:nowrap}.recent-label{display:flex;justify-content:space-between;align-items:center;color:#b4beb9;font-size:1.3cqw;margin:2cqw 0 1.1cqw}.recent-label :global(svg){width:1.8cqw;height:1.8cqw}.recent-file{display:flex;align-items:center;gap:1.2cqw;padding:1.5cqw;background:linear-gradient(110deg,#393e3c,#353a38);border:1px solid #718179;border-radius:1cqw}.document-icon{width:4cqw;height:4.4cqw;display:grid;place-items:center;background:#56625c;border-radius:.7cqw;color:#cfd5d2;flex:none}.recent-file>div{display:grid;gap:.35cqw}.recent-file strong{font-size:1.45cqw}.recent-file>div>span{font-size:1.1cqw;color:#b4bdb9}.recent-file>:global(svg){margin-left:auto;color:#9aa7a0}
 .project-inbox{border-left:1px solid #515d57;background:linear-gradient(145deg,#31353388,#242726);padding:3.2cqw 2cqw}.inbox-heading{display:flex;align-items:center;gap:.9cqw;font-size:1.7cqw;font-weight:550}.inbox-dot{width:.65cqw;height:.65cqw;background:#b9c1bd;border-radius:50%;margin-left:auto}.inquiry-card{background:linear-gradient(145deg,#5a6660,#444a47);border:1px solid #a9b3ae;border-radius:1.2cqw;padding:1.8cqw;margin-top:2.5cqw;box-shadow:0 1.5cqw 5cqw #0002}.inquiry-state{font-size:1.15cqw;color:#d7dbd9;background:#8e9c9536;padding:.4cqw .7cqw;border-radius:.5cqw;display:inline-block}.inquiry-card h4{font-size:1.85cqw;line-height:1.7;font-weight:550;margin-top:1.4cqw}.inquiry-card p{font-size:1.3cqw;line-height:1.8;color:#c2c9c5;margin-top:1.3cqw}.reply-chip{display:flex;align-items:center;gap:1cqw;width:fit-content;font-size:1.25cqw;color:#e8eae9;background:#64716a;border:1px solid #9ba7a1;border-radius:.7cqw;padding:.75cqw 1.1cqw;margin-top:2cqw}.reply-chip :global(svg){width:1.6cqw;height:1.6cqw}.context-mini{display:flex;align-items:center;gap:.8cqw;margin-top:2.5cqw;font-size:1.2cqw;color:#a8b3ae}.context-mini+.context-mini{margin-top:1.3cqw}.context-mini :global(svg){width:1.8cqw;height:1.8cqw}
 .scene-wide-heading{padding:3.2cqw 3.7cqw 2.5cqw}.scene-wide-heading h3{font-size:3.1cqw;font-weight:570;letter-spacing:-.04em;margin-top:.7cqw}.core-scene:not(.core-collaboration){background:radial-gradient(ellipse at 75% 20%,#75867e36,transparent 65%)}.role-layout{display:grid;grid-template-columns:30% 1fr;gap:2.3cqw;margin:0 3.5cqw}.role-list{display:grid;align-content:start;gap:1.4cqw}.role-option{display:flex;align-items:center;gap:1.2cqw;padding:1.8cqw 1.5cqw;background:#2e3330;border:1px solid #545f5a;border-radius:1.2cqw;font-size:1.6cqw;color:#c6cdca}.role-option.is-selected{color:#eef0ef;background:#525d58;border-color:#97a49e}.role-symbol{display:grid;place-items:center;width:4.1cqw;height:4.1cqw;background:#5c6962;border-radius:1cqw;color:#c3cac6;flex:none}.role-option .small-dot{margin-left:auto}.role-detail{padding:2.6cqw;background:linear-gradient(135deg,#444a47,#323634);border:1px solid #707f78;border-radius:1.5cqw}.role-detail-head{display:flex;align-items:center;gap:1.7cqw}.role-symbol.large{width:6cqw;height:6cqw;border-radius:1.4cqw}.large :global(svg){width:3.1cqw;height:3.1cqw}.role-detail-head h4{font-size:2.6cqw;margin-top:.4cqw}.role-description{font-size:1.55cqw;line-height:1.8;color:#cfd4d2;margin:2cqw 0!important}.ability-list{display:grid;gap:1cqw}.ability-list>div{display:grid;grid-template-columns:2.5cqw 7cqw 1fr;gap:1cqw;align-items:center;padding:1.2cqw;background:#3f4442;border-radius:.7cqw;font-size:1.4cqw}.ability-list>div>span{font-size:1.25cqw;color:#cad0cd}.ability-list :global(svg){color:#b4bdb8}.role-project{display:flex;align-items:center;gap:1cqw;font-size:1.4cqw;margin-top:2.5cqw;color:#cdd4d0}.role-project>:global(svg:last-child){margin-left:auto}
