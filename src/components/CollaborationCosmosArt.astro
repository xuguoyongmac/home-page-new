---
import type { Locale } from '../data/types';
const { locale } = Astro.props as { locale: Locale };
const zh = locale === 'zh';
const copy = zh ? {
  workspace: '协作工作区', task: '汇集资料，协作形成经营简报',
  research: '资料研究', analysis: '分析整理', writing: '文稿编制',
  knowledge: '企业知识', shared: '共同任务 · 专业分工',
  report: '经营分析简报', review: '待审阅', source: '项目成果',
} : {
  workspace: 'COLLABORATIVE WORKSPACE', task: 'Bring research together. Build the brief.',
  research: 'Research', analysis: 'Analysis', writing: 'Writing',
  knowledge: 'Knowledge', shared: 'SHARED WORK · SPECIALIST ROLES',
  report: 'Business brief', review: 'For review', source: 'PROJECT OUTPUT',
};
---
<div class="launch-workforce-concept" aria-hidden="true">
  <svg viewBox="0 0 820 590" width="820" height="590" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="launch-workforce-surface" x1="150" y1="120" x2="660" y2="470" gradientUnits="userSpaceOnUse">
        <stop stop-color="#343836" stop-opacity=".96"/><stop offset="1" stop-color="#171918" stop-opacity=".96"/>
      </linearGradient>
      <linearGradient id="launch-workforce-edge" x1="100" y1="150" x2="720" y2="490" gradientUnits="userSpaceOnUse">
        <stop stop-color="#ced4d1" stop-opacity=".65"/><stop offset=".45" stop-color="#9eaaa4" stop-opacity=".16"/><stop offset="1" stop-color="#c1c9c5" stop-opacity=".55"/>
      </linearGradient>
      <linearGradient id="launch-workforce-current" x1="120" y1="420" x2="755" y2="345" gradientUnits="userSpaceOnUse">
        <stop stop-color="#93a19a" stop-opacity="0"/><stop offset=".45" stop-color="#b8c1bc" stop-opacity=".8"/><stop offset="1" stop-color="#cad1ce" stop-opacity="0"/>
      </linearGradient>
      <linearGradient id="launch-workforce-page" x1="540" y1="320" x2="750" y2="520" gradientUnits="userSpaceOnUse">
        <stop stop-color="#434a46"/><stop offset="1" stop-color="#202221"/>
      </linearGradient>
      <filter id="launch-workforce-shadow" x="-35%" y="-35%" width="170%" height="180%">
        <feDropShadow dy="16" stdDeviation="22" flood-color="#090909" flood-opacity=".5"/>
      </filter>
      <symbol id="launch-workforce-star" viewBox="0 0 30 30">
        <path d="m15 2 3.3 9.7L28 15l-9.7 3.3L15 28l-3.3-9.7L2 15l9.7-3.3L15 2Z" fill="currentColor"/>
      </symbol>
    </defs>
    <path d="M38 440c110-85 218 48 370-4s217-146 365-106" stroke="url(#launch-workforce-current)" stroke-width="1.4"/>
    <g filter="url(#launch-workforce-shadow)">
      <rect x="127" y="129" width="567" height="340" rx="16" fill="url(#launch-workforce-surface)" stroke="url(#launch-workforce-edge)"/>
      <path d="M163 157h31l-27.6 28h9.5l14.2-14.5 17 21h-10.4l-7.3-10.1-9.2 10.1H149l25.7-26.4h-20.1l4-5.7q1.7-2.4 4.4-2.4Z" fill="#ccd2cf"/>
      <text x="220" y="186" font-size="29" font-weight="650" letter-spacing="-.8" fill="#f6f7f6">TeGo</text>
      <text x="650" y="181" text-anchor="end" font-size={zh ? '16' : '11'} letter-spacing={zh ? '2' : '1'} fill="#b9c2be">{copy.workspace}</text>
      <rect x="160" y="213" width="501" height="52" rx="9" fill="#4f59544d" stroke="#b3bcb822"/>
      <path d="m181 232 6 6-6 6m13-6h11" stroke="#cbd2ce" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <text x="220" y="245" font-size={zh ? '21' : '18'} fill="#ecefee">{copy.task}</text>
      {[{x:161,label:copy.research,tint:'#c3cac6'},{x:330,label:copy.analysis,tint:'#d1d6d3'},{x:499,label:copy.writing,tint:'#8edfcc'}].map((role,index) => <g>
        <rect x={role.x} y="288" width="161" height="112" rx="10" fill="#2a2e2cb3" stroke="#c1c8c426"/>
        <use href="#launch-workforce-star" x={role.x+17} y="303" width="27" height="27" style={`color:${role.tint}`}/>
        <text x={role.x+17} y="359" font-size="20" font-weight="500" fill="#e9eceb">{role.label}</text>
        <path d={`M${role.x+17} 378h${index === 1 ? 87 : 112}`} stroke={role.tint} stroke-opacity=".3" stroke-width="3" stroke-linecap="round"/>
      </g>)}
      <circle cx="166" cy="434" r="3" fill="#c6cdca"/>
      <text x="179" y="440" font-size={zh ? '16' : '12'} letter-spacing="1" fill="#b7c0bc">{copy.shared}</text>
    </g>
    <g transform="rotate(-5 164 111)">
      <rect x="83" y="78" width="173" height="64" rx="12" fill="#2b302ee8" stroke="#bbc4c066"/>
      <path d="M108 97v25m8-25v25m9-22v22" stroke="#c5ccc8" stroke-width="3" stroke-linecap="round"/>
      <text x="143" y="117" font-size="18" fill="#e0e3e2">{copy.knowledge}</text>
    </g>
    <g filter="url(#launch-workforce-shadow)" transform="translate(100 95) scale(.85) rotate(5 647 435)">
      <rect x="537" y="329" width="222" height="219" rx="12" fill="url(#launch-workforce-page)" stroke="#c3cbc77a"/>
      <text x="560" y="361" font-size="11" letter-spacing="1.8" fill="#c5ccc8">{copy.source}</text>
      <text x="560" y="399" font-size="22" font-weight="550" fill="#f0f2f1">{copy.report}</text>
      <path d="M561 423h173m-173 13h148m-148 13h161" stroke="#d7dbd9" stroke-opacity=".25" stroke-width="3" stroke-linecap="round"/>
      <rect x="560" y="476" width={zh ? 78 : 104} height="29" rx="5" fill="#9ba7a126"/>
      <circle cx="572" cy="490" r="3" fill="#d6dbd8"/>
      <text x="582" y="496" font-size="14" fill="#dbdfdd">{copy.review}</text>
    </g>
  </svg>
</div>

<style>
  .launch-workforce-concept{position:absolute;right:-1.5%;top:50%;width:59%;max-width:1000px;transform:translateY(-51%);z-index:-1;pointer-events:none}
  .launch-workforce-concept svg{display:block;width:100%;height:auto;overflow:visible;font-family:inherit}
  @media(min-width:1600px){.launch-workforce-concept{right:0;width:57%}}
  @media(min-width:801px) and (max-width:1100px){.launch-workforce-concept{right:-5%;width:63%}}
  @media(max-width:800px){.launch-workforce-concept{top:auto;bottom:105px;right:-2%;width:89%;max-width:600px;transform:none}}
  @media(max-width:480px){.launch-workforce-concept{bottom:113px;right:-4%;width:108%}}
  @media(max-width:359px){.launch-workforce-concept{bottom:119px;right:-4%;width:108%}}
</style>
