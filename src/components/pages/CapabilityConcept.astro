---
interface Props { slug: string; labels: string[]; title: string; }
const { slug, labels, title } = Astro.props;
const arrow = `concept-arrow-${slug}`;
const zh = /[\u3400-\u9fff]/.test(labels[0] || '');
const specialistTasks = zh ? ['资料检索', '数据提取', '风险梳理'] : ['Research', 'Data Extraction', 'Risk Review'];
---
<svg class="capability-concept-diagram" viewBox="0 0 640 360" role="img" aria-label={title}>
  <defs>
    <marker id={arrow} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1 1 9 5 1 9" fill="none" stroke="currentColor" stroke-width="1.5"/></marker>
  </defs>
  {slug === 'digital-employees' && <>
    <g class="concept-path" stroke-dasharray="5 7"><path d="M210 159H150V92H114"/><path d="M210 207H150V280H114"/><path d="M430 182H486" marker-end={`url(#${arrow})`}/></g>
    <rect class="concept-hub" x="210" y="88" width="220" height="186" rx="18"/>
    <g class="concept-module">{[0,1,2].flatMap(row => [0,1,2].map(col => <rect x={250+col*48} y={119+row*31} width="34" height="20" rx="5"/>))}</g>
    <text class="concept-primary-label" x="320" y="246">{labels[0]}</text>
    <rect class="concept-node" x="34" y="60" width="152" height="62" rx="12"/><text x="110" y="97">{labels[1]}</text>
    <rect class="concept-node" x="34" y="250" width="152" height="62" rx="12"/><text x="110" y="287">{labels[2]}</text>
    <rect class="concept-node" x="480" y="132" width="146" height="100" rx="12"/><path class="concept-symbol" d="M539 157h28v24h-28zM546 149v8m13-8v8m-13 24v7m13-7v7"/><text x="553" y="214">{labels[3]}</text>
  </>}
  {slug === 'multi-agent' && <>
    <rect class="concept-hub" x="226" y="24" width="188" height="58" rx="12"/><text class="concept-primary-label" x="320" y="59">{labels[0]}</text>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M320 82v30H114v31"/><path d="M320 82v61"/><path d="M320 82v30h206v31"/><path d="M114 203v36h206v27"/><path d="M320 203v63"/><path d="M526 203v36H320v27"/></g>
    {[114,320,526].map((x,i) => <g><rect class="concept-node" x={x-79} y="144" width="158" height="59" rx="12"/><text x={x} y="180">{specialistTasks[i]}</text></g>)}
    <text x="446" y="102">{labels[1]}</text>
    <text x="422" y="230">{labels[2]}</text>
    <rect class="concept-hub" x="226" y="268" width="188" height="52" rx="12"/><text class="concept-primary-label" x="320" y="301">{labels[3]}</text>
  </>}
  {slug === 'integrations' && <>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M174 146h35V66h35"/><path d="M396 66h35v80h33"/></g>
    <rect class="concept-node" x="24" y="120" width="150" height="112" rx="12"/><text x="99" y="181">{labels[0]}</text>
    <rect class="concept-hub" x="244" y="34" width="152" height="64" rx="12"/><text class="concept-primary-label" x="320" y="73">{labels[1]}</text>
    <rect class="concept-node" x="464" y="120" width="152" height="112" rx="12"/><text x="540" y="162">{labels[2]}</text><text x="540" y="195">CRM · EHS</text>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M464 218h-35v62h-33"/><path d="M244 280h-33v-62h-37"/><path d="M174 204h22v104h48"/><path d="M396 308h54V204h14"/></g>
    <rect class="concept-hub" x="244" y="260" width="152" height="64" rx="12"/><text class="concept-primary-label" x="320" y="299">{labels[3]}</text>
    <text x="513" y="266">{zh ? '提交任务' : 'Submit Tasks'}</text>
    <text x="513" y="337">{zh ? '返回成果' : 'Return Results'}</text>
  </>}
  {slug === 'collaboration' && <>
    <ellipse class="concept-loop" cx="320" cy="180" rx="223" ry="115"/>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M389 71q58 10 99 37"/><path d="M520 230q-19 29-52 44"/><path d="M251 289q-58-10-99-37"/><path d="M120 130q19-29 52-44"/></g>
    <rect class="concept-hub" x="232" y="135" width="176" height="90" rx="14"/><path class="concept-symbol" d="m293 155 27-12 27 12-27 12-27-12Zm0 14 27 12 27-12m-54 14 27 12 27-12"/><text class="concept-primary-label" x="320" y="213">{labels[3]}</text>
    <rect class="concept-node" x="246" y="38" width="148" height="54" rx="12"/><text x="320" y="71">{labels[0]}</text>
    <rect class="concept-node" x="474" y="153" width="148" height="54" rx="12"/><text x="548" y="186">{labels[1]}</text>
    <rect class="concept-node" x="18" y="153" width="148" height="54" rx="12"/><text x="92" y="186">{labels[2]}</text>
    <circle class="concept-indicator" cx="320" cy="295" r="8"/>
  </>}
  {slug === 'knowledge' && <>
    <rect class="concept-hub" x="223" y="22" width="194" height="64" rx="12"/><text class="concept-primary-label" x="320" y="61">{labels[2]}</text>
    <rect class="concept-node" x="145" y="144" width="350" height="64" rx="12"/><text x="320" y="182">{labels[1]}</text>
    <rect class="concept-hub" x="88" y="266" width="464" height="64" rx="12"/><text class="concept-primary-label" x="320" y="305">{labels[0]}</text>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M236 266v-58"/><path d="M404 266v-58"/><path d="M320 144V86"/><path d="M417 54h160v244h-25"/></g>
    <text class="concept-small-label" x="573" y="188" transform="rotate(90 573 188)">{labels[3]}</text>
    <g class="concept-module"><rect x="112" y="286" width="25" height="23" rx="5"/><rect x="146" y="286" width="25" height="23" rx="5"/><rect x="180" y="286" width="25" height="23" rx="5"/></g>
  </>}
  {slug === 'governance' && <>
    <ellipse class="concept-boundary" cx="320" cy="180" rx="294" ry="155"/><ellipse class="concept-boundary inner" cx="320" cy="180" rx="251" ry="112"/>
    <path class="concept-symbol" d="m320 36 26 10v19c0 16-26 29-26 29s-26-13-26-29V46l26-10Zm-11 25 8 8 14-17"/>
    <g class="concept-path" marker-end={`url(#${arrow})`}><path d="M155 174h74"/><path d="M331 174h67"/><path d="M488 174h51"/></g>
    <rect class="concept-node" x="63" y="144" width="92" height="62" rx="12"/><text x="109" y="181">{labels[0]}</text>
    <rect class="concept-hub" x="229" y="131" width="102" height="86" rx="12"/><text class="concept-primary-label" x="280" y="181">{labels[1]}</text>
    <rect class="concept-node" x="398" y="144" width="90" height="62" rx="12"/><text x="443" y="181">{labels[2]}</text>
    <path class="concept-audit-trail" d="M109 221v31h430v-47"/>
    {[109,194,280,365,450,539].map(x => <circle class="concept-indicator" cx={x} cy="252" r="3"/>)}
    <text class="concept-small-label" x="320" y="284">{labels[3]}</text>
  </>}
</svg>
