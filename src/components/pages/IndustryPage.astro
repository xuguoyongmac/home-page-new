---
import Icon from '../Icon.astro';
import CallToAction from '../CallToAction.astro';
import { industries } from '../../data/industries';
import { pathFor } from '../../lib/site';
import type { Locale } from '../../data/types';
import type { Industry } from '../../features/solutions/types';
interface Props { locale: Locale; industry: Industry; }
const { locale, industry } = Astro.props;
const zh = locale === 'zh';
---

  <section class="page-hero"><div class="inner-page-art" aria-hidden="true"><img src={`/images/saaslauncher/${industry.image}_V1.2.webp`} alt="" width="1024" height="1024"/></div><div class="container inner-hero-content"><div class="inner-hero-copy"><p class="eyebrow">{industry.name}</p><h1>{industry.title}</h1><p>{industry.description}</p><div class="hero-actions"><a class="button" href={pathFor(locale,'contact')}>{zh?'沟通业务需求':'Discuss your requirements'}<Icon name="external" size={14}/></a><a class="text-link" href={pathFor(locale,'solutions')}>{zh?'全部解决方案':'All solutions'}<Icon name="arrow" size={15}/></a></div></div></div></section>
  <section class="detail-section"><div class="container"><nav class="industry-detail-nav" aria-label={zh?'行业方案':'Industry solutions'}>{industries[locale].map(item=><a href={pathFor(locale,`solutions/${item.slug}`)} aria-current={item.slug===industry.slug?'page':undefined}>{item.name}</a>)}</nav><div class="sl-heading"><p class="eyebrow">{zh?'岗位与工作':'ROLES & WORK'}</p><h2>{zh?'围绕实际工作，明确每一份交付':'Define each deliverable around concrete work'}</h2></div><div class="feature-grid">{industry.tasks.map(task=><article class="industry-task-card"><Icon name={industry.icon} size={25}/><h3>{task.title}</h3><dl><dt>{zh?'输入资料':'Sources'}</dt><dd>{task.input}</dd><dt>{zh?'工作内容':'Actions'}</dt><dd>{task.action}</dd><dt>{zh?'交付成果':'Deliverables'}</dt><dd>{task.output}</dd></dl></article>)}</div><div class="industry-scope"><h3>{zh?'建设范围与人工判断':'Implementation scope and human decisions'}</h3><p>{industry.scope}</p></div></div></section>
  <section class="sl-section sl-alt"><div class="container"><div class="detail-intro"><div><p class="eyebrow">{zh?'平台承接':'PLATFORM CAPABILITIES'}</p><h2>{zh?'让岗位工作接入同一个工作空间':'One workspace for the role and its work'}</h2></div><p>{zh?'企业知识提供资料依据，技能承载工作方法，项目保留文件和版本，需要同事判断的环节通过事项流转衔接。':'Knowledge provides sources, skills carry methods, projects retain files and versions, and attention items involve people when decisions are needed.'}</p></div><div class="hero-actions"><a class="button" href={pathFor(locale,'product')}>{zh?'查看产品能力':'Explore the platform'}<Icon name="external" size={14}/></a><a class="text-link" href={pathFor(locale,'enterprise')}>{zh?'了解企业部署':'Enterprise deployment'}<Icon name="arrow" size={15}/></a></div></div></section>
  <CallToAction locale={locale}/>

