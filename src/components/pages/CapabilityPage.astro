---
import type { Locale } from '../../data/types';
import type { CapabilityModule } from '../../features/product/types';
import { pathFor } from '../../lib/site';
import Icon from '../Icon.astro';
import PageHeroArt from '../PageHeroArt.astro';
import CallToAction from '../CallToAction.astro';
interface Props { locale: Locale; capability: CapabilityModule; }
const { locale, capability } = Astro.props;
const copy = capability.copy[locale];
const zh = locale === 'zh';
---
<section class="page-hero inner-page-hero">
  <PageHeroArt variant={capability.slug === 'governance' ? 'enterprise' : 'collaboration'}/>
  <div class="container inner-hero-content"><div class="inner-hero-copy">
    <p class="eyebrow">{copy.name}</p><h1>{copy.title}</h1><p>{copy.description}</p>
    <div class="hero-actions"><a class="button" href={pathFor(locale,'contact')}>{zh ? '预约产品交流' : 'Talk to us'}<Icon name="arrow" size={18}/></a><a class="text-link" href={pathFor(locale,'product')}>{zh ? '全部产品能力' : 'All capabilities'}<Icon name="arrow" size={18}/></a></div>
  </div></div>
</section>
<section class="sl-section"><div class="container"><div class="feature-grid">{copy.features.map(feature => <article class="feature-card"><Icon name={feature.icon} size={28}/><h2>{feature.title}</h2><p>{feature.body}</p></article>)}</div><div class="hero-actions">{copy.related.map(link => <a class="text-link" href={pathFor(locale,link.path)}>{link.label}<Icon name="arrow" size={17}/></a>)}</div></div></section>
<CallToAction locale={locale}/>
<style>.feature-card h2{font-size:22px;margin:22px 0 14px}.feature-card p{color:var(--muted);line-height:1.9}.hero-actions{margin-top:32px}</style>
