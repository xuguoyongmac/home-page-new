---
import Icon from '../Icon.astro';
import Diagram from '../product/CapabilityDiagram.astro';
import type { Locale } from '../../data/types';
import type { CapabilityModule } from '../../features/product/types';
import type { LandingCopy } from '../../features/product/landing-types';
import { productExperiences } from '../../features/product/experiences';
import { pathFor, site } from '../../lib/site';
import '../../styles/enterprise-capability.css';
interface Props { locale: Locale; capability: CapabilityModule; copy: LandingCopy; }
const { locale, capability, copy } = Astro.props;
const zh = locale === 'zh';
const experience = productExperiences[capability.slug][locale];
const breadcrumb = {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
  {'@type':'ListItem',position:1,name:zh?'首页':'Home',item:new URL(pathFor(locale),site.origin).href},
  {'@type':'ListItem',position:2,name:zh?'产品能力':'Product',item:new URL(pathFor(locale,'product'),site.origin).href},
  {'@type':'ListItem',position:3,name:capability.copy[locale].name,item:new URL(pathFor(locale,`product/${capability.slug}`),site.origin).href},
]};
---
<div class="capability-product" data-capability={capability.slug}>
  <section class="cp-hero cp-wrap" aria-labelledby="capability-title">
    <div class="cp-hero-copy"><h1 id="capability-title">{copy.hero.lines.map(line=><span>{line}</span>)}</h1><p>{copy.hero.summary}</p><a class="button" href={pathFor(locale,'contact')}>{zh?'预约产品演示':'Book a product demo'}</a></div>
    <Diagram locale={locale} capability={capability.slug}/>
  </section>
  <div class="cp-stories cp-wrap">
    {experience.sections.map((section,index)=><section class:list={['cp-story',{'cp-story-wide':index===1}]} id={`capability-${section.id}`} aria-labelledby={`capability-${section.id}-title`}>
      <header class="cp-story-heading"><h2 id={`capability-${section.id}-title`}>{section.title}</h2><p>{section.body}</p></header>
      <div class="cp-story-content"><Diagram locale={locale} capability={capability.slug} scene={index}/><dl class="cp-story-points">{section.points.map((point,i)=><div><dt><Icon name={['layers','shield'][i%2]} size={20}/>{point.title}</dt><dd>{point.body}</dd></div>)}</dl></div>
    </section>)}
  </div>
  <section class="cp-feature-section cp-wrap" aria-labelledby="capability-features-title"><h2 id="capability-features-title">{zh ? {integrations:'连接业务，也连接执行与交付',collaboration:'团队协作，覆盖从交办到定稿',knowledge:'企业知识，从资料入库到业务引用',governance:'企业治理，贯穿数字员工全生命周期'}[capability.slug] : {integrations:'Connect business context, execution and delivery',collaboration:'Teamwork from assignment to final delivery',knowledge:'Enterprise knowledge from ingestion to citation',governance:'Govern the digital employee lifecycle'}[capability.slug]}</h2><div class="cp-features">{copy.features.map(feature=><article><Icon name={feature.icon} size={24}/><h3>{feature.title}</h3><p>{feature.body}</p></article>)}</div></section>
</div>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>
