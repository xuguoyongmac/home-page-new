---
import type { Locale } from '../../data/types';
interface Props { slug: string; locale: Locale; }
const { slug, locale } = Astro.props;
const zh = locale === 'zh';
const arrow = `workmap-arrow-${slug}`;
const labels = {
  'digital-employees': zh ? '从岗位模板招募独立数字员工' : 'Recruit independent digital employees from role templates',
  'multi-agent': zh ? '业务目标分派专业子任务，再汇总成果' : 'Delegate specialist tasks and combine their results',
  integrations: zh ? '业务系统通过开放接口提交工作，数字员工调用业务插件与外部工具' : 'Business systems submit work; digital employees use plugins and external tools',
  collaboration: zh ? '业务人员与数字员工围绕项目成果协作、审批和交接' : 'People and digital employees collaborate around project deliverables',
  knowledge: zh ? '检索授权资料，起草回答与文稿，并通过引用回看来源' : 'Retrieve authorized sources, prepare answers and drafts, and review references',
  governance: zh ? '组织身份、资源权限与业务委托分别管理，工作过程留存记录' : 'Manage identity, resource access and delegation, and trace execution',
};
---
<div class:list={['capability-workmap', `workmap-${slug}`]} role="group" aria-label={labels[slug as keyof typeof labels]}>
  {slug === 'digital-employees' && <div class="workmap-role-layout">
    <div class="workmap-template-library">
      <strong class="workmap-library-title">{zh ? '数字员工模板' : 'Role templates'}</strong>
      <div class="workmap-template-row"><strong>{zh ? '标书助理' : 'Bid assistant'}</strong><span>{zh ? '职责 · 技能 · 文件' : 'Role · Skills · Files'}</span></div>
      <div class="workmap-template-row"><strong>{zh ? '合规预审' : 'Compliance review'}</strong><span>{zh ? '职责 · 技能 · 文件' : 'Role · Skills · Files'}</span></div>
    </div>
    <div class="workmap-recruit-paths" aria-hidden="true"><div><span>{zh ? '招募' : 'Recruit'}</span><i>→</i></div><div><span>{zh ? '招募' : 'Recruit'}</span><i>→</i></div></div>
    <div class="workmap-recruited">
      <div class="workmap-node workmap-node-focus"><strong>{zh ? '标书助理' : 'Bid assistant'}</strong><span>{zh ? '独立数字员工' : 'Digital employee'}</span><span class="workmap-workspace">{zh ? '独立工作区' : 'Own workspace'}</span></div>
      <div class="workmap-node workmap-node-focus"><strong>{zh ? '合规预审' : 'Compliance reviewer'}</strong><span>{zh ? '独立数字员工' : 'Digital employee'}</span><span class="workmap-workspace">{zh ? '独立工作区' : 'Own workspace'}</span></div>
    </div>
  </div>}

  {slug === 'multi-agent' && <>
    <svg class="workmap-lines" viewBox="0 0 600 440" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={arrow} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="m2 1 6 4-6 4"/></marker></defs><g marker-end={`url(#${arrow})`}><path d="M300 97v45H100v40"/><path d="M300 97v85"/><path d="M300 97v45h200v40"/><path d="M100 246v49h200v39"/><path d="M300 246v88"/><path d="M500 246v49H300v39"/></g></svg>
    <div class="workmap-node workmap-node-focus workmap-task-goal"><span>{zh ? '业务目标' : 'Business goal'}</span><strong>{zh ? '编制尽调报告' : 'Due diligence report'}</strong></div>
    <div class="workmap-task-specialists">{(zh ? ['资料检索', '数据提取', '风险梳理'] : ['Source research', 'Data extraction', 'Risk analysis']).map(label => <div class="workmap-node"><strong>{label}</strong></div>)}</div>
    <div class="workmap-node workmap-node-focus workmap-task-result"><strong>{zh ? '汇总报告材料' : 'Combined materials'}</strong><span>{zh ? '交由业务人员复核' : 'Business review'}</span></div>
    <span class="workmap-task-label">{zh ? '专业子 Agent 分工' : 'Specialist Agent tasks'}</span>
  </>}

  {slug === 'integrations' && <div class="workmap-integration-layout">
    <div class="workmap-node workmap-business-system"><strong>{zh ? '业务系统' : 'Business system'}</strong></div>
    <div class="workmap-api-path"><strong>OpenAPI</strong><span>{zh ? '任务与材料' : 'Tasks & files'}</span><i>→</i><i>←</i><span>{zh ? '工作成果' : 'Results'}</span></div>
    <div class="workmap-node workmap-node-focus workmap-integration-employee"><strong>{zh ? '数字员工' : 'Digital employee'}</strong></div>
    <div class="workmap-plugin-paths"><div><span>{zh ? 'MCP 调用' : 'MCP calls'}</span><i>→</i></div><div><span>{zh ? '业务工具' : 'Business tools'}</span><i>↔</i></div><div><span>{zh ? '证据与草稿' : 'Evidence & drafts'}</span><i>↔</i></div></div>
    <div class="workmap-integrated-systems"><div class="workmap-node"><strong>{zh ? '外部工具' : 'External tools'}</strong></div><div class="workmap-node"><strong>{zh ? 'CRM 插件' : 'CRM plugin'}</strong></div><div class="workmap-node"><strong>{zh ? 'EHS 插件' : 'EHS plugin'}</strong></div></div>
  </div>}

  {slug === 'collaboration' && <>
    <svg class="workmap-lines" viewBox="0 0 600 440" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={arrow} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="m2 1 6 4-6 4"/></marker></defs><g marker-end={`url(#${arrow})`}><path d="M396 65q104 8 104 110"/><path d="M500 259q-4 116-100 116"/><path d="M204 375Q100 369 100 264"/><path d="M100 180Q105 69 200 65"/></g></svg>
    <div class="workmap-node workmap-collab-top"><strong>{zh ? '问询与审批' : 'Questions & approvals'}</strong></div>
    <div class="workmap-node workmap-collab-person"><strong>{zh ? '业务人员' : 'Colleagues'}</strong></div>
    <div class="workmap-node workmap-collab-employee"><strong>{zh ? '数字员工' : 'Digital employee'}</strong></div>
    <div class="workmap-node workmap-collab-bottom"><strong>{zh ? '修改与交接' : 'Revision & handoff'}</strong></div>
    <div class="workmap-node workmap-node-focus workmap-collab-result"><strong>{zh ? '项目成果' : 'Project deliverables'}</strong><span>{zh ? '文件与版本' : 'Files & versions'}</span></div>
  </>}

  {slug === 'knowledge' && <>
    <svg class="workmap-lines" viewBox="0 0 600 440" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={arrow} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="m2 1 6 4-6 4"/></marker></defs><g marker-end={`url(#${arrow})`}><path d="M300 180V111"/><path d="M112 343v-46h188v-47"/><path d="M300 343v-93"/><path d="M488 343v-46H300v-47"/><path class="workmap-citation-line" d="M201 73H32v308h25"/></g></svg>
    <div class="workmap-node workmap-node-focus workmap-knowledge-output"><strong>{zh ? '回答与文稿' : 'Answers & drafts'}</strong></div>
    <div class="workmap-node workmap-knowledge-employee"><strong>{zh ? '数字员工' : 'Digital employee'}</strong></div>
    <div class="workmap-knowledge-sources">{(zh ? ['企业制度', '历史方案', '项目资料'] : ['Company policies', 'Past proposals', 'Project files']).map(label => <div class="workmap-node"><strong>{label}</strong></div>)}</div>
    <span class="workmap-knowledge-retrieve">{zh ? '检索授权资料' : 'Retrieve authorized sources'}</span>
    <span class="workmap-knowledge-draft">{zh ? '结合资料起草' : 'Draft with evidence'}</span>
    <span class="workmap-knowledge-citation">{zh ? '引用溯源' : 'Source links'}</span>
  </>}

  {slug === 'governance' && <>
    <div class="workmap-access-boundary" aria-hidden="true"></div>
    <svg class="workmap-lines" viewBox="0 0 600 440" preserveAspectRatio="none" aria-hidden="true"><defs><marker id={arrow} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="m2 1 6 4-6 4"/></marker></defs><g marker-end={`url(#${arrow})`}><path d="M244 74H98v91"/><path d="M190 209h44"/><path d="M410 209h-44"/><path d="M300 247v47H190v45"/><path d="M505 247v92"/></g></svg>
    <div class="workmap-node workmap-governance-identity"><strong>{zh ? '人员身份' : 'User identity'}</strong></div>
    <div class="workmap-node workmap-governance-permissions"><strong>{zh ? '知识与项目权限' : 'Knowledge & project access'}</strong></div>
    <div class="workmap-node workmap-node-focus workmap-governance-employee"><strong>{zh ? '数字员工' : 'Digital employee'}</strong></div>
    <div class="workmap-node workmap-governance-delegation"><strong>{zh ? '插件工作委托' : 'Plugin delegation'}</strong></div>
    <div class="workmap-node workmap-governance-execution"><strong>{zh ? '执行记录' : 'Execution records'}</strong></div>
    <div class="workmap-node workmap-governance-history"><strong>{zh ? '授权变更记录' : 'Authorization history'}</strong></div>
  </>}
</div>
