---
import CapabilityEvidence from './CapabilityEvidence.astro';
import type { Locale } from '../../data/types';
import type { CapabilityModule } from '../../features/product/types';
import type { LandingCopy } from '../../features/product/landing-types';
import { capabilities } from '../../features/product';
import { pathFor, site, appFor } from '../../lib/site';
import '../../styles/capability-landing.css';

interface Props { locale: Locale; capability: CapabilityModule; copy: LandingCopy; }
const { locale, capability, copy } = Astro.props;
const zh = locale === 'zh';
const name = capability.copy[locale].name;
const resource = capability.copy[locale].related.find(item => item.path !== 'product');
const related = copy.related.map(slug => capabilities.find(item => item.slug === slug)).filter((item): item is CapabilityModule => Boolean(item));
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: zh ? '首页' : 'Home', item: new URL(pathFor(locale), site.origin).href },
    { '@type': 'ListItem', position: 2, name: zh ? '产品能力' : 'Product', item: new URL(pathFor(locale, 'product'), site.origin).href },
    { '@type': 'ListItem', position: 3, name, item: new URL(pathFor(locale, `product/${capability.slug}`), site.origin).href },
  ],
};
---
<div class="capability-landing" data-capability={capability.slug}>
  <section class="capability-hero" aria-labelledby="capability-title">
    <div class="container capability-hero-inner">
      <div class="capability-hero-grid">
        <div class="capability-hero-copy">
          <h1 id="capability-title">{copy.hero.lines.map((line, index) => <span class:list={{ 'capability-title-accent': index === copy.hero.lines.length - 1 }}>{line}</span>)}</h1>
          <p>{copy.hero.summary}</p>
          <div class="capability-actions">
            <a class="capability-button" href={pathFor(locale, 'contact')}>{zh ? '预约产品演示' : 'Book a product demo'}</a>
          </div>
        </div>
        <CapabilityEvidence slug={capability.slug} locale={locale}/>
      </div>
    </div>
  </section>

  <section class="capability-pain" aria-labelledby="capability-pain-title">
    <div class="container capability-pain-grid">
      <h2 id="capability-pain-title">{copy.pain.title}</h2>
      <ul>{copy.pain.items.map(item => <li><p>{item}</p></li>)}</ul>
    </div>
  </section>

  <section class="capability-concept" id="capability-concept" aria-labelledby="capability-concept-title">
    <div class="container capability-method">
      <div class="capability-concept-copy"><h2 id="capability-concept-title">{copy.concept.title}</h2><p>{copy.concept.body}</p></div>
      <ol class="capability-method-steps" aria-label={zh ? '能力关系' : 'How it works'}>{copy.concept.labels.map(label => <li>{label}</li>)}</ol>
    </div>
  </section>

  <section class="capability-section capability-features" aria-labelledby="capability-features-title">
    <div class="container capability-content-layout">
      <h2 class="capability-section-title" id="capability-features-title">{zh ? '核心能力' : 'Core capabilities'}</h2>
      <div class="capability-feature-list">{copy.features.map(feature => <article class="capability-feature-row">
        <h3>{feature.title}</h3><p>{feature.body}</p>
      </article>)}</div>
    </div>
  </section>

  <section class="capability-section capability-scenarios" id="capability-scenarios" aria-labelledby="capability-scenarios-title">
    <div class="container capability-content-layout">
      <h2 class="capability-section-title" id="capability-scenarios-title">{zh ? '业务场景' : 'Business scenarios'}</h2>
      <div class="capability-scenario-list">{copy.scenarios.map(scenario => <article class="capability-scenario-row">
        <h3>{scenario.title}</h3>
        <div class="capability-scenario-detail"><p>{scenario.body}</p>
          <ol class="capability-scenario-flow" aria-label={zh ? '工作流程' : 'Workflow'}>{scenario.flow.map(step => <li>{step}</li>)}</ol>
        </div>
      </article>)}</div>
    </div>
  </section>

  <section class="capability-section capability-benefits" aria-labelledby="capability-benefits-title">
    <div class="container capability-benefits-layout">
      <h2 class="capability-section-title" id="capability-benefits-title">{zh ? '让能力成为团队的日常' : 'Make capability part of everyday work'}</h2>
      <div class="capability-benefit-grid">{copy.benefits.map(benefit => <article><h3>{benefit.title}</h3><p>{benefit.body}</p></article>)}</div>
    </div>
  </section>

  <section class="capability-section capability-related" aria-labelledby="capability-related-title">
    <div class="container capability-content-layout">
      <h2 class="capability-section-title" id="capability-related-title">{zh ? '连接更多产品能力' : 'Connect more capabilities'}</h2>
      <div class="capability-related-links">{related.map(item => <a class="capability-related-link" href={pathFor(locale, `product/${item.slug}`)}><h3>{item.copy[locale].name}</h3></a>)}</div>
    </div>
  </section>

  <section class="capability-closing" aria-labelledby="capability-closing-title">
    <div class="container capability-closing-inner"><h2 id="capability-closing-title">{copy.closing}</h2><div class="capability-actions"><a class="capability-button" href={appFor(locale)}>{zh ? '开始使用' : 'Get started'}</a><a class="capability-inline-link" href={resource ? pathFor(locale, resource.path) : site.docs} rel={resource ? undefined : 'external'}>{resource ? resource.label : zh ? '阅读产品文档' : 'Read the docs'}</a></div></div>
  </section>
</div>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>
