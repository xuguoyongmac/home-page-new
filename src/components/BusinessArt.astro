---
interface Props {
  locale: 'zh' | 'en';
  variant: 'knowledge' | 'review' | 'deliverables' | 'clients' | 'resources' | 'journal';
  idPrefix: string;
  class?: string;
}

const { locale, variant, idPrefix, class: className } = Astro.props;
const en = locale === 'en';
const id = (name: string) => `${idPrefix}-${name}`;
const paint = (name: string) => `url(#${id(name)})`;
const icon = (name: string) => `#${id(name)}`;
const labels = {
  knowledge: en ? 'Original research materials and citations carried through into a shared research deliverable' : '原文资料与引用依据贯穿共同的研究成果',
  review: en ? 'Human judgement at the intersection of team collaboration, with work continuing toward a shared deliverable' : '人的判断连接团队协作路径，工作继续走向共同成果',
  deliverables: en ? 'A deliverable built from shared objectives, source evidence, colleague review and version history' : '工作目标、资料依据、同事审阅与成果版本汇聚为可核对交付',
  clients: en ? 'People and digital employees working on the same task across different work entry points' : '人与数字员工通过不同工作入口围绕同一事项协作',
  resources: en ? 'An open book connecting user guides, reference material and layers of knowledge' : '开放的书页连接操作手册、参考资料与知识层次',
  journal: en ? 'Role-specific practice refined into shared and reusable working methods' : '岗位实践经过提炼与沉淀，形成可复用的工作方法',
};
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 760" preserveAspectRatio="xMidYMid meet" role="img" aria-label={labels[variant]} class:list={['business-art', `business-art-${variant}`, className]}>
  <defs>
    <linearGradient id={id('glass')} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#484e4b" stop-opacity=".94"/>
      <stop offset=".34" stop-color="#2d312f" stop-opacity=".91"/>
      <stop offset="1" stop-color="#161817" stop-opacity=".97"/>
    </linearGradient>
    <linearGradient id={id('deep-glass')} x1="0" y1="0" x2=".8" y2="1">
      <stop stop-color="#353b38" stop-opacity=".9"/>
      <stop offset=".48" stop-color="#222624" stop-opacity=".94"/>
      <stop offset="1" stop-color="#121413" stop-opacity=".98"/>
    </linearGradient>
    <linearGradient id={id('edge')} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#d6dbd8" stop-opacity=".69"/>
      <stop offset=".4" stop-color="#99a59f" stop-opacity=".19"/>
      <stop offset="1" stop-color="#97a39d" stop-opacity=".49"/>
    </linearGradient>
    <linearGradient id={id('side')} x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="#111212"/>
      <stop offset=".5" stop-color="#434a46"/>
      <stop offset="1" stop-color="#1d1f1e"/>
    </linearGradient>
    <linearGradient id={id('blue')} x1="0" y1="0" x2=".8" y2="1">
      <stop stop-color="#c7cdca"/>
      <stop offset=".4" stop-color="#a0aba6"/>
      <stop offset="1" stop-color="#85938c"/>
    </linearGradient>
    <linearGradient id={id('cyan')} x1="0" y1="0" x2=".8" y2="1">
      <stop stop-color="#e5e8e6"/>
      <stop offset=".45" stop-color="#a7b1ac"/>
      <stop offset="1" stop-color="#85938c"/>
    </linearGradient>
    <linearGradient id={id('beam')} x1="0" y1="0" x2="1" y2="0">
      <stop stop-color="#8f9d96" stop-opacity=".1"/>
      <stop offset=".4" stop-color="#a6b0ab" stop-opacity=".75"/>
      <stop offset=".8" stop-color="#b9c1bd"/>
      <stop offset="1" stop-color="#9da9a3" stop-opacity=".6"/>
    </linearGradient>
    <linearGradient id={id('veil')} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#d7dcda" stop-opacity=".09"/>
      <stop offset=".55" stop-color="#b7c0bb" stop-opacity=".02"/>
      <stop offset="1" stop-color="#93a19a" stop-opacity=".08"/>
    </linearGradient>
    <radialGradient id={id('halo')}>
      <stop stop-color="#778880" stop-opacity=".19"/>
      <stop offset=".56" stop-color="#65726b" stop-opacity=".06"/>
      <stop offset="1" stop-color="#65726b" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id={id('sphere')} cx=".3" cy=".23" r=".9">
      <stop stop-color="#e0e4e2"/>
      <stop offset=".4" stop-color="#afb9b4"/>
      <stop offset="1" stop-color="#74857d"/>
    </radialGradient>
    <radialGradient id={id('node')}>
      <stop stop-color="#dadfdc" stop-opacity=".18"/>
      <stop offset="1" stop-color="#404643" stop-opacity=".08"/>
    </radialGradient>
    <filter id={id('shadow')} x="-35%" y="-35%" width="170%" height="190%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="21" stdDeviation="19" flood-color="#060706" flood-opacity=".57"/>
      <feDropShadow dx="0" dy="3" stdDeviation="3" flood-color="#0a0a0a" flood-opacity=".45"/>
    </filter>
    <filter id={id('float')} x="-35%" y="-35%" width="170%" height="190%" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="11" stdDeviation="11" flood-color="#060706" flood-opacity=".5"/>
    </filter>
    <filter id={id('glow')} x="-100%" y="-100%" width="300%" height="300%" color-interpolation-filters="sRGB">
      <feGaussianBlur stdDeviation="5"/>
    </filter>
    <symbol id={id('person')} viewBox="0 0 100 120">
      <circle cx="50" cy="29" r="22" fill="currentColor"/>
      <path d="M8 110c2-35 16-53 42-53s40 18 42 53Z" fill="currentColor" fill-opacity=".68"/>
      <path d="M16 110h68" fill="none" stroke="currentColor" stroke-opacity=".7" stroke-width="2"/>
    </symbol>
    <symbol id={id('employee')} viewBox="0 0 100 100">
      <path d="M50 6c5 25 19 39 44 44-25 5-39 19-44 44C45 69 31 55 6 50 31 45 45 31 50 6Z" fill="currentColor" fill-opacity=".82"/>
      <path d="m50 26 24 24-24 24-24-24Z" fill="none" stroke="#f0f2f1" stroke-opacity=".76" stroke-width="1.4"/>
    </symbol>
    <symbol id={id('folio')} viewBox="0 0 100 130">
      <path d="M8 2h61l23 24v94a8 8 0 0 1-8 8H8a6 6 0 0 1-6-6V8a6 6 0 0 1 6-6Z" fill="currentColor" fill-opacity=".1" stroke="currentColor" stroke-width="2"/>
      <path d="M69 3v22h22M20 55h51M20 74h51M20 93h35" fill="none" stroke="currentColor" stroke-opacity=".65" stroke-width="3" stroke-linecap="round"/>
    </symbol>
    <symbol id={id('quote')} viewBox="0 0 70 54">
      <path d="M3 48V28C3 11 12 4 28 3v10c-8 1-12 5-12 12h13v23Zm37 0V28C40 11 49 4 65 3v10c-8 1-12 5-12 12h13v23Z" fill="currentColor"/>
    </symbol>
  </defs>

  <ellipse cx="505" cy="399" rx="425" ry="284" fill={paint('halo')}/>

  {variant === 'knowledge' && (
    <g>
      <path d="M195 359c115-139 271-120 493-23M254 453c139-61 270-42 437-83M354 274c108 17 217 17 333 64" class="light-path" stroke={paint('beam')} stroke-width="12" opacity=".22" filter={paint('glow')}/>
      <g transform="translate(116 245) rotate(-12 105 167)" filter={paint('shadow')}>
        <path d="m0 15 14-11h188l12 12v305l-14 14H0Z" fill={paint('side')} stroke={paint('edge')} stroke-width="1.5"/>
        <path d="M14 4h162l38 39v278H14Z" fill={paint('deep-glass')} stroke={paint('edge')} stroke-width="1.4"/>
