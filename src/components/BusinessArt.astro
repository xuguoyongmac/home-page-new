        <path d="M25 113h148M25 137h128M25 161h140M25 219h111" class="source-trace"/>
        <path d="M23 188h151" stroke="#b0b9b4" stroke-width="7" stroke-linecap="round" stroke-opacity=".65"/>
      </g>
      <path d="M287 418c144-39 254-35 423-51M403 411c93-53 193-48 303-57M490 476c78-7 126-48 220-94" class="light-path" stroke={paint('beam')} stroke-width="2.5"/>
      <path d="M526 385c72-21 111-24 180-23" class="light-path" stroke="#cdd3d0" stroke-width="6" opacity=".48" filter={paint('glow')}/>
      <g transform="translate(615 173) rotate(5 124 200)" filter={paint('shadow')}>
        <path d="M9 12h230l14 14v367l-12 15H9Z" fill={paint('side')} stroke={paint('edge')} stroke-width="1.5"/>
        <path d="M0 0h205l48 48v345H0Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.8"/>
        <path d="M205 1v47h47" fill="#4f5753" stroke="#c1c8c4" stroke-opacity=".45"/>
        <text x="27" y="94" class="label">{en ? 'Research output' : '研究成果'}</text>
        <path d="M28 131h181M28 154h154" class="source-trace"/>
        <path d="M0 190h253v83H0Z" fill="#87968e" fill-opacity=".1"/>
        <path d="M0 191h253M0 272h253" stroke="#aab5b0" stroke-opacity=".3" stroke-width="1.2"/>
        <use href={icon('quote')} x="28" y="211" width="47" height="36" color="#b9c2be"/>
        <path d="M95 223h124M95 242h105" stroke="#b8c1bc" stroke-opacity=".68" stroke-width="4" stroke-linecap="round"/>
        <path d="M28 316h181M28 339h148M28 362h165" class="source-trace"/>
        <path d="M0 0h204L49 393H0Z" fill={paint('veil')}/>
      </g>
      <circle cx="616" cy="366" r="5" fill="#d8dcda"/>
      <circle cx="616" cy="366" r="15" fill="none" stroke="#c0c8c4" stroke-opacity=".35"/>
    </g>
  )}

  {variant === 'review' && (
    <g>
      <path d="M190 249c168-23 167 139 306 130s158-75 291-29M194 531c140 7 177-123 305-152s189 113 286-28M243 393c90-60 162-32 257-15" class="light-path" stroke="#697870" stroke-opacity=".24" stroke-width="11" filter={paint('glow')}/>
      <path d="M190 249c168-23 167 139 306 130s158-75 291-29M194 531c140 7 177-123 305-152s189 113 286-28" class="light-path" stroke={paint('beam')} stroke-width="2"/>
      <path d="M501 379c102-12 172-42 285-28" class="light-path" stroke="#b8c1bc" stroke-opacity=".73" stroke-width="3"/>
      <g transform="translate(185 247)" filter={paint('float')}>
        <ellipse rx="70" ry="71" fill={paint('deep-glass')} stroke={paint('edge')} stroke-width="1.7"/>
        <ellipse cx="-5" cy="-5" rx="59" ry="60" fill={paint('node')} stroke="#b7bfbb" stroke-opacity=".18"/>
        <use href={icon('person')} x="-34" y="-46" width="68" height="82" color="#b0b9b4"/>
      </g>
      <text x="185" y="354" text-anchor="middle" class="label muted">{en ? 'Colleagues' : '同事协作'}</text>
      <g transform="translate(198 528)" filter={paint('float')}>
        <ellipse rx="66" ry="67" fill={paint('deep-glass')} stroke={paint('edge')} stroke-width="1.7"/>
        <ellipse cx="-5" cy="-5" rx="55" ry="56" fill={paint('node')} stroke="#b7bfbb" stroke-opacity=".18"/>
        <use href={icon('employee')} x="-37" y="-37" width="74" height="74" color="#a3aea8"/>
      </g>
      <text x="198" y="630" text-anchor="middle" class="label muted">{en ? 'Digital employee' : '数字员工'}</text>
      <g filter={paint('shadow')}>
        <ellipse cx="499" cy="399" rx="146" ry="109" fill="#1c1f1e" fill-opacity=".7" stroke={paint('edge')} stroke-width="1.5" transform="rotate(-19 499 399)"/>
        <ellipse cx="499" cy="399" rx="126" ry="91" fill={paint('node')} stroke="#a1ada7" stroke-opacity=".22" transform="rotate(-19 499 399)"/>
        <path d="M420 432c5-63 31-91 80-91s75 28 80 91l-8 30H428Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.7"/>
        <path d="M438 432c6-47 24-67 62-67s56 20 62 67" fill={paint('blue')} fill-opacity=".7"/>
        <circle cx="500" cy="280" r="47" fill={paint('sphere')} stroke="#d2d8d5" stroke-opacity=".8" stroke-width="1.3"/>
        <path d="M421 432c49 25 106 25 158 0" fill="none" stroke="#c1c8c4" stroke-opacity=".5" stroke-width="1.7"/>
      </g>
      <text x="500" y="165" text-anchor="middle" class="headline">{en ? 'Human judgement' : '人的判断'}</text>
      <g transform="translate(726 267) rotate(9 68 115)" filter={paint('shadow')}>
        <path d="M-13 15H96l34 33v193H-13Z" fill={paint('deep-glass')} stroke={paint('edge')}/>
        <path d="M0 0h109l34 34v193H0Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.6"/>
        <path d="M109 1v33h33" fill="#505854" stroke="#b0bab5" stroke-opacity=".35"/>
