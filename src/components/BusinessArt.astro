        <path d="M23 159h98" stroke="#b2bcb7" stroke-opacity=".6" stroke-width="6" stroke-linecap="round"/>
      </g>
      <text x="794" y="568" text-anchor="middle" class="label">{en ? 'Work continues' : '继续协作'}</text>
      <circle cx="631" cy="357" r="5" fill="#c9cfcc"/>
      <circle cx="350" cy="419" r="4" fill="#9faba5"/>
      <circle cx="340" cy="325" r="4" fill="#9faba5"/>
    </g>
  )}

  {variant === 'deliverables' && (
    <g>
      <g opacity=".73" filter={paint('shadow')}>
        <path d="m226 166 420-64 190 114-420 66Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.6"/>
        <path d="m226 166 190 116v16L226 182ZM416 282l420-66v17l-420 65Z" fill={paint('side')} stroke="#6c7671" stroke-opacity=".35"/>
        <text x="343" y="177" class="label" transform="rotate(-9 343 177)">{en ? 'Shared objective' : '工作目标'}</text>
        <ellipse cx="665" cy="199" rx="49" ry="21" fill="none" stroke="#9ca9a2" stroke-opacity=".55" stroke-width="1.8" transform="rotate(-9 665 199)"/>
        <ellipse cx="665" cy="199" rx="28" ry="12" fill="none" stroke="#b3bdb8" stroke-opacity=".75" stroke-width="1.8" transform="rotate(-9 665 199)"/>
        <circle cx="665" cy="199" r="4" fill="#cbd2ce"/>
      </g>
      <g opacity=".88" filter={paint('shadow')}>
        <path d="m203 268 420-64 190 114-420 66Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.6"/>
        <path d="m203 268 190 116v16L203 284ZM393 384l420-66v17l-420 65Z" fill={paint('side')} stroke="#6c7671" stroke-opacity=".35"/>
        <text x="320" y="279" class="label" transform="rotate(-9 320 279)">{en ? 'Source evidence' : '资料依据'}</text>
        <use href={icon('quote')} x="604" y="275" width="54" height="41" color="#a8b3ae" transform="matrix(1 -.15 .6 .45 -175 230)"/>
        <path d="m591 294 88-13m-68 29 89-13" stroke="#a4ada8" stroke-opacity=".5" stroke-width="3" stroke-linecap="round"/>
      </g>
      <g filter={paint('shadow')}>
        <path d="m180 370 420-64 190 114-420 66Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.6"/>
        <path d="m180 370 190 116v16L180 386ZM370 486l420-66v17l-420 65Z" fill={paint('side')} stroke="#6c7671" stroke-opacity=".35"/>
        <text x="297" y="381" class="label" transform="rotate(-9 297 381)">{en ? 'Colleague review' : '同事审阅'}</text>
        <path d="m569 393 92-14m-67 29 92-14m-68 29 92-14" stroke="#acb7b2" stroke-opacity=".6" stroke-width="3" stroke-linecap="round"/>
        <path d="m705 353 11 6-38 32-14 3 4-10Z" fill="#a1ada7" fill-opacity=".75" stroke="#dbdfdd" stroke-opacity=".45"/>
      </g>
      <g filter={paint('shadow')}>
        <path d="m157 472 420-64 190 114-420 66Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.8"/>
        <path d="m157 472 190 116v19L157 491ZM347 588l420-66v20l-420 65Z" fill={paint('side')} stroke="#a1ada7" stroke-opacity=".45"/>
        <path d="m157 472 420-64 96 58-420 65Z" fill={paint('veil')}/>
