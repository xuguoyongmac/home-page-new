        <path d="M25 264h165" stroke="#aab5b0" stroke-width="7" stroke-linecap="round" stroke-opacity=".55"/>
        <path d="M0 0h182l-135 342H0Z" fill={paint('veil')}/>
      </g>
      <g transform="translate(364 287) rotate(8 97 137)" filter={paint('float')}>
        <path d="M8 9h191v268l-10 11H8Z" fill={paint('side')} stroke={paint('edge')}/>
        <path d="M0 0h166l33 33v244H0Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.5"/>
        <path d="M166 1v32h32" fill="#4d5652" stroke="#aeb7b2" stroke-opacity=".35"/>
