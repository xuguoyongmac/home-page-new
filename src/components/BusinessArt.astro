      <circle cx="705" cy="554" r="5" fill="#bec6c2"/>
      <text x="490" y="653" text-anchor="middle" class="headline">{en ? 'A verifiable deliverable' : '可核对交付'}</text>
    </g>
  )}

  {variant === 'clients' && (
    <g>
      <path d="M252 325c-37 123 74 205 224 141s254-14 334-53M353 191c-23 99 46 156 128 194M661 190c22 91-32 148-119 194M508 435v132" class="light-path" stroke="#6d7c75" stroke-opacity=".2" stroke-width="13" filter={paint('glow')}/>
      <path d="M252 325c-37 123 74 205 224 141s254-14 334-53M353 191c-23 99 46 156 128 194M661 190c22 91-32 148-119 194M508 435v132" class="light-path" stroke={paint('beam')} stroke-width="2"/>
      <g transform="translate(337 168)" filter={paint('float')}>
        <circle r="52" fill={paint('deep-glass')} stroke={paint('edge')} stroke-width="1.5"/>
        <use href={icon('person')} x="-25" y="-35" width="50" height="60" color="#b9c2be"/>
      </g>
      <text x="337" y="256" text-anchor="middle" class="label muted">{en ? 'People' : '同事'}</text>
      <g transform="translate(660 168)" filter={paint('float')}>
        <circle r="52" fill={paint('deep-glass')} stroke={paint('edge')} stroke-width="1.5"/>
