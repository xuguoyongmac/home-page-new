      </g>
      <g transform="translate(384 303) rotate(3 117 120)" filter={paint('shadow')}>
        <path d="M10 13h181l40 40v203H10Z" fill={paint('side')} stroke={paint('edge')} stroke-width="1.4"/>
        <path d="M0 0h191l40 40v203H0Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.8"/>
        <path d="M191 1v39h39" fill="#515a56" stroke="#bbc4c0" stroke-opacity=".45"/>
