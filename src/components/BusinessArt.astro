        <rect x="12" y="12" width="196" height="119" rx="6" fill="#202221" stroke="#65706a" stroke-opacity=".4"/>
        <path d="M-17 146h254l24 14a6 6 0 0 1-3 11H-38a6 6 0 0 1-3-11Z" fill={paint('side')} stroke={paint('edge')} stroke-width="1.4"/>
        <path d="M100 43h21l12 12v48h-33Z" fill="#68766f" fill-opacity=".22" stroke="#b3bcb8" stroke-width="1.3"/>
        <path d="M111 62h12M111 76h12M111 90h8" stroke="#b1bbb6" stroke-opacity=".6" stroke-width="2" stroke-linecap="round"/>
