        <path d="M38 230h142" stroke="#a1ada7" stroke-width="6" stroke-linecap="round" stroke-opacity=".43"/>
      </g>
      <g transform="translate(229 150) rotate(-4 108 175)" filter={paint('shadow')}>
        <path d="M9 12h196l16 14v316l-13 14H9Z" fill={paint('side')} stroke={paint('edge')}/>
        <path d="M0 0h183l38 39v303H0Z" fill={paint('glass')} stroke={paint('edge')} stroke-width="1.6"/>
        <path d="M183 1v38h37" fill="#474e4a" stroke="#aeb7b2" stroke-opacity=".4"/>
        <text x="25" y="76" class="label">{en ? 'Research' : '研究资料'}</text>
        <use href={icon('quote')} x="25" y="110" width="51" height="40" color="#aab5b0"/>
