---
import type { Locale } from '../data/types';
import Icon from './Icon.astro';
import {pathFor} from '../lib/site';
interface Props { locale:Locale; }
const {locale}=Astro.props;const zh=locale==='zh';
const scenarios=zh?[
 {id:'proposal',icon:'file',name:'方案与报告',tag:'从资料到初稿',title:'把分散资料，组织成完整方案',body:'围绕业务目标检索资料、梳理结构、编写内容。团队在同一个项目里审阅与修改，接着完成汇报和交付。',inputs:['业务需求','产品资料','历史方案'],steps:['检索资料与出处','组织内容与结构','审阅、修改与交付'],outputs:['方案文档','汇报演示稿'],href:'solutions/general'},
 {id:'tender',icon:'book',name:'招投标辅助',tag:'从采购要求到响应材料',title:'先把要求读清楚，再推进标书编制',body:'提取采购条款，关联企业资质与方案材料，整理响应提纲和资料清单，让编制、核对与协作围绕同一套文件展开。',inputs:['招标文件','企业资质','技术资料'],steps:['拆解采购要求','关联响应材料','编制初稿与核对'],outputs:['条款响应清单','技术方案初稿'],href:'solutions/state-owned'},
 {id:'sales',icon:'chart',name:'客户经营',tag:'从客户资料到下一次沟通',title:'让每次跟进，都接得上已有的信息',body:'结合客户资料与历史沟通，整理需求、准备方案和跟进要点。通过已有 CRM 业务插件承接记录，相关工作交给数字员工继续处理。',inputs:['客户资料','沟通记录','产品方案'],steps:['整理需求与线索','准备沟通材料','沉淀跟进记录'],outputs:['客户需求摘要','方案与沟通提纲'],href:'solutions/general'},
 {id:'meeting',icon:'message',name:'会议与跟进',tag:'从讨论记录到行动清单',title:'会后要推进的工作，在这里接续',body:'从会议记录中整理结论与行动项，明确需要补充的资料和判断。同事确认后，在项目与会话中继续交办、处理和跟进。',inputs:['会议记录','项目资料','补充附件'],steps:['提取结论与事项','确认责任与交付','继续协作与跟进'],outputs:['会议纪要','行动项清单'],href:'solutions/general'},
]:[
 {id:'proposal',icon:'file',name:'Proposals & reports',tag:'FROM SOURCES TO DRAFT',title:'Turn scattered materials into a complete proposal',body:'Research the context, structure the content and prepare a draft. Review and edit together in a shared project before delivery.',inputs:['Business needs','Product materials','Prior proposals'],steps:['Research and cite','Structure and write','Review and deliver'],outputs:['Proposal document','Presentation'],href:'solutions/general'},
 {id:'tender',icon:'book',name:'Bid preparation',tag:'FROM REQUIREMENTS TO RESPONSES',title:'Understand the requirements before drafting the bid',body:'Extract tender requirements, connect company credentials and organize response outlines and source materials in one project.',inputs:['Tender files','Credentials','Technical materials'],steps:['Analyze requirements','Connect materials','Draft and review'],outputs:['Response checklist','Technical proposal'],href:'solutions/state-owned'},
 {id:'sales',icon:'chart',name:'Customer work',tag:'FROM CUSTOMER CONTEXT TO FOLLOW-UP',title:'Build the next conversation on what is already known',body:'Organize customer needs and prepare proposals and follow-up points. Use the CRM business plugin to keep related records together.',inputs:['Customer context','Conversation notes','Product proposals'],steps:['Organize needs','Prepare materials','Keep follow-up records'],outputs:['Needs summary','Conversation outline'],href:'solutions/general'},
 {id:'meeting',icon:'message',name:'Meetings & follow-up',tag:'FROM DISCUSSION TO ACTION',title:'Keep the work moving after the meeting',body:'Extract decisions and actions, identify missing inputs and involve colleagues. Continue the work in shared projects and conversations.',inputs:['Meeting notes','Project files','Attachments'],steps:['Extract decisions','Confirm responsibilities','Continue the work'],outputs:['Meeting minutes','Action list'],href:'solutions/general'},
];
---
<div class="work-showcase" data-work-showcase>
 <div class="work-tabs" role="tablist" aria-label={zh?'工作场景':'Work scenarios'}>{scenarios.map((s,i)=><button type="button" role="tab" id={`work-tab-${s.id}`} aria-controls={`work-panel-${s.id}`} aria-selected={i===0} tabindex={i===0?0:-1}><Icon name={s.icon} size={18}/>{s.name}</button>)}</div>
 {scenarios.map((s,i)=><div class:list={['work-panel',`work-${s.id}`]} role="tabpanel" id={`work-panel-${s.id}`} aria-labelledby={`work-tab-${s.id}`} hidden={i!==0} tabindex="0">
  <div class="work-copy"><span class="work-overline">{s.tag}</span><h3>{s.title}</h3><p>{s.body}</p><div class="work-inputs">{s.inputs.map(label=><span>{label}</span>)}</div><ol>{s.steps.map((label,index)=><li><span>{index+1}</span>{label}</li>)}</ol><a class="text-link" href={pathFor(locale,s.href)}>{zh?'了解业务方案':'Explore the solution'}<Icon name="arrow" size={15}/></a></div>
  <div class="work-result" role="img" aria-label={zh?`${s.name}成果与处理过程示意`:`${s.name}: deliverables and work process`}>
   <div aria-hidden="true">
    {s.id==='proposal'&&<div class="proposal-art"><div class="proposal-shadow"></div><div class="proposal-cover"><span class="result-brand">TEGO OS / PROJECT</span><strong>{zh?'企业数字员工\n建设方案':'Enterprise digital\nworkforce proposal'}</strong><p>{zh?'从岗位任务，走向团队协作':'From role-specific tasks to teamwork'}</p><div class="proposal-geometry"><span></span><span></span><span></span></div><div class="proposal-topics">{(zh?['业务场景','岗位能力','知识与系统','交付路径']:['Use cases','Roles','Knowledge & tools','Delivery']).map(t=><span>{t}</span>)}</div></div><div class="result-file-float"><span>W</span><div><strong>{zh?'项目方案.docx':'Project proposal.docx'}</strong><small>{zh?'可审阅 · 可继续修改':'Ready for review and editing'}</small></div><Icon name="check" size={15}/></div></div>}
    {s.id==='tender'&&<div class="tender-art"><div class="result-art-heading"><span><Icon name="book" size={18}/>{zh?'采购要求与响应材料':'Requirements and responses'}</span><small>{zh?'编制工作区':'Bid workspace'}</small></div><div class="response-head"><span>{zh?'采购要求':'Requirement'}</span><span>{zh?'响应材料':'Source material'}</span></div>{(zh?[['交付范围','技术方案章节'],['资质要求','企业资质文件'],['服务要求','实施与服务计划'],['商务条款','商务响应清单']]:[['Delivery scope','Technical proposal'],['Qualifications','Company credentials'],['Service scope','Implementation plan'],['Commercial terms','Response checklist']]).map(([a,b])=><div class="response-row"><span><Icon name="file" size={15}/>{a}</span><Icon name="arrow" size={14}/><strong>{b}</strong><Icon name="check" size={14}/></div>)}<div class="result-bottom-file"><Icon name="file" size={19}/><strong>{zh?'标书响应提纲.docx':'Bid response outline.docx'}</strong><span>{zh?'初稿':'Draft'}</span></div></div>}
    {s.id==='sales'&&<div class="sales-art"><div class="sales-opportunity"><span class="visual-label">{zh?'客户工作空间':'CUSTOMER WORKSPACE'}</span><strong>{zh?'数字员工平台建设':'Digital workforce platform'}</strong><p>{zh?'需求资料 · 沟通纪要 · 方案文件':'Needs · Notes · Proposals'}</p><div class="sales-stage">{(zh?['需求了解','方案沟通','资料准备']:['Discovery','Discussion','Preparation']).map((t,i)=><span class:list={{active:i===1}}>{t}</span>)}</div></div><div class="sales-followup"><span><Icon name="message" size={17}/>{zh?'下一次沟通':'Next conversation'}</span><strong>{zh?'把客户关心的事项准备充分':'Bring the context into the conversation'}</strong><ul>{(zh?['梳理岗位与业务流程','整理知识与系统接入需求','准备企业部署说明']:['Map roles and workflows','Gather knowledge and integration needs','Prepare deployment materials']).map(t=><li><Icon name="check" size={13}/>{t}</li>)}</ul></div></div>}
    {s.id==='meeting'&&<div class="meeting-art"><div class="meeting-note"><span class="visual-label"><Icon name="message" size={16}/>{zh?'项目沟通纪要':'PROJECT MEETING NOTES'}</span><strong>{zh?'讨论形成结论，\n事项接着推进':'Capture the decisions.\nKeep the actions moving.'}</strong><p>{zh?'工作范围 / 资料准备 / 接口协同':'Work scope / Source materials / Integrations'}</p></div><div class="meeting-actions">{(zh?[['确认交付范围','待负责人确认'],['整理知识资料','待资料补充'],['补充接口清单','待技术评估']]:[['Confirm delivery scope','Owner confirmation'],['Organize knowledge','Materials needed'],['List integrations','Technical review']]).map(([a,b])=><div><span class="action-square"></span><strong>{a}</strong><span>{b}</span></div>)}</div></div>}
    <div class="work-output-tags">{s.outputs.map(label=><span><Icon name="file" size={13}/>{label}</span>)}</div>
   </div>
  </div>
 </div>)}
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-work-showcase]').forEach(root=>{
  const tabs=[...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];const panels=[...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
  const select=(tab:HTMLButtonElement)=>{tabs.forEach(item=>{item.setAttribute('aria-selected',String(item===tab));item.tabIndex=item===tab?0:-1;});panels.forEach(panel=>panel.hidden=panel.id!==tab.getAttribute('aria-controls'));};
  tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>select(tab));tab.addEventListener('keydown',event=>{let next:number|undefined;if(event.key==='ArrowRight')next=(index+1)%tabs.length;if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;if(event.key==='Home')next=0;if(event.key==='End')next=tabs.length-1;if(next!==undefined){event.preventDefault();select(tabs[next]);tabs[next].focus();}});});
 });
</script>
