---
import type { Locale } from '../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
---
<div class="value-illustration" aria-hidden="true">
  <svg viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="pricing-decision-panel" x1="24" y1="30" x2="576" y2="370" gradientUnits="userSpaceOnUse">
        <stop stop-color="#20394e" stop-opacity=".84"/>
        <stop offset="1" stop-color="#0f2032" stop-opacity=".94"/>
      </linearGradient>
      <linearGradient id="pricing-decision-edge" x1="40" y1="30" x2="550" y2="370" gradientUnits="userSpaceOnUse">
        <stop stop-color="#b2d9f7" stop-opacity=".3"/>
        <stop offset=".6" stop-color="#81b7df" stop-opacity=".09"/>
        <stop offset="1" stop-color="#8abfd7" stop-opacity=".2"/>
      </linearGradient>
      <linearGradient id="pricing-decision-result" x1="58" y1="280" x2="540" y2="350" gradientUnits="userSpaceOnUse">
        <stop stop-color="#65dba9" stop-opacity=".085"/>
        <stop offset="1" stop-color="#65dba9" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <rect x="24" y="30" width="552" height="340" rx="26" fill="url(#pricing-decision-panel)" stroke="url(#pricing-decision-edge)"/>
    <text x="58" y="79" fill="#b5c9dd" font-size="16" font-weight="500">{zh ? '团队规模' : 'Your Team'}</text>
    <text x="330" y="79" fill="#b5c9dd" font-size="16" font-weight="500">{zh ? '部署方式' : 'Deploy'}</text>
    <path d="M300 65V216" stroke="#a2c5e7" stroke-opacity=".12"/>
    <text x="58" y="127" fill="#e4f1ff" font-size={zh ? '20' : '18'} font-weight="500">{zh ? '规模：100–500人' : 'Size: 100–500 people'}</text>
    <rect x="58" y="163" width="216" height="6" rx="3" fill="#57738f" fill-opacity=".42"/>
    <rect x="58" y="163" width="108" height="6" rx="3" fill="#6ebafa"/>
    <circle cx="166" cy="166" r="17" fill="#70baff" fill-opacity=".1"/>
    <circle cx="166" cy="166" r="9" fill="#d8eeff" stroke="#6ebafa" stroke-width="3"/>
    <circle cx="334" cy="118" r="7" stroke="#738ea7" stroke-width="1.5"/>
    <text x="353" y="123" fill="#a9bfd4" font-size="16">{zh ? '公有云部署' : 'Public cloud'}</text>
    <circle cx="334" cy="158" r="7" stroke="#738ea7" stroke-width="1.5"/>
    <text x="353" y="163" fill="#a9bfd4" font-size="16">{zh ? '私有化部署' : 'Private deployment'}</text>
    <rect x="316" y="178" width="226" height="40" rx="11" fill="#4dacf0" fill-opacity=".1" stroke="#6ebafa" stroke-opacity=".3"/>
    <circle cx="334" cy="198" r="7" stroke="#74bffb" stroke-width="1.6"/>
    <circle cx="334" cy="198" r="3.5" fill="#83c9ff"/>
    <text x="353" y="203" fill="#dbedff" font-size="16" font-weight="500">{zh ? '混合云部署' : 'Hybrid cloud'}</text>
    <path d="M58 246H542" stroke="#a2c5e7" stroke-opacity=".13"/>
    <text x="58" y="279" fill="#b5c9dd" font-size="15">{zh ? '产出' : 'Result'}</text>
    <rect x="48" y="292" width="502" height="56" rx="14" fill="url(#pricing-decision-result)"/>
    <path d="M62 331L72 321L82 325L96 307M85 307H96V318" stroke="#79dfaf" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="110" y="325" fill="#d5efdf" font-size={zh ? '20' : '17'} font-weight="500">{zh ? <>目标：智能体效率提升<tspan dx="7" fill="#83e8b8" font-size="32">40%</tspan></> : <>Target:<tspan dx="7" fill="#83e8b8" font-size="30">40%</tspan><tspan dx="6">agent efficiency gain</tspan></>}</text>
  </svg>
</div>
<style>
  .value-illustration{position:relative;isolation:isolate;width:100%;aspect-ratio:3/2}
  .value-illustration::before{content:'';position:absolute;inset:1% -1%;z-index:-1;background:radial-gradient(ellipse at 20% 28%,#569bdf19,transparent 60%),radial-gradient(ellipse at 85% 85%,#51bd9a0c,transparent 55%);filter:blur(18px);pointer-events:none}
  svg{display:block;width:100%;height:auto;overflow:visible}
  text{font-family:inherit}
</style>
