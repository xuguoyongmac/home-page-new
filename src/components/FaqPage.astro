---
import type { Locale } from '../data/types';
import { faqs } from '../data/pages';
import Icon from './Icon.astro';
import CallToAction from './CallToAction.astro';
import PageHeroArt from './PageHeroArt.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const other = locale === 'zh' ? 'en' : 'zh';
const questions = faqs[locale];
---
<section class="page-hero inner-page-hero inner-support-hero">
  <PageHeroArt variant="collaboration" compact/>
  <div class="container inner-hero-content"><div class="inner-hero-copy">
    <p class="eyebrow">{locale === 'zh' ? '常见问题' : 'FAQ'}</p>
    <h1>{locale === 'zh' ? '关于 TeGo，常见的几个问题' : 'Questions about TeGo'}</h1>
    <p>{locale === 'zh' ? '了解产品概念、协作方式、各端能力与企业部署。' : 'Understand product concepts, collaboration, client capabilities and enterprise deployment.'}</p>
    <label class="sr-only" for="faq-query">{locale === 'zh' ? '搜索问题与答案' : 'Search questions and answers'}</label>
    <input id="faq-query" class="faq-search" type="search" placeholder={locale === 'zh' ? '搜索问题与答案' : 'Search questions and answers'} autocomplete="off" aria-controls="faq-results" data-faq-query/>
  </div></div>
</section>
<section class="faq-section inner-faq" data-faq-search data-locale={locale} aria-labelledby="faq-list-title">
  <div class="container">
    <h2 id="faq-list-title" class="sr-only">{locale === 'zh' ? '产品问题与答案' : 'Product questions and answers'}</h2>
    <div class="faq-list" id="faq-results">
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-faq-status>{locale === 'zh' ? `${questions.length} 个问题` : `${questions.length} questions`}</p>
      {questions.map((faq, index) => (
        <details data-faq-item data-search={`${faq.question} ${faq.answer} ${faqs[other][index]?.question ?? ''} ${faqs[other][index]?.answer ?? ''}`.toLowerCase()}>
          <summary>{faq.question}<Icon name="plus" size={20}/></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
      <div class="faq-empty" data-faq-empty hidden>
        <p>{locale === 'zh' ? '没有找到与搜索词匹配的问题。' : 'No questions match your search.'}</p>
        <button type="button" class="button button-outline button-small" data-faq-reset>{locale === 'zh' ? '清除搜索' : 'Clear search'}</button>
      </div>
    </div>
  </div>
</section>
<CallToAction locale={locale}/>
<script>
  const faqSearch = document.querySelector<HTMLElement>('[data-faq-search]');
  const faqQuery = document.querySelector<HTMLInputElement>('[data-faq-query]');
  if (faqSearch && faqQuery) {
    const items = [...faqSearch.querySelectorAll<HTMLDetailsElement>('[data-faq-item]')];
    const empty = faqSearch.querySelector<HTMLElement>('[data-faq-empty]');
    const status = faqSearch.querySelector<HTMLElement>('[data-faq-status]');
    const update = () => {
      const query = faqQuery.value.trim().toLowerCase();
      let count = 0;
      for (const item of items) {
        const matches = !query || (item.dataset.search ?? '').includes(query);
        item.hidden = !matches;
        if (matches) count += 1;
        else item.open = false;
      }
      if (empty) empty.hidden = count !== 0;
      if (status) status.textContent = faqSearch.dataset.locale === 'zh' ? `找到 ${count} 个问题` : `${count} questions found`;
    };
    faqQuery.addEventListener('input', update);
    faqSearch.querySelector<HTMLButtonElement>('[data-faq-reset]')?.addEventListener('click', () => {
      faqQuery.value = '';
      update();
      faqQuery.focus();
    });
  }
</script>
