---
import type { Locale } from '../data/types';
import Icon from './Icon.astro';
interface Props { variant: 'ecosystem' | 'enterprise'; locale: Locale; }
const { variant, locale } = Astro.props;
const zh = locale === 'zh';
const t = zh ? {
  employee: '数字员工', skills: '技能', templates: '数字员工模板', plugins: '业务插件',
  recruit: '招募', tools: '工具接入', api: '平台调用',
  private: '私有化部署', environment: '企业运行环境', identity: '组织身份与授权',
  platform: '平台服务', knowledge: '企业知识', model: '本地模型',
  connect: '授权连接', external: '外部系统', audit: '执行审计', output: '成果记录',
} : {
  employee: 'Digital employee', skills: 'Skills', templates: 'Employee templates', plugins: 'Business plugins',
  recruit: 'Recruit', tools: 'Tool access', api: 'Platform calls',
  private: 'Private deployment', environment: 'Enterprise environment', identity: 'Identity & authorization',
  platform: 'Platform', knowledge: 'Knowledge', model: 'Local models',
  connect: 'Authorized access', external: 'External systems', audit: 'Execution audit', output: 'Output records',
};
---
<div class:list={['platform-scene', `platform-scene-${variant}`, { 'platform-scene-en': !zh }]} data-scene-content={variant} data-visual-concept={variant === 'ecosystem' ? 'capability-network' : 'enterprise-boundary'}>
  {variant === 'ecosystem' ? <div class="capability-network">
    <div class="network-orbit orbit-outer" aria-hidden="true"></div><div class="network-orbit orbit-inner" aria-hidden="true"></div>
    <svg class="network-lines" viewBox="0 0 1000 690" fill="none" aria-hidden="true">
      <path d="M180 153C375 153 312 296 480 310M145 345H470M190 548C370 548 317 351 480 335" class="asset-path"/>
      <path d="M545 310C715 310 655 161 820 161M545 335C705 335 676 524 820 524" class="system-path"/>
      <circle cx="312" cy="345" r="4"/><circle cx="712" cy="186" r="4"/><circle cx="708" cy="492" r="4"/>
    </svg>
    <div class="network-node node-skill"><span class="node-glyph"><Icon name="book"/></span><strong>{t.skills}</strong></div>
    <div class="network-node node-template"><span class="node-glyph template-glyph"><Icon name="network"/></span><strong>{t.templates}</strong></div>
    <span class="recruit-label">{t.recruit}</span>
    <div class="network-node node-plugin"><span class="node-glyph plugin-glyph"><Icon name="layers"/></span><strong>{t.plugins}</strong></div>
    <div class="capability-hub"><div class="hub-disc"><span class="hub-letter">T</span></div><strong>TeGo</strong><span>{t.employee}</span></div>
    <div class="network-node node-mcp"><span class="node-glyph connection-glyph"><Icon name="plug"/></span><strong>MCP</strong><span>{t.tools}</span></div>
    <div class="network-node node-api"><span class="node-glyph connection-glyph"><Icon name="terminal"/></span><strong>OpenAPI</strong><span>{t.api}</span></div>
  </div> : <div class="enterprise-space">
    <span class="deployment-caption"><span></span>{t.private}</span>
    <div class="boundary-shadow" aria-hidden="true"></div>
    <div class="controlled-space">
      <div class="boundary-grid" aria-hidden="true"></div>
      <div class="space-heading"><Icon name="shield"/><strong>{t.environment}</strong></div>
      <div class="infrastructure">
        <div class="infrastructure-object platform-object"><span class="infrastructure-symbol"><Icon name="layers"/></span><strong>{t.platform}</strong></div>
        <div class="infrastructure-object knowledge-object"><span class="infrastructure-symbol"><Icon name="book"/></span><strong>{t.knowledge}</strong></div>
        <div class="infrastructure-object model-object"><span class="infrastructure-symbol"><Icon name="cpu"/></span><strong>{t.model}</strong></div>
      </div>
      <span class="identity-boundary"><Icon name="key"/>{t.identity}</span>
    </div>
    <div class="access-bridge" aria-hidden="true"><span></span></div>
    <div class="access-point"><Icon name="plug"/></div>
    <span class="connection-label">{t.connect}</span>
    <div class="external-system"><Icon name="globe"/><strong>{t.external}</strong></div>
    <div class="record-branch" aria-hidden="true"></div>
    <div class="execution-records"><span><Icon name="terminal"/>{t.audit}</span><span><Icon name="file"/>{t.output}</span></div>
  </div>}
</div>
<style>
.platform-scene{position:relative;width:100%;height:100%;container-type:inline-size;color:#f6f7f6;font-family:inherit;text-align:left;isolation:isolate}
.platform-scene :global(svg:not(.network-lines)){display:block;width:4cqw;height:4cqw;stroke-width:1.45;flex-shrink:0}
.platform-scene strong{font-weight:550}
.capability-network,.enterprise-space{position:relative;width:100%;height:100%;overflow:hidden}
.capability-network{background:radial-gradient(ellipse at 49% 47%,#79898125,transparent 57%)}
.network-orbit{position:absolute;border:1px solid #74857c29;border-radius:50%;pointer-events:none}
.orbit-outer{width:69%;height:81%;left:15%;top:7%;transform:rotate(-24deg)}
.orbit-inner{width:51%;height:62%;left:24%;top:17%;transform:rotate(24deg);border-color:#8a989118}
.network-lines{position:absolute;inset:0;width:100%;height:100%;stroke-width:1.45;overflow:visible}
.asset-path{stroke:#a1aca6aa}.system-path{stroke:#85938caa}.network-lines circle{fill:#b0bab5;stroke:none}
.network-node{position:absolute;display:flex;flex-direction:column;align-items:center;gap:1.1cqw;transform:translate(-50%,-50%);text-align:center;min-width:16cqw}
.node-glyph{position:relative;display:grid;place-items:center;width:10cqw;height:10cqw;border-radius:2.3cqw;border:1px solid #8b9a92a6;background:linear-gradient(145deg,#434946,#282c2a);color:#ced4d1;box-shadow:0 1.8cqw 3.8cqw #10111045,inset 0 0 2.2cqw #95a29c18}
.node-glyph::after{content:'';position:absolute;inset:.65cqw;border:1px solid #93a19a20;border-radius:1.8cqw}
.node-glyph :global(svg){width:5cqw!important;height:5cqw!important}
.network-node strong{font-size:2.5cqw;line-height:1.3;white-space:nowrap}
.network-node>span:not(.node-glyph){color:#b6bfba;font-size:1.9cqw;line-height:1.3;margin-top:-.3cqw}
.node-skill{left:18%;top:21%}.node-template{left:14.5%;top:49%}.node-plugin{left:19%;top:79%}.node-mcp{left:83%;top:22%}.node-api{left:83%;top:76%}
.template-glyph{background:linear-gradient(145deg,#424845,#313533)}
.plugin-glyph{color:#d9dedc;background:linear-gradient(145deg,#49534e,#323735);border-color:#8a959086}
.connection-glyph{border-color:#7b8b837a;background:linear-gradient(145deg,#313533,#262a28);color:#a7b1ac}
.recruit-label{position:absolute;left:31%;top:47.6%;padding:.3cqw 1cqw;font-size:1.8cqw;line-height:1.3;color:#aeb7b2;background:#1a1c1b}
.capability-hub{position:absolute;left:49%;top:47%;width:24%;display:flex;flex-direction:column;align-items:center;transform:translate(-50%,-50%);text-align:center}
.hub-disc{position:relative;display:grid;place-items:center;width:18cqw;height:18cqw;border-radius:50%;border:1px solid #a2ada8c9;background:radial-gradient(circle at 35% 24%,#93a19a,#5c6962 55%,#2e3330);box-shadow:0 0 7cqw #8b999243,inset 0 0 4cqw #b4bdb835,0 2cqw 5cqw #0e0f0e85}
.hub-disc::before{content:'';position:absolute;inset:-1.8cqw;border:1px solid #94a19b66;border-radius:50%}
.hub-disc::after{content:'';position:absolute;inset:-3.4cqw;border:1px solid #95a29c28;border-radius:50%}
.hub-letter{font-size:9cqw;line-height:1;font-weight:550;color:#eef1f0;text-shadow:0 0 2cqw #cbd1ce50;transform:translateY(-.3cqw)}
.capability-hub>strong{font-size:4.1cqw;line-height:1.25;margin-top:3cqw;letter-spacing:-.15cqw}
.capability-hub>span{font-size:2.4cqw;line-height:1.5;color:#ccd2cf;margin-top:.4cqw;white-space:nowrap}
.enterprise-space{background:radial-gradient(ellipse at 42% 53%,#7b8b8324,transparent 64%)}
.deployment-caption{position:absolute;left:8%;top:9%;display:flex;align-items:center;gap:1cqw;font-size:2cqw;color:#bfc7c3}
.deployment-caption>span{width:.7cqw;height:.7cqw;background:#95a29c;border-radius:50%}
.boundary-shadow{position:absolute;left:8%;top:29%;width:73%;height:53%;border:1px solid #69777035;border-radius:4cqw;background:linear-gradient(160deg,#30353233,#434a4644);transform:translateY(1cqw)}
.controlled-space{position:absolute;left:6%;top:22%;width:76%;height:55%;border:1px solid #909d96a3;border-radius:4cqw;background:radial-gradient(ellipse at 16% 1%,#8e9b9424,transparent 63%),linear-gradient(140deg,#3b403eba,#252827ed 85%);box-shadow:inset 0 0 5cqw #78888016,0 2.5cqw 5cqw #0d0e0e55}
.boundary-grid{position:absolute;inset:0;border-radius:inherit;overflow:hidden;background-image:linear-gradient(#5966602b 1px,transparent 1px),linear-gradient(90deg,#5966602b 1px,transparent 1px);background-size:5.5cqw 5.5cqw;mask-image:linear-gradient(transparent 22%,#0009 80%);opacity:.65}
.space-heading{position:relative;display:flex;align-items:center;gap:1.2cqw;margin:3.2cqw 3.7cqw 0}
.space-heading :global(svg){width:3.5cqw!important;height:3.5cqw!important;color:#aeb7b2}
.space-heading strong{font-size:2.8cqw;line-height:1.4;letter-spacing:-.05cqw}
.infrastructure{position:absolute;left:7%;right:7%;top:32%;bottom:11%;display:flex;align-items:center;justify-content:space-around;gap:1cqw}
.infrastructure-object{position:relative;display:flex;flex-direction:column;align-items:center;gap:1.8cqw;flex:1;min-width:0}
.infrastructure-symbol{position:relative;display:grid;place-items:center;width:12cqw;height:10.4cqw;border:1px solid #9aa6a073;border-radius:1.7cqw;background:linear-gradient(150deg,#616e68af,#353937);box-shadow:0 1cqw 0 -.1cqw #2b302e,0 1cqw 0 0 #6a777066,0 1.6cqw 2.8cqw #10121155;color:#d3d8d6}
.infrastructure-symbol :global(svg){width:6cqw!important;height:6cqw!important;stroke-width:1.25!important}
.knowledge-object .infrastructure-symbol{color:#a7b2ac;background:linear-gradient(150deg,#3f4542af,#353937)}
.model-object .infrastructure-symbol{color:#d8dcda;background:linear-gradient(150deg,#5c6862af,#353937)}
.infrastructure-object strong{font-size:2.35cqw;line-height:1.3;white-space:nowrap}
.identity-boundary{position:absolute;left:9%;bottom:-1.7cqw;display:flex;align-items:center;gap:.7cqw;padding:.55cqw 1.5cqw;background:#292c2a;color:#c5cdc9;border:1px solid #7988809c;border-radius:3cqw;font-size:2cqw;line-height:1.5}
.identity-boundary :global(svg){width:2.5cqw!important;height:2.5cqw!important;color:#a7b2ac}
.access-bridge{position:absolute;left:81%;top:51%;height:1px;width:12%;background:linear-gradient(90deg,#a1ada7,#67746e)}
.access-bridge>span{position:absolute;right:0;top:-.4cqw;width:.8cqw;height:.8cqw;border-radius:50%;background:#a6b1ac}
.access-point{position:absolute;left:79.6%;top:51%;transform:translate(-50%,-50%);display:grid;place-items:center;width:5.2cqw;height:7cqw;border:1px solid #9faba5b3;border-radius:1.5cqw;background:linear-gradient(135deg,#3d4240,#383e3b);box-shadow:0 0 3cqw #86948d25;color:#bec6c2}
.access-point :global(svg){width:3cqw!important;height:3cqw!important}
.connection-label{position:absolute;left:82.5%;top:58%;width:15%;font-size:1.7cqw;color:#aeb7b2;text-align:center;line-height:1.4}
.external-system{position:absolute;left:91%;top:35%;display:flex;flex-direction:column;align-items:center;gap:1.2cqw;transform:translateX(-50%);color:#b3bcb8}
.external-system :global(svg){width:5cqw!important;height:5cqw!important}
.external-system strong{font-size:1.9cqw;line-height:1.3;white-space:nowrap;color:#cbd1ce}
.record-branch{position:absolute;left:67%;top:77%;width:1px;height:12%;background:linear-gradient(#7b8a82aa,#727e788a)}
.execution-records{position:absolute;left:42%;right:8%;top:86%;display:flex;align-items:center;justify-content:center;gap:2.8cqw;padding:1.2cqw 1.5cqw;border:1px solid #5d676266;background:#262a285c;border-radius:1.2cqw;color:#c0c8c4}
.execution-records>span{display:flex;align-items:center;gap:.7cqw;font-size:2cqw;line-height:1.4;white-space:nowrap}
.execution-records :global(svg){width:2.3cqw!important;height:2.3cqw!important;color:#c5ccc8}
.platform-scene-en .network-node strong{font-size:2.1cqw}.platform-scene-en .capability-hub>span{font-size:2cqw}.platform-scene-en .space-heading strong{font-size:2.5cqw}.platform-scene-en .identity-boundary{font-size:1.65cqw}.platform-scene-en .external-system strong{font-size:1.6cqw}.platform-scene-en .execution-records>span{font-size:1.65cqw}.platform-scene-en .connection-label{font-size:1.5cqw}
</style>
<style>
@container (max-width:450px){
  .network-node strong{font-size:clamp(10px,3.2cqw,14px)}
  .network-node>span:not(.node-glyph){font-size:clamp(8px,2.7cqw,12px)}
  .capability-hub>strong{font-size:5.1cqw}.capability-hub>span{font-size:3.1cqw}
  .node-glyph{width:11.5cqw;height:11.5cqw}.node-glyph :global(svg){width:6cqw!important;height:6cqw!important}
  .recruit-label{font-size:2.5cqw;left:29%}
  .deployment-caption{font-size:clamp(10px,3.1cqw,13px)}
  .space-heading strong{font-size:3.6cqw}.space-heading :global(svg){width:4cqw!important;height:4cqw!important}
  .infrastructure-symbol{width:14cqw;height:12.5cqw}.infrastructure-symbol :global(svg){width:7cqw!important;height:7cqw!important}
  .infrastructure-object strong{font-size:clamp(9px,3.1cqw,13px)}
  .identity-boundary{font-size:clamp(8px,2.7cqw,11px);bottom:-2.3cqw}
  .external-system strong{font-size:clamp(8px,2.6cqw,11px)}
  .external-system :global(svg){width:6cqw!important;height:6cqw!important}
  .connection-label,.execution-records,.record-branch{display:none}
  .platform-scene-en .network-node strong{font-size:clamp(9px,2.75cqw,12px)}
  .platform-scene-en .capability-hub>span{font-size:2.8cqw}
  .platform-scene-en .space-heading strong{font-size:3.2cqw}
  .platform-scene-en .identity-boundary{font-size:2.8cqw}
  .platform-scene-en .external-system strong{font-size:2.5cqw}
}
</style>
