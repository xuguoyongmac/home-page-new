---
import Icon from './Icon.astro';
import type { Locale } from '../data/types';

interface Props {
  variant: 'clients' | 'resources' | 'journal' | 'contact' | 'faq' | 'releases';
  locale: Locale;
}
const { variant, locale } = Astro.props;
const zh = locale === 'zh';
const text = (chinese: string, english: string) => zh ? chinese : english;
const resourceItems = [
  { icon: 'book', title: text('产品文档', 'Product guides'), body: text('数字员工 · 项目 · 成果', 'Employees · Projects · Files'), tag: text('操作手册', 'User manual'), tone: 'blue' },
  { icon: 'terminal', title: text('部署资料', 'Deployment'), body: text('环境要求与安装步骤', 'Requirements and installation'), tag: 'Compose · Kubernetes', tone: 'cyan' },
  { icon: 'monitor', title: text('客户端下载', 'Client downloads'), body: 'Web · Desktop · Mobile', tag: text('按设备平台查找', 'Find your platform'), tone: 'purple' },
  { icon: 'message', title: text('常见问题', 'Product FAQ'), body: text('产品概念与使用边界', 'Concepts and usage boundaries'), tag: text('产品问答', 'Questions and answers'), tone: 'blue' },
];
const requirements = [
  { icon: 'network', title: text('工作目标', 'Work objective'), body: text('整理资料，形成可编辑成果', 'Organize sources into editable deliverables'), tone: 'blue' },
  { icon: 'folder', title: text('已有资料', 'Available material'), body: text('产品文档、业务流程与系统接口', 'Product documents, workflows and system APIs'), tone: 'cyan' },
  { icon: 'cpu', title: text('部署要求', 'Deployment needs'), body: text('企业网络、模型与终端环境', 'Enterprise network, models and client devices'), tone: 'purple' },
];
---
<div class:list={['resource-scene', `scene-${variant}`, { 'scene-english': !zh }]} data-scene-content={variant} aria-hidden="true">
  {variant === 'clients' && <div class="clients-scene scene-surface">
    <div class="desktop-device">
      <div class="desktop-project-head"><span class="mini-icon blue"><Icon name="folder"/></span><div><span class="overline">{text('项目', 'PROJECT')}</span><strong>{text('产品资料整理', 'Product research')}</strong></div></div>
      <div class="desktop-project-body">
        <div class="project-navigation"><span class="selected">{text('工作稿', 'Drafts')}</span><span>{text('项目资料', 'Sources')}</span><span>{text('待处理', 'To review')}</span></div>
        <div class="project-files"><div class="draft-file"><span class="file-badge blue"><Icon name="file"/></span><div><strong>{text('产品资料汇编', 'Product research draft')}</strong><span>{text('可编辑工作稿', 'Editable working draft')}</span></div></div><div class="pending-work"><span class="status-dot"></span><div><strong>{text('确认资料范围', 'Confirm the source scope')}</strong><span>{text('待处理', 'To review')}</span></div></div></div>
      </div>
      <div class="device-stand"></div>
    </div>
    <div class="mobile-device"><div class="phone-speaker"></div><div class="mobile-project"><span class="overline">{text('同一项目', 'SAME PROJECT')}</span><strong>{text('产品资料整理', 'Product research')}</strong><div class="mobile-file"><Icon name="file"/><span>{text('工作稿', 'Working draft')}</span></div><div class="mobile-pending"><span class="status-dot"></span><span>{text('待处理', 'To review')}</span></div><p>{text('确认资料范围', 'Confirm source scope')}</p></div><div class="phone-home"></div></div>
    <div class="client-platforms"><span>Web</span><span>Desktop</span><span>Mobile</span></div>
  </div>}

  {variant === 'resources' && <div class="resource-index scene-surface">
    {resourceItems.map(item => <div class:list={['resource-tile', item.tone]}><span class="resource-icon"><Icon name={item.icon}/></span><strong>{item.title}</strong><p>{item.body}</p><span class="resource-tag">{item.tag}</span></div>)}
  </div>}

  {variant === 'journal' && <div class="journal-scene scene-surface">
    <div class="journal-main"><span class="overline cyan">TEGO JOURNAL</span><span class="article-category">{text('产品观察', 'Product perspectives')}</span><strong class="journal-title">{text('云端 Agent\n在企业上岗', 'Cloud agents,\nenterprise work')}</strong><p class="journal-excerpt">{text('接任务、用工具、交结果。\n关键操作，回到人的判断。', 'Take on tasks. Use tools. Deliver work.\nKeep people involved in key decisions.')}</p><div class="journal-topics"><span>Agent</span><span>{text('数字员工', 'Digital employees')}</span></div></div>
    <div class="journal-sidebar"><span class="overline">{text('文章分类', 'CATEGORIES')}</span><div class="category-index"><span class="active">{text('产品观察', 'Perspectives')}</span><span>{text('工程实践', 'Engineering')}</span><span>{text('产品体验', 'Product experience')}</span></div><div class="journal-related"><span class="mini-icon cyan"><Icon name="book"/></span><span class="article-category">{text('工程实践', 'Engineering')}</span><strong>{text('数据隔离\n与模板治理', 'Data isolation\nand template governance')}</strong></div></div>
  </div>}

  {variant === 'contact' && <div class="contact-scene scene-surface"><div class="brief-heading"><span class="overline cyan">{text('需求交流', 'WORK BRIEF')}</span><strong>{text('从具体工作开始', 'Start with the work')}</strong></div><div class="requirement-lanes">{requirements.map(item => <div class="requirement-lane"><span class:list={['requirement-icon', item.tone]}><Icon name={item.icon}/></span><div><strong>{item.title}</strong><p>{item.body}</p></div></div>)}</div></div>}

  {variant === 'faq' && <div class="faq-scene scene-surface">
    <div class="faq-topics"><span class="overline">{text('问题索引', 'TOPICS')}</span><span class="active"><Icon name="layers"/>{text('产品概念', 'Concepts')}</span><span><Icon name="folder"/>{text('项目与资料', 'Projects')}</span><span><Icon name="file"/>{text('文件编辑', 'File editing')}</span><span><Icon name="cpu"/>{text('企业部署', 'Deployment')}</span></div>
    <div class="faq-answers"><div class="open-answer"><div class="question-heading"><strong>{text('数字员工与数字员工模板\n有什么区别？', 'How do employees\nand templates differ?')}</strong><Icon name="chevron" class="expanded-chevron"/></div><p>{text('数字员工模板是静态预制方案资产。数字员工由数字员工模板招募生成，是独立运行的业务实例。', 'A template is a reusable, static solution. A digital employee is an independent running instance recruited from a template.')}</p><div class="answer-terms"><span>{text('数字员工模板 · 方案资产', 'Template · Solution')}</span><span>{text('数字员工 · 运行实例', 'Employee · Running instance')}</span></div></div><div class="closed-question"><span>{text('项目资料的检索范围', 'Where are project sources searched?')}</span><Icon name="plus"/></div><div class="closed-question"><span>{text('各端的文件编辑能力', 'Which clients can edit files?')}</span><Icon name="plus"/></div></div>
  </div>}

  {variant === 'releases' && <div class="releases-scene scene-surface">
    <div class="installer-package"><span class="package-kind">{text('客户端安装包', 'CLIENT INSTALLERS')}</span><span class="installer-icon blue"><Icon name="monitor"/></span><strong>TeGo OS</strong><span class="package-caption">{text('桌面端与移动端', 'Desktop and mobile')}</span><div class="platform-grid"><span>macOS</span><span>Windows</span><span>Linux</span><span>Android · iOS</span></div></div>
    <div class="release-companions"><div class="server-package"><span class="mini-icon cyan"><Icon name="layers"/></span><strong>{text('服务部署包', 'Server bundles')}</strong><p>Compose · {text('服务镜像', 'Service images')}</p><div class="package-format"><span>TAR</span><span>YAML</span></div></div><div class="checksum-package"><span class="mini-icon purple"><Icon name="shield"/></span><strong>{text('校验文件', 'Checksum files')}</strong><p>SHA-256</p><span class="checksum-label">{text('文件完整性校验', 'File integrity verification')}</span></div></div>
  </div>}
</div>

<style>
  .resource-scene{--scene-bg:#1a1c1b;--scene-panel:#323734;--scene-border:#57635d;--scene-text:#f6f8f7;--scene-muted:#bcc5c0;--scene-blue:#9faba5;--scene-cyan:#899790;--scene-purple:#c1c9c5;position:relative;width:100%;height:100%;min-width:0;min-height:0;container-type:inline-size;overflow:hidden;background:var(--scene-bg);color:var(--scene-text);font-family:inherit;text-align:left;line-height:1.45}
  .resource-scene *{box-sizing:border-box}.resource-scene strong,.resource-scene p,.resource-scene span{margin:0}.resource-scene strong{font-weight:600;letter-spacing:-.025em}.resource-scene :global(svg){width:3.4cqw;height:3.4cqw;flex-shrink:0;stroke-width:1.5}.scene-surface{position:absolute;inset:0}.overline{display:block;color:var(--scene-muted);font-size:1.65cqw;font-weight:550;letter-spacing:.1em;line-height:1.4}.blue{color:var(--scene-blue)}.cyan{color:var(--scene-cyan)}.purple{color:var(--scene-purple)}.mini-icon{display:grid;place-items:center;width:5.9cqw;height:5.9cqw;border-radius:1.2cqw;background:#4d5852}.mini-icon :global(svg){width:3.25cqw;height:3.25cqw}.status-dot{display:block;width:1cqw;height:1cqw;flex-shrink:0;border-radius:50%;background:var(--scene-cyan)}

  .desktop-device{position:absolute;left:4cqw;top:4.8cqw;width:73cqw;height:36.5cqw;border:.18cqw solid var(--scene-border);border-radius:1.7cqw;background:linear-gradient(135deg,#3c423f,var(--scene-panel));box-shadow:0 1.4cqw 3cqw #0003}.desktop-project-head{display:flex;align-items:center;gap:1.8cqw;padding:2.4cqw 3cqw}.desktop-project-head .overline{font-size:1.45cqw;margin-bottom:.35cqw}.desktop-project-head strong{display:block;font-size:2.9cqw}.desktop-project-body{display:grid;grid-template-columns:19cqw 1fr;min-height:23cqw;border-top:.15cqw solid var(--scene-border)}.project-navigation{padding:2.4cqw 1.6cqw;display:flex;flex-direction:column;gap:1cqw;color:var(--scene-muted);border-right:.15cqw solid var(--scene-border);font-size:2cqw}.project-navigation>span{display:block;padding:1.15cqw 1.4cqw;border-radius:.7cqw}.project-navigation .selected{color:var(--scene-blue);background:#87958e24}.project-files{padding:3.1cqw 2.7cqw;display:flex;flex-direction:column;gap:2.6cqw}.draft-file{display:flex;align-items:center;gap:1.6cqw}.file-badge{width:5.5cqw;height:6.7cqw;display:grid;place-items:center;background:#535e58;border:.15cqw solid #83938b;border-radius:.65cqw}.project-files strong{display:block;font-size:2.1cqw;line-height:1.4}.project-files div div>span{display:block;font-size:1.7cqw;color:var(--scene-muted);margin-top:.8cqw}.pending-work{padding:1.8cqw 1.5cqw;background:#282c2a;border-radius:.9cqw;display:flex;gap:1.2cqw;align-items:flex-start}.pending-work .status-dot{margin-top:.85cqw}.pending-work strong{font-size:1.95cqw}.device-stand{position:absolute;left:34%;top:100%;width:31%;height:3.5cqw;border-bottom:1.1cqw solid var(--scene-border);background:linear-gradient(90deg,transparent 35%,#48524d 35%,#48524d 65%,transparent 65%)}.mobile-device{position:absolute;right:3.8cqw;top:9cqw;width:23cqw;height:41.5cqw;border:.5cqw solid #798a82;border-radius:3cqw;background:#222524;box-shadow:-1.4cqw 1.7cqw 4cqw #0004;overflow:hidden}.phone-speaker{height:.55cqw;width:6cqw;background:#73837b;border-radius:1cqw;margin:1.25cqw auto 2.3cqw}.mobile-project{padding:0 1.9cqw}.mobile-project .overline{font-size:1.2cqw;letter-spacing:.05em}.mobile-project>strong{display:block;font-size:2.05cqw;line-height:1.4;margin-top:1cqw}.mobile-file{margin-top:3cqw;padding:2.2cqw 1.2cqw;border-radius:1cqw;background:#48524d;color:var(--scene-blue);display:flex;flex-direction:column;gap:1.4cqw;font-size:1.8cqw}.mobile-file :global(svg){width:3.8cqw;height:3.8cqw}.mobile-pending{display:flex;gap:.9cqw;align-items:center;margin-top:3cqw;color:var(--scene-cyan);font-size:1.6cqw}.mobile-project>p{margin-top:1cqw;font-size:1.8cqw;color:var(--scene-text)}.phone-home{position:absolute;width:7cqw;height:.45cqw;border-radius:1cqw;background:#717774;bottom:1.4cqw;left:calc(50% - 3.5cqw)}.client-platforms{display:flex;gap:2.4cqw;position:absolute;left:7cqw;top:47.4cqw;color:var(--scene-muted);font-size:1.8cqw;letter-spacing:.02em}.scene-english .desktop-project-head strong{font-size:2.6cqw}.scene-english .project-files strong{font-size:1.9cqw}.scene-english .mobile-project>strong{font-size:1.85cqw}

  .resource-index{inset:4.5cqw 4.6cqw;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:2.2cqw}.resource-tile{position:relative;padding:2.5cqw 2.7cqw;border:.15cqw solid var(--scene-border);border-radius:1.15cqw;background:linear-gradient(135deg,#3c423f,var(--scene-panel));min-width:0;overflow:hidden}.resource-icon{display:flex;align-items:center;margin-bottom:1.5cqw}.resource-icon :global(svg){width:3.9cqw;height:3.9cqw}.resource-tile>strong{display:block;color:var(--scene-text);font-size:2.65cqw;line-height:1.3}.resource-tile>p{color:var(--scene-muted);font-size:1.85cqw;line-height:1.5;margin-top:1cqw}.resource-tag{display:block;font-size:1.6cqw;margin-top:1.6cqw;line-height:1.35}.scene-english .resource-tile>strong{font-size:2.4cqw}.scene-english .resource-tile>p{font-size:1.75cqw}.scene-english .resource-tag{font-size:1.5cqw}

  .journal-scene{inset:4.8cqw 5cqw;display:grid;grid-template-columns:1.5fr 1fr;gap:4cqw}.journal-main{min-width:0;padding-right:2cqw}.journal-main>.overline{font-size:1.55cqw;letter-spacing:.15em}.article-category{display:block;font-size:1.75cqw;color:var(--scene-muted);line-height:1.4}.journal-main>.article-category{margin-top:3.4cqw}.journal-title{display:block;white-space:pre-line;font-size:4.5cqw;line-height:1.35;margin-top:1.2cqw!important;letter-spacing:-.045em!important}.journal-excerpt{white-space:pre-line;margin-top:2.6cqw!important;font-size:2.05cqw;line-height:1.85;color:var(--scene-muted)}.journal-topics{display:flex;gap:1cqw;margin-top:3.4cqw;font-size:1.6cqw;color:var(--scene-cyan)}.journal-topics>span{padding:.6cqw 1cqw;border:.15cqw solid #58645e;border-radius:.55cqw;background:#303533}.journal-sidebar{border-left:.15cqw solid var(--scene-border);padding-left:3.2cqw;min-width:0}.journal-sidebar>.overline{font-size:1.5cqw}.category-index{display:flex;flex-direction:column;gap:1.6cqw;font-size:1.95cqw;color:var(--scene-muted);margin-top:2.6cqw}.category-index .active{color:var(--scene-text)}.journal-related{padding-top:2.7cqw;margin-top:3cqw;border-top:.15cqw solid var(--scene-border)}.journal-related>.article-category{font-size:1.6cqw;margin-top:1.5cqw}.journal-related>strong{display:block;font-size:2.7cqw;line-height:1.5;white-space:pre-line;margin-top:1cqw}.scene-english .journal-title{font-size:4cqw}.scene-english .journal-excerpt{font-size:1.85cqw;line-height:1.7}.scene-english .category-index{font-size:1.8cqw}.scene-english .journal-related>strong{font-size:2.25cqw}

  .contact-scene{inset:3.8cqw 5.2cqw}.brief-heading{display:flex;align-items:center;justify-content:space-between;gap:2cqw;margin-bottom:2.8cqw}.brief-heading>strong{font-size:2.9cqw}.brief-heading>.overline{font-size:1.6cqw}.requirement-lanes{display:flex;flex-direction:column;gap:1.9cqw}.requirement-lane{display:flex;align-items:center;gap:2.7cqw;padding:2.3cqw 2.8cqw;background:linear-gradient(135deg,#3c423f,var(--scene-panel));border:.15cqw solid var(--scene-border);border-radius:1.1cqw;min-height:11.3cqw}.requirement-icon{display:grid;place-items:center;flex-shrink:0;width:6.7cqw;height:6.7cqw;background:#434946;border-radius:1.4cqw}.requirement-icon :global(svg){width:3.8cqw;height:3.8cqw}.requirement-lane strong{font-size:2.35cqw;display:block}.requirement-lane p{font-size:2.05cqw;color:var(--scene-muted);margin-top:.7cqw}.scene-english .requirement-lane p{font-size:1.85cqw}.scene-english .brief-heading>strong{font-size:2.65cqw}

  .faq-scene{inset:4.4cqw 4.4cqw;display:grid;grid-template-columns:23cqw 1fr;gap:3cqw}.faq-topics{display:flex;flex-direction:column;gap:1.4cqw;min-width:0}.faq-topics>.overline{font-size:1.5cqw;margin-bottom:1.4cqw;padding-left:1.1cqw}.faq-topics>span:not(.overline){display:flex;align-items:center;gap:1.2cqw;font-size:1.9cqw;padding:1.35cqw 1.2cqw;color:var(--scene-muted);border-radius:.8cqw}.faq-topics>span :global(svg){width:2.7cqw;height:2.7cqw}.faq-topics>span.active{background:#87958e24;color:var(--scene-blue)}.faq-answers{min-width:0}.open-answer{padding:2.6cqw;background:linear-gradient(135deg,#3c423f,var(--scene-panel));border:.15cqw solid var(--scene-border);border-radius:1cqw}.question-heading{display:flex;gap:1.5cqw;align-items:flex-start;justify-content:space-between}.question-heading strong{font-size:3cqw;line-height:1.35;white-space:pre-line}.question-heading :global(svg){width:2.8cqw;height:2.8cqw;color:var(--scene-cyan);margin-top:.4cqw;transform:rotate(180deg)}.open-answer>p{font-size:2cqw;line-height:1.75;color:var(--scene-muted);margin-top:1.8cqw}.answer-terms{display:flex;gap:1.2cqw;margin-top:2cqw;flex-wrap:wrap}.answer-terms>span{font-size:1.55cqw;color:var(--scene-cyan);padding:.55cqw .85cqw;background:#313533;border-radius:.45cqw}.closed-question{display:flex;gap:2cqw;align-items:center;justify-content:space-between;padding:2cqw .3cqw;font-size:2cqw;color:var(--scene-muted);border-bottom:.15cqw solid var(--scene-border)}.closed-question :global(svg){width:2.4cqw;height:2.4cqw}.scene-english .question-heading strong{font-size:2.55cqw}.scene-english .open-answer>p{font-size:1.9cqw;line-height:1.6}.scene-english .answer-terms>span{font-size:1.4cqw}.scene-english .closed-question{font-size:1.75cqw}

  .releases-scene{inset:4.8cqw 5cqw;display:grid;grid-template-columns:1fr 1fr;gap:2.5cqw}.installer-package{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:0;padding:2.7cqw;border:.15cqw solid #798a82;border-radius:1.3cqw;background:#3b413e}.package-kind{font-size:1.65cqw;color:var(--scene-muted);letter-spacing:.05em}.installer-icon{display:grid;place-items:center;width:12cqw;height:11cqw;margin-top:2.7cqw;background:#5f6d66;border-radius:1.7cqw}.installer-icon :global(svg){width:7.7cqw;height:7.7cqw;stroke-width:1.2}.installer-package>strong{font-size:3.6cqw;margin-top:2cqw}.package-caption{font-size:1.9cqw;color:var(--scene-muted);margin-top:.6cqw!important}.platform-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.3cqw;width:100%;margin-top:3.3cqw;font-size:1.65cqw;color:#d4d9d6}.platform-grid>span{padding:.8cqw .7cqw;background:#48524d;border-radius:.5cqw;text-align:center;white-space:nowrap}.release-companions{display:grid;grid-template-rows:1fr 1fr;gap:2.4cqw;min-width:0}.server-package,.checksum-package{position:relative;padding:2.6cqw;border:.15cqw solid var(--scene-border);border-radius:1.1cqw;background:var(--scene-panel)}.release-companions .mini-icon{position:absolute;right:2.4cqw;top:2.4cqw;width:4.8cqw;height:4.8cqw}.release-companions .mini-icon :global(svg){width:2.8cqw;height:2.8cqw}.release-companions strong{display:block;font-size:2.7cqw;margin-top:1cqw;max-width:27cqw}.release-companions p{font-size:1.85cqw;color:var(--scene-muted);margin-top:1.5cqw}.package-format{display:flex;gap:1cqw;margin-top:2.1cqw}.package-format>span{font-size:1.55cqw;color:var(--scene-cyan);background:#313533;padding:.5cqw .85cqw;border-radius:.4cqw}.checksum-label{display:block;font-size:1.65cqw;color:var(--scene-muted);margin-top:1.6cqw!important}.scene-english .release-companions strong{font-size:2.4cqw}.scene-english .release-companions p{font-size:1.7cqw}.scene-english .package-kind{font-size:1.45cqw}
</style>
