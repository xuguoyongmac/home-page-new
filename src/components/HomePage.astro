---
import type { Locale } from '../data/types';
import MaterialGlyph from './MaterialGlyph.astro';
import HeroStarfield from './HeroStarfield.astro';
import HeroWorkspace from './HeroWorkspace.astro';
import SolutionExplorer from './SolutionExplorer.astro';
import WorkAnywhere from './WorkAnywhere.astro';
import CallToAction from './CallToAction.astro';
import { pathFor } from '../lib/site';
interface Props { locale: Locale; }
const {locale} = Astro.props;
const zh = locale === 'zh';
const domains = zh ? [
 ['book','知识管理','把企业经验，变成工作依据','制度问答 · 资料检索','government'],
 ['file','方案文书','把分散材料，组织成完整方案','方案编制 · 汇报材料','general'],
 ['chart','经营分析','让业务数据，回答经营问题','指标分析 · 经营简报','securities'],
 ['message','客户经营','梳理客户需求，准备业务沟通','需求整理 · 跟进准备','general'],
 ['layers','招投标协作','读懂采购要求，组织响应材料','条款拆解 · 标书编制','state-owned'],
 ['network','会议协同','把会议共识，接到后续行动','会议纪要 · 事项跟进','general'],
 ['folder','项目协作','让资料与成果，围绕项目协作','资料共享 · 成果审阅','state-owned'],
 ['cpu','研究支持','从海量信息中，整理研究依据','研报速读 · 主题研究','securities'],
] : [
 ['book','Enterprise knowledge','Put company experience within reach','Policy answers · Source retrieval','government'],
 ['file','Proposals & documents','Turn scattered sources into a clear proposal','Proposals · Presentations','general'],
 ['chart','Business analysis','Put business questions to your data','Metrics · Business briefs','securities'],
 ['message','Customer operations','Bring context into the next conversation','Needs · Follow-up preparation','general'],
 ['layers','Bid collaboration','Connect requirements with response materials','Requirements · Bid preparation','state-owned'],
 ['network','Meeting follow-through','Turn shared decisions into next steps','Minutes · Action lists','general'],
 ['folder','Project collaboration','Keep files, discussions and deliverables together','Shared files · Reviews','state-owned'],
 ['cpu','Research support','Organize research with traceable sources','Report reading · Thematic research','securities'],
];
---
<div class="home-value-edition">
<section class="sl-hero" aria-labelledby="home-title" data-hero-motion="running">
  <HeroStarfield/>
  <div class="container hero-center">
    <div class="hero-message">
    <h1 id="home-title" class:list={{'hero-title-zh':zh}}><span>{zh ? '让数字员工，' : 'Bring digital employees'}</span><br/><span>{zh ? '成为团队的一员' : 'into your team.'}</span></h1>
    <p class="sl-hero-description">{zh ? '连接企业知识与业务系统，' : 'Connect knowledge and business tools.'}<br/>{zh ? '与数字员工一起，把工作做成可交付的成果。' : 'Work together. Deliver work that can be reviewed.'}</p>
    <div class="sl-actions"><a class="button" href={pathFor(locale,'contact')}>{zh ? '预约方案交流' : 'Discuss your workflow'}</a><a class="button button-white" href="#solutions">{zh ? '探索行业方案' : 'Explore solutions'}</a></div>
    </div><HeroWorkspace locale={locale}/>

  </div>
</section>
<WorkAnywhere locale={locale}/>
<section class="value-section domain-section" id="work-scenarios" aria-labelledby="domain-title"><div class="container">
  <div class="value-heading"><p class="eyebrow">{zh?'覆盖业务的关键环节':'WHERE WORK HAPPENS'}</p><h2 id="domain-title">{zh?<>把数字员工，<span class="title-second">放到业务最需要的地方</span></>:'Put digital employees where the work needs them'}</h2><p>{zh?'从知识、文书到客户与项目，为不同岗位找到具体的工作切入点。':'Find a concrete starting point across knowledge, documents, customer work and projects.'}</p></div>
  <div class="domain-grid">{domains.map(([icon,title,value,tasks,slug])=><a class="domain-card" href={pathFor(locale,`solutions/${slug}`)}><MaterialGlyph name={icon} size={84}/><h3>{title}</h3><p>{value}</p><span>{tasks}</span></a>)}</div>
</div></section>
<section class="value-section industry-section" id="solutions" aria-labelledby="industry-title"><div class="container"><div class="value-heading"><p class="eyebrow">{zh?'行业解决方案':'INDUSTRY SOLUTIONS'}</p><h2 id="industry-title">{zh?<>深入行业现场，<span class="title-second">解决具体业务难题</span></>:'Industry context. Concrete business challenges.'}</h2><p>{zh?'从高频工作切入，把行业知识、岗位方法与交付要求放进一套协作方案。':'Connect industry knowledge, role methods and deliverables around the work your team does.'}</p></div><SolutionExplorer locale={locale} home/></div></section>
<CallToAction locale={locale} home/>
</div>
