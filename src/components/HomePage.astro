---
import type { Locale } from '../data/types';
import WorkforceMatrix from './WorkforceMatrix.astro';
import HeroCarousel from './HeroCarousel.astro';
import SolutionExplorer from './SolutionExplorer.astro';
import WorkAnywhere from './WorkAnywhere.astro';
import CallToAction from './CallToAction.astro';
interface Props { locale: Locale; }
const {locale} = Astro.props;
const zh = locale === 'zh';

---
<div class="home-value-edition">
<HeroCarousel locale={locale}/>
<WorkAnywhere locale={locale}/>
<WorkforceMatrix locale={locale}/>
<section class="value-section industry-section" id="solutions" aria-labelledby="industry-title"><div class="container"><div class="value-heading"><p class="eyebrow">{zh?'行业解决方案':'INDUSTRY SOLUTIONS'}</p><h2 id="industry-title">{zh?<>让数字员工深入关键业务<br/><span class="title-second">交付看得见的行业成果</span></>:<>Digital employees in critical workflows<br/><span class="title-second">Tangible outcomes for your industry</span></>}</h2><p>{zh?'连接行业知识与业务数据，让数字员工完成分析、核对、编制和跟进，把结论送到业务一线。':'Connect industry knowledge and business data. Put digital employees to work on analysis, checks, preparation and follow-up, bringing findings to the teams who act on them.'}</p></div><SolutionExplorer locale={locale} home/></div></section>
<CallToAction locale={locale} home/>
</div>
