---
import type { Locale } from '../data/types';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const domains = [
  {
    zh: '知识管理', en: 'Knowledge',
    description: { zh: '归集制度与项目资料，检索依据并复用经验。', en: 'Find referenced answers in company documents and reuse project knowledge.' },
  },
  {
    zh: '方案文书', en: 'Documents',
    description: { zh: '结合目标与企业资料，编制方案报告和汇报。', en: 'Develop proposals, reports and presentations from goals and company materials.' },
  },
  {
    zh: '经营分析', en: 'Business analysis',
    description: { zh: '汇总经营指标，拆解趋势与结构并形成行动。', en: 'Analyze business metrics, trends and structure to prepare action priorities.' },
  },
  {
    zh: '客户经营', en: 'Customer operations',
    description: { zh: '梳理客户背景与商机，接续沟通和跟进工作。', en: 'Connect client context, opportunities, conversations and next actions.' },
  },
  {
    zh: '招投标协作', en: 'Bidding',
    description: { zh: '拆解招标要求，核对资质并协同编制响应。', en: 'Review bid requirements and qualifications, then prepare the response together.' },
  },
  {
    zh: '会议协同', en: 'Meetings',
    description: { zh: '提炼会议结论与行动项，形成纪要和跟进事项。', en: 'Turn meeting discussions into minutes, decisions and follow-up actions.' },
  },
  {
    zh: '项目协作', en: 'Projects',
    description: { zh: '共用资料与会话，衔接审阅、交接和成果版本。', en: 'Share files and conversations; connect reviews, handoffs and deliverable versions.' },
  },
  {
    zh: '研究支持', en: 'Research',
    description: { zh: '整理公告研报与行业资料，形成有依据的研究。', en: 'Develop sourced research from announcements, reports and industry materials.' },
  },
];
---
<section class="workforce-matrix" id="work-scenarios" aria-labelledby="domain-title">
  <div class="container matrix-layout">
    <div class="matrix-art">
      <img
        src={`/images/workforce/workforce-matrix-${locale}_V3.4.webp`}
        width="3072" height="2048" loading="lazy" decoding="async"
        alt={zh
          ? '八大业务领域以平行堆叠的界面展开：知识管理、方案文书、经营分析、客户经营、招投标协作、会议协同、项目协作与研究支持。'
          : 'Eight business domains in parallel, layered panels: knowledge management, proposals and writing, business analysis, customer operations, bidding collaboration, meeting collaboration, project collaboration and research support.'}
      />
    </div>
    <div class="matrix-copy">
      <h2 id="domain-title">{zh ? <><span>让数字员工，</span><span>融入业务作业体系</span></> : <><span>Bring digital employees</span><span>into your business workflows</span></>}</h2>
      <p class="matrix-description">{zh ? '八大业务域，将智能能力沉淀为可复用的岗位能力矩阵，贯通全岗位业务流程' : 'Across eight business domains, turn intelligent capabilities into a reusable matrix of role capabilities and connect workflows across every role.'}</p>
      <ul class="matrix-domains" aria-label={zh ? '数字员工业务领域' : 'Digital employee business areas'}>
        {domains.map(domain => (
          <li>
            <h3>{zh ? domain.zh : domain.en}</h3>
            <p>{domain.description[locale]}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .workforce-matrix {
    position: relative;
    overflow: clip;
    background: #060b12;
    padding: var(--section-space) 0;
    padding-top: calc(var(--section-space) - 30px);
  }
  .matrix-layout {
    position: relative;
    min-height: 640px;
    isolation: isolate;
  }
  .matrix-art { width: min(76%, 980px); }
  .matrix-art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
    mask-image: linear-gradient(to bottom, transparent, #000 3%, #000 97%, transparent);
  }
  @media (hover: hover) and (pointer: fine) {
    .matrix-art img { transition: filter 240ms ease-out; }
    .matrix-art:hover img { filter: brightness(1.12); }
  }
  @media (prefers-reduced-motion: reduce) {
    .matrix-art img { transition: none; }
  }
  .matrix-copy {
    position: absolute;
    z-index: 1;
    right: 0;
    top: 50%;
    width: 34%;
    transform: translateY(-50%);
  }
  .workforce-matrix .matrix-copy h2 {
    margin: 0;
    color: #edf5fc;
    font-size: clamp(26px, 2.45vw, 38px);
    line-height: 1.5;
    font-weight: 500;
    letter-spacing: -.7px;
  }
  .matrix-copy h2 span { display: block; }
  .matrix-description {
    margin: 18px 0 0;
    max-width: 440px;
    color: #a4b7ca;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.9;
    text-wrap: pretty;
  }
  .matrix-domains {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
  .matrix-domains li { min-width: 0; }
  .matrix-domains h3 {
    margin: 0;
    color: #d0e0ed;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.7;
  }
  .matrix-domains p {
    margin: 4px 0 0;
    color: #91a7ba;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.8;
    text-wrap: pretty;
  }
  :global(html[lang^="en"]) .matrix-layout { min-height: 760px; }
  :global(html[lang^="en"]) .matrix-domains { gap: 16px 22px; }
  @media (min-width: 1001px) {
    .matrix-art { transform: translateX(-8%); }
  }
  @media (min-width: 1200px) {
    .matrix-copy { right: 8.5%; }
    .matrix-domains {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 150%;
      margin-left: -25%;
    }
  }
  @media (max-width: 1000px) {
    .matrix-layout { min-height: 0; }
    .matrix-art { width: 80%; }
    .matrix-copy { position: relative; right: auto; top: auto; width: min(70%, 600px); margin: -110px 0 0 auto; transform: none; }
    .workforce-matrix .matrix-copy h2 { font-size: 27px; }
    .matrix-domains { gap: 18px 24px; margin-top: 22px; }
    .matrix-description { margin-top: 14px; font-size: 14px; line-height: 1.8; }
    :global(html[lang^="en"]) .matrix-layout { min-height: 0; }
  }
  @media (max-width: 700px) {
    .matrix-art { width: 100%; overflow-x: auto; overscroll-behavior-inline: contain; scrollbar-width: thin; scrollbar-color: #37536b transparent; }
    .matrix-art img { width: 840px; max-width: none; margin-left: -28px; }
    .matrix-copy { width: auto; margin: -58px 0 0 12%; text-align: right; }
    .workforce-matrix .matrix-copy h2 { font-size: 28px; line-height: 1.5; }
    .matrix-description { margin-left: auto; }
    .matrix-domains { gap: 20px 22px; margin-top: 24px; text-align: left; }
    :global(html[lang^="en"]) .matrix-copy { margin-top: -52px; }
    :global(html[lang^="en"]) .matrix-domains { gap: 20px 22px; }
  }
</style>
