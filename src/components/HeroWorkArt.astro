---
import type { Locale } from '../data/types';
import ProductArt from './ProductArt.astro';
const { locale } = Astro.props as { locale: Locale };
---
<div class="launch-work-art" data-work-composition><ProductArt variant="collaboration" locale={locale} idPrefix="launch-collaboration-art"/></div>
<style>
 .launch-work-art{position:absolute;right:max(48px,calc((100vw - 1280px)/2));top:50%;width:min(43vw,620px);transform:translateY(-53%);z-index:-1;pointer-events:none;isolation:isolate}
 .launch-work-art::before{content:'';position:absolute;inset:-25% -12%;background:radial-gradient(ellipse at 75% 60%,#8b9a9248,transparent 58%),radial-gradient(ellipse at 35% 35%,#6a787145,transparent 64%);z-index:-1;filter:blur(25px)}
 @media(min-width:1600px){.launch-work-art{right:max(48px,calc((100vw - 1280px)/2));width:min(43vw,640px)}}
 @media(min-width:801px) and (max-width:1100px){.launch-work-art{width:43vw;right:32px}}
 @media(max-width:800px){
  :global(.launch-slide){display:flex;flex-direction:column;height:auto!important;min-height:740px}
  :global(.launch-slide .launch-slide-inner){height:auto;flex:none;order:1}
  .launch-work-art{position:relative;order:2;top:auto;right:auto;transform:none;width:calc(100% - var(--gutter)*2);max-width:650px;margin:28px auto 105px}
 }
 @media(max-width:480px){.launch-work-art{width:calc(100% - 28px);margin-top:24px;margin-bottom:105px}}
</style>
