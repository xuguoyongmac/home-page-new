---
import Icon from '../Icon.astro';
interface Props { name: string; }
const { name } = Astro.props;
---
<span class="navigation-icon" aria-hidden="true"><Icon name={name} size={22}/></span>
<style>
.navigation-icon{display:grid;place-items:center;width:30px;height:30px;color:inherit}
.navigation-icon :global(svg){stroke-width:1.7}
@media(max-width:1100px){.navigation-icon{width:28px;height:28px}.navigation-icon :global(svg){width:20px;height:20px}}
</style>
