---
import Brand from '../Brand.astro';
import { industries } from '../../data/industries';
import { capabilities } from '../../features/product';
import type { Locale } from '../../data/types';
import { site, pathFor, ui } from '../../lib/site';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = ui[locale];
const contactCodes = [
  {
    src: '/images/contact/wechat-community_V1.0.png',
    size: 396,
    label: zh ? '加入交流群' : 'Join our WeChat group',
    alt: zh ? '微信交流群二维码' : 'QR code to join our WeChat group',
  },
  {
    src: '/images/contact/wechat-official-account_V1.0.jpg',
    size: 1280,
    label: zh ? '关注我们' : 'Follow us',
    alt: zh ? '微信公众号二维码' : 'QR code to follow our WeChat official account',
  },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={pathFor(locale)}><Brand locale={locale}/></a>
      <p>{zh ? 'TeGo 数字员工协作平台' : 'TeGo digital workforce collaboration platform.'}</p>
      <div class="footer-contact-codes">
        {contactCodes.map(code => (
          <figure class="footer-contact-code">
            <div class="footer-qr-image">
              <img src={code.src} alt={code.alt} width={code.size} height={code.size} loading="lazy" decoding="async" />
            </div>
            <figcaption>{code.label}</figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div>
      <h2>{zh ? '产品特性' : 'Product features'}</h2>
      {capabilities.map(capability => <a href={pathFor(locale,`product/${capability.slug}`)}>{capability.copy[locale].name}</a>)}
    </div>
    <div>
      <h2>{zh ? '解决方案' : 'Solutions'}</h2>
      {industries[locale].filter(industry => industry.slug !== 'general').map(industry => <a href={pathFor(locale,`solutions/${industry.slug}`)}>{industry.name}</a>)}
      <a href={pathFor(locale, 'solutions/appliance')}>{zh ? '一体机解决方案' : 'AI appliance solution'}</a>
    </div>
    <div>
      <h2>{zh ? '资源与支持' : 'Resources'}</h2>
      <a href={site.docs}>{t.docs}</a>
      <a href={pathFor(locale,'download')}>{t.download}</a>
      <a href={site.blog}>{t.blog}</a>
    </div>
    <div class="footer-contact">
      <h2>{zh ? '联系我们' : 'Contact us'}</h2>
      <address class="footer-contact-entry">{zh ? '地址：深圳市福田区福田中心区深南路4009号华融大厦' : 'Address: Huarong Building, No. 4009 Shennan Road, Futian Central Area, Futian District, Shenzhen'}</address>
      <a class="footer-contact-entry footer-contact-email" href={`mailto:${site.email}`}><span>{zh ? '邮箱：' : 'Email: '}</span><span class="footer-email-value">{site.email}</span></a>
      <span class="footer-contact-entry" role="link" aria-disabled="true">{zh ? '关于我们' : 'About us'}</span>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>{zh ? '© 2026 深圳市扎马未来科技有限公司' : '© 2026 Shenzhen Zhama Future Technology Co., Ltd.'}</span>
    <a href="https://beian.miit.gov.cn/" rel="external">粤ICP备2025426259号-1</a>
  </div>
</footer>

<style>
  .site-footer .footer-grid {
    grid-template-columns: minmax(220px, 1.35fr) minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, .9fr) minmax(190px, 1.15fr);
    gap: 28px;
  }

  .site-footer .footer-contact-entry {
    display: block;
    margin: 15px 0 9px;
    color: #adbed0;
    font-size: 14px;
    font-weight: 400;
    font-style: normal;
    line-height: 1.85;
  }

  .footer-contact-email { white-space: normal; }
  .footer-email-value { display: inline-block; white-space: nowrap; }

  .site-footer .footer-contact-email:is(:hover, :focus-visible) { color: var(--accent); }

  .footer-contact-email:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .footer-contact-codes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 104px));
    gap: 12px;
    width: min(100%, 220px);
    margin-top: 20px;
  }

  .footer-contact-code {
    min-width: 0;
    margin: 0;
    text-align: center;
  }

  .footer-qr-image {
    padding: 4px;
    background: #fff;
    border-radius: 6px;
    aspect-ratio: 1;
  }

  .footer-qr-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .footer-contact-code figcaption {
    margin-top: 9px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  @media (max-width: 1100px) {
    .site-footer .footer-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .site-footer .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 800px) {
    .site-footer .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .footer-contact { grid-column: 1 / -1; }
  }
</style>
