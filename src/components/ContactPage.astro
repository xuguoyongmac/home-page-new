---
import Icon from './Icon.astro';
import { appFor, site } from '../lib/site';
import type { Locale } from '../data/types';
import PageHeroArt from './PageHeroArt.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const contactApi = import.meta.env.PUBLIC_CONTACT_API_URL || '';
const submitLabel = contactApi ? (zh ? '发送咨询' : 'Send enquiry') : (zh ? '撰写咨询邮件' : 'Compose enquiry email');
const copy = zh ? {
  eyebrow: 'CONTACT', title: '从一项具体工作，\n开始交流。',
  description: '聊聊希望交给数字员工的工作，以及团队现有的资料、系统和部署要求。',
  heading: '一起找到合适的落地点',
  emailTitle: '商务咨询', emailBody: '产品体验、业务集成与企业部署',
  webTitle: '先体验工作空间', webBody: '在浏览器中开始与数字员工协作', webAction: '打开工作空间',
  docsTitle: '了解使用与部署', docsBody: '产品操作、环境要求与常见问题', docsAction: '查看文档中心',
  company: '公司名称', email: '工作邮箱', interest: '关注方向', requirement: '具体工作需求',
  options: [['platform', '平台体验'], ['integration', '业务集成'], ['private', '私有化部署']],
  compose: '撰写咨询邮件', privacy: '请勿填写密码、验证码或客户敏感信息。',
  draft: '邮件草稿', open: '打开邮件应用', copy: '复制邮件草稿',
  fallback: '未打开邮件应用时，可复制草稿发送至 business@zhama.com。',
  noScript: '请直接发送邮件至 business@zhama.com，说明公司、关注方向和工作需求。',
} : {
  eyebrow: 'CONTACT', title: 'Start with the work\nyour team needs done.',
  description: 'Tell us about the task, the systems your team uses, and your deployment requirements.',
  heading: 'Find the right place to start',
  emailTitle: 'Business enquiries', emailBody: 'Product access, integrations, and enterprise deployment',
  webTitle: 'Explore the workspace', webBody: 'Start working with digital employees in your browser', webAction: 'Open workspace',
  docsTitle: 'Using and deploying TeGo', docsBody: 'Product guides, requirements, and common questions', docsAction: 'Read the documentation',
  company: 'Company', email: 'Work email', interest: 'Area of interest', requirement: 'Work requirements',
  options: [['platform', 'Platform access'], ['integration', 'Business integration'], ['private', 'Private deployment']],
  compose: 'Compose enquiry email', privacy: 'Do not include passwords, verification codes, or sensitive customer information.',
  draft: 'Email draft', open: 'Open email app', copy: 'Copy email draft',
  fallback: 'If your email app does not open, copy the draft and send it to business@zhama.com.',
  noScript: 'Email business@zhama.com with your company, area of interest, and work requirements.',
};
---
<section class="page-hero inner-page-hero inner-support-hero">
  <PageHeroArt variant="collaboration" compact/>
  <div class="container inner-hero-content"><div class="inner-hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.description}</p>
  </div></div>
</section>
<section class="container contact-grid inner-contact" aria-label={zh ? '咨询方式' : 'Contact options'}>
  <div class="contact-intro">
    <h2>{copy.heading}</h2>
    <div class="contact-option">
      <Icon name="mail" size={24}/>
      <div><strong>{copy.emailTitle}</strong><p>{copy.emailBody}</p><a class="text-link contact-link" href={`mailto:${site.email}`}>{site.email}<Icon name="external" size={15}/></a></div>
    </div>
    <div class="contact-option">
      <Icon name="globe" size={24}/>
      <div><strong>{copy.webTitle}</strong><p>{copy.webBody}</p><a class="text-link contact-link" href={appFor(locale)}>{copy.webAction}<Icon name="arrow" size={16}/></a></div>
    </div>
    <div class="contact-option">
      <Icon name="book" size={24}/>
      <div><strong>{copy.docsTitle}</strong><p>{copy.docsBody}</p><a class="text-link contact-link" href={site.docs}>{copy.docsAction}<Icon name="arrow" size={16}/></a></div>
    </div>
  </div>
  <form class="contact-form" id="enquiry-form" data-locale={locale} data-recipient={site.email} data-contact-api={contactApi} action={`mailto:${site.email}`} method="post" enctype="text/plain">
    <div class="field-pair">
      <div class="field"><label for="enquiry-company">{copy.company}</label><input id="enquiry-company" name="company" autocomplete="organization" maxlength="160" required /></div>
      <div class="field"><label for="enquiry-email">{copy.email}</label><input id="enquiry-email" name="email" type="email" autocomplete="email" maxlength="254" required /></div>
    </div>
    <div class="field"><label for="enquiry-interest">{copy.interest}</label><select id="enquiry-interest" name="interest" required>{copy.options.map(([value, label]) => <option value={value}>{label}</option>)}</select></div>
    <div class="field"><label for="enquiry-requirement">{copy.requirement}</label><textarea id="enquiry-requirement" name="requirement" rows="5" maxlength="4000" required></textarea></div>
    <p class="contact-privacy">{copy.privacy}</p>
    <button class="button form-submit" type="submit">{submitLabel}<Icon name="mail" size={19}/></button>
    <div class="form-result" id="enquiry-draft" hidden>
      <div class="field"><label for="enquiry-draft-text">{copy.draft}</label><textarea id="enquiry-draft-text" rows="10" readonly spellcheck="false"></textarea></div>
      <p class="draft-fallback">{copy.fallback}</p>
      <div class="draft-actions"><button class="button button-outline button-small" id="copy-enquiry" type="button">{copy.copy}</button><a class="text-link" id="open-enquiry" href={`mailto:${site.email}`}>{copy.open}<Icon name="external" size={14}/></a></div>
      <p id="enquiry-status" role="status" aria-live="polite"></p>
    </div>
    <noscript><p class="form-result">{copy.noScript}</p></noscript>
  </form>
</section>
<style>
  .page-hero h1{white-space:pre-line}.contact-link{margin-top:12px;font-size:13px;overflow-wrap:anywhere}.contact-privacy{font-size:11px;color:var(--muted);line-height:1.8}.draft-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:18px}.draft-fallback{margin-top:12px!important;font-size:12px}.form-result #enquiry-status{margin-top:12px;min-height:1.8em}.form-result textarea{font-size:12px;line-height:1.8;min-height:230px;white-space:pre-wrap;overflow-wrap:anywhere}.contact-form{min-width:0}.field{min-width:0}
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('#enquiry-form');
  const draftPanel = document.querySelector<HTMLElement>('#enquiry-draft');
  const draftText = document.querySelector<HTMLTextAreaElement>('#enquiry-draft-text');
  const openEmail = document.querySelector<HTMLAnchorElement>('#open-enquiry');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-enquiry');
  const status = document.querySelector<HTMLElement>('#enquiry-status');
  if (form && draftPanel && draftText && openEmail && copyButton && status) {
    const chinese = form.dataset.locale === 'zh';
    const recipient = form.dataset.recipient || 'business@zhama.com';
    const company = form.elements.namedItem('company') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const interest = form.elements.namedItem('interest') as HTMLSelectElement;
    const requirement = form.elements.namedItem('requirement') as HTMLTextAreaElement;
    const updateDraft = () => {
      const companyName = company.value.trim().replace(/[\r\n]+/g, ' ');
      const direction = interest.selectedOptions[0]?.textContent?.trim() || '';
      const subject = chinese ? `TeGo 咨询｜${direction}｜${companyName}` : `TeGo enquiry | ${direction} | ${companyName}`;
      const body = chinese
        ? `公司名称：${companyName}\r\n工作邮箱：${email.value.trim()}\r\n关注方向：${direction}\r\n\r\n具体工作需求：\r\n${requirement.value.trim()}`
        : `Company: ${companyName}\r\nWork email: ${email.value.trim()}\r\nArea of interest: ${direction}\r\n\r\nWork requirements:\r\n${requirement.value.trim()}`;
      draftText.value = chinese ? `收件人：${recipient}\n主题：${subject}\n\n${body}` : `To: ${recipient}\nSubject: ${subject}\n\n${body}`;
      openEmail.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      if (!company.value.trim() || !requirement.value.trim()) {
        const emptyField = company.value.trim() ? requirement : company;
        emptyField.setCustomValidity(chinese ? '请填写具体内容。' : 'Enter a value.');
        emptyField.reportValidity();
        emptyField.addEventListener('input', () => emptyField.setCustomValidity(''), { once: true });
        return;
      }
      updateDraft();
      draftPanel.hidden = false;
      status.textContent = chinese ? '邮件草稿已准备，可打开邮件应用或复制后发送。' : 'Your email draft is ready. Open your email app or copy it to send.';
      draftText.focus();
      const endpoint = form.dataset.contactApi;
      if (!endpoint) return;
      const submit = form.querySelector<HTMLButtonElement>('[type="submit"]');
      if (submit) submit.disabled = true;
      form.setAttribute('aria-busy', 'true');
      status.textContent = chinese ? '正在发送咨询。' : 'Sending your enquiry.';
      try {
        const response = await fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title: `${interest.selectedOptions[0]?.textContent}｜${company.value.trim()}`,
            email: email.value.trim(), content: draftText.value, timestamp: new Date().toISOString(),
          }), signal: AbortSignal.timeout(20000),
        });
        const result = await response.json();
        if (!response.ok || result.success !== true) throw new Error(result.message || (chinese ? '咨询服务未能接收本次请求。' : 'The enquiry service could not accept the request.'));
        status.textContent = chinese ? '咨询已发送，我们会通过工作邮箱联系。' : 'Enquiry sent. We will reply to your work email.';
      } catch (error) {
        const reason = error instanceof Error ? error.message : '';
        status.textContent = chinese ? `咨询未发送。${reason} 可复制草稿，通过邮件发送。` : `Enquiry was not sent. ${reason} Copy the draft to send it by email.`;
      } finally {
        if (submit) submit.disabled = false;
        form.removeAttribute('aria-busy');
      }
    });
    form.addEventListener('input', () => {
      if (draftPanel.hidden) return;
      updateDraft();
      status.textContent = '';
    });
    copyButton.addEventListener('click', async () => {
      updateDraft();
      try {
        if (!navigator.clipboard?.writeText) throw new Error('Clipboard unavailable');
        await navigator.clipboard.writeText(draftText.value);
        status.textContent = chinese ? '邮件草稿已复制，可粘贴到邮件应用后发送。' : 'Email draft copied. Paste it into your email app to send.';
      } catch {
        draftText.focus();
        draftText.select();
        draftText.setSelectionRange(0, draftText.value.length);
        status.textContent = chinese ? '无法写入剪贴板，已选中草稿，请手动复制后发送。' : 'Clipboard access was blocked. The draft is selected; copy it manually to send.';
      }
    });
  }
</script>
