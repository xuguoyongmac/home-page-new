---
import releaseIndex from '../../public/releases/index.json';
import { releaseArchive } from '../data/legacy';
import type { Locale } from '../data/types';
import Shell from '../features/resources/Shell.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const products: Record<string, string> = zh
  ? { desktop: 'TeGo OS 桌面端', mobile: 'TeGo OS 移动端', studio: 'Tego Studio' }
  : { desktop: 'TeGo OS Desktop', mobile: 'TeGo OS Mobile', studio: 'Tego Studio' };
const clientFiles = releaseIndex.files.filter(file => Object.hasOwn(products, file.product));
const versions = releaseIndex.versions.filter(version => clientFiles.some(file => file.version === version));
const defaultVersion = versions.includes(releaseArchive.defaultVersion) ? releaseArchive.defaultVersion : versions[0];
const manifestLabel = (file: (typeof clientFiles)[number]) => [products[file.product], file.arch || ''].filter(Boolean).join(' · ');
const defaultFiles = clientFiles.filter(file => file.version === defaultVersion);
const config = { versions, files: clientFiles.map(({ path, version, product, arch }) => ({ path, version, product, arch })), defaultVersion };
---
<Shell locale={locale} page="releases" navigation={false}>
<header class="support-hero release-hero"><div class="container"><h1>{zh ? '客户端历史版本' : 'Client release history'}</h1></div></header>
<section class="container release-history inner-releases" data-release-config={JSON.stringify(config)} data-locale={locale} aria-label={zh ? '版本选择' : 'Release selection'}>
  <div class="release-controls field-pair">
    <div class="field"><label for="release-version">{zh ? '发布版本' : 'Release version'}</label><select id="release-version" aria-controls="release-items">{versions.map(version => <option value={version} selected={version === defaultVersion}>{version}</option>)}</select></div>
    <div class="field"><label for="release-manifest">{zh ? '产品' : 'Product'}</label><select id="release-manifest" aria-controls="release-items">{defaultFiles.map(file => <option value={file.path}>{manifestLabel(file)}</option>)}</select></div>
  </div>
  <p class="release-notice" id="release-version-notice" hidden></p>
  <div class="release-status-row"><p id="release-status" role="status" aria-live="polite">{zh ? '正在读取所选版本的安装包。' : 'Retrieving packages for the selected release.'}</p><button id="release-retry" class="filter-button" type="button" hidden>{zh ? '重试' : 'Retry'}</button></div>
  <div class="release-items" id="release-items" aria-busy="true"></div>
  <noscript><p class="release-notice">{zh ? '请启用 JavaScript 查看历史版本。' : 'Enable JavaScript to view client releases.'}</p></noscript>
</section>
</Shell>
<style>
.release-hero{padding:44px 0 36px}
.release-history{padding:0 0 80px}
.release-controls{display:grid;grid-template-columns:1fr 1.5fr;max-width:950px;gap:24px;margin-bottom:28px}
.release-controls label{color:#b7cada;font-size:13px;margin-bottom:10px}
.release-controls select{width:100%;min-height:49px;background:#0e2031;color:#e7f4ff;border:1px solid #799fbe55;border-radius:10px;font:inherit;font-size:14px;padding:10px 14px}
.release-notice{font-size:14px;color:#a9c6dd;line-height:1.8;margin-top:18px}
.release-status-row{display:flex;align-items:center;gap:18px;min-height:65px;margin:17px 0}
.release-status-row p{font-size:14px;color:#a9bfd3;line-height:1.8}
.release-status-row button{background:#133650;color:#d6eeff;border:1px solid #4c7c9d;border-radius:30px;padding:7px 18px;cursor:pointer}
.release-items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.release-items :global(.download-card){min-width:0;display:flex;flex-direction:column;padding:22px;background:#0d1c2c;border:1px solid #94bdd324;border-radius:16px}
.release-items :global(.release-card-heading){display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.release-items :global(.download-card h2){font-size:22px;margin:0;overflow-wrap:anywhere}
.release-items :global(.download-version){display:block;font-size:13px;color:#aac5dc;margin:0 0 9px;padding:0;background:none;white-space:nowrap}
.release-items :global(.release-card-heading>.download-version){margin:0}
.release-items :global(.release-client-variant){margin-top:20px}
.release-items :global(.release-download){display:flex;align-items:center;justify-content:center;padding:11px 13px;min-height:46px;border:1px solid #4d9fd34d;background:#0a2b43;border-radius:9px;color:#bce6ff;font-size:14px;font-weight:500;text-align:center}
.release-items :global(.release-download:hover),.release-items :global(.release-download:focus-visible){background:#104666;border-color:#5abcf8;color:#fff}
@media(max-width:1100px){.release-items{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.release-hero{padding:32px 0 26px}.release-controls{grid-template-columns:1fr;gap:20px}.release-items{grid-template-columns:1fr}.release-history{padding-bottom:55px}.release-items :global(.download-card){padding:24px}.release-status-row{align-items:flex-start;flex-direction:column;gap:10px;padding-block:10px}}
</style>
<script>
  interface ManifestFile { path: string; version: string; product: string; arch: string | null; }
  interface ReleaseConfig { versions: string[]; files: ManifestFile[]; defaultVersion: string; }
  type Manifest = Record<string, unknown>;
  const historyRoot = document.querySelector<HTMLElement>('[data-release-config]');
  const versionSelect = document.querySelector<HTMLSelectElement>('#release-version');
  const manifestSelect = document.querySelector<HTMLSelectElement>('#release-manifest');
  const items = document.querySelector<HTMLElement>('#release-items');
  const releaseStatus = document.querySelector<HTMLElement>('#release-status');
  const versionNotice = document.querySelector<HTMLElement>('#release-version-notice');
  const retry = document.querySelector<HTMLButtonElement>('#release-retry');
  if (historyRoot && versionSelect && manifestSelect && items && releaseStatus && versionNotice && retry) {
    const chinese = historyRoot.dataset.locale === 'zh';
    const config = JSON.parse(historyRoot.dataset.releaseConfig || '{}') as ReleaseConfig;
    const productLabels: Record<string, string> = chinese
      ? { desktop: 'TeGo OS 桌面端', mobile: 'TeGo OS 移动端', studio: 'Tego Studio' }
      : { desktop: 'TeGo OS Desktop', mobile: 'TeGo OS Mobile', studio: 'Tego Studio' };
    const platformLabels: Record<string, string> = { windows: 'Windows', macos: 'macOS', linux: 'Linux', kylin: chinese ? '银河麒麟' : 'Kylin', android: 'Android', ios: 'iOS' };
    const preferredFormats = ['dmg', 'exe', 'AppImage', 'flatpak', 'apk', 'testflight'];
    const primaryDownload = (downloads: { format: string; url: string }[]) => preferredFormats.map(format => downloads.find(download => download.format === format)).find(Boolean) ?? downloads[0];
    const architecture = (platform: string, arch: string) => {
      if (arch === 'downloads') return '';
      if (platform === 'macos' && arch === 'arm64') return 'Apple silicon · ARM64';
      if (platform === 'macos' && arch === 'x64') return 'Intel · x64';
      if (arch === 'x86') return chinese ? 'x86 · 32 位' : 'x86 · 32-bit';
      if (arch === 'x64') return chinese ? 'x64 · 64 位' : 'x64 · 64-bit';
      return arch === 'arm64' ? 'ARM64' : arch;
    };
    const downloadLabel = (platform: string, arch: string, format: string) => format === 'testflight'
      ? (chinese ? '打开 TestFlight' : 'Open TestFlight')
      : architecture(platform, arch) || `${chinese ? '下载' : 'Download'} ${platformLabels[platform] || platform}`;
    let controller: AbortController | undefined;
    const record = (value: unknown): value is Manifest => typeof value === 'object' && value !== null && !Array.isArray(value);
    const text = (value: unknown) => typeof value === 'string' ? value : '';
    const allowedDownload = (value: unknown) => {
      if (typeof value !== 'string') return null;
      try {
        const url = new URL(value);
        return url.protocol === 'https:' && ['cdn.zhama.com.cn', 'testflight.apple.com'].includes(url.hostname) && !url.username && !url.password && (!url.port || url.port === '443') ? value : null;
      } catch { return null; }
    };
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, value = '', className = '') => {
      const element = document.createElement(tag);
      element.textContent = value;
      if (className) element.className = className;
      return element;
    };
    const link = (label: string, href: string) => {
      const element = make('a', label, 'release-download');
      element.href = href;
      return element;
    };
    const renderManifest = (manifest: Manifest, file: ManifestFile) => {
      const content = document.createDocumentFragment();
      let count = 0;
      let blocked = 0;
      const product = productLabels[file.product] || file.product;
      const version = text(manifest.version) || file.version;
      if (record(manifest.platforms)) {
        const versions = record(manifest.targetVersions) ? manifest.targetVersions : {};
        Object.entries(manifest.platforms).forEach(([platform, targets]) => {
          if (!record(targets)) return;
          const variants: { arch: string; version: string; downloads: { format: string; url: string }[] }[] = [];
          Object.entries(targets).forEach(([arch, formats]) => {
            if (!record(formats)) return;
            const downloads: { format: string; url: string }[] = [];
            Object.entries(formats).forEach(([format, rawUrl]) => {
              const url = allowedDownload(rawUrl);
              if (url) downloads.push({ format, url }); else blocked += 1;
            });
            if (!downloads.length) return;
            const target = arch === 'downloads' ? platform : `${platform}/${arch}`;
            variants.push({ arch, downloads, version: text(versions[target]) || version });
          });
          if (!variants.length) return;
          const order = platform === 'macos' ? ['arm64', 'x64', 'x86'] : ['x64', 'arm64', 'x86'];
          variants.sort((a, b) => order.indexOf(a.arch) - order.indexOf(b.arch));
          const platformTitle = platformLabels[platform] || platform;
          const sharedVersion = variants.every(variant => variant.version === variants[0].version);
          const card = make('article', '', 'download-card');
          card.setAttribute('aria-label', `${product} ${platformTitle}`);
          const heading = make('div', '', 'release-card-heading');
          heading.append(make('h2', platformTitle));
          if (sharedVersion) heading.append(make('span', variants[0].version, 'download-version'));
          card.append(heading);
          variants.forEach(variant => {
            const panel = make('div', '', 'release-client-variant');
            if (!sharedVersion) panel.append(make('span', variant.version, 'download-version'));
            const { format, url } = primaryDownload(variant.downloads);
            const label = downloadLabel(platform, variant.arch, format);
            const download = link(label, url);
            download.setAttribute('aria-label', [product, platformTitle, label, variant.version].join(' · '));
            panel.append(download);
            card.append(panel);
          });
          content.append(card); count += 1;
        });
      }
      items.replaceChildren(content);
      releaseStatus.textContent = count
        ? (blocked ? (chinese ? '部分安装包地址不可用。' : 'Some package links are unavailable.') : '')
        : (chinese ? '所选版本没有可下载的客户端，请选择其他产品或版本。' : 'No client packages are available. Choose another product or release.');
      releaseStatus.parentElement!.hidden = count > 0 && blocked === 0;
    };
    const loadManifest = async () => {
      controller?.abort();
      const currentController = new AbortController();
      controller = currentController;
      const file = config.files.find(entry => entry.path === manifestSelect.value && entry.version === versionSelect.value);
      retry.hidden = true;
      releaseStatus.parentElement!.hidden = false;
      items.replaceChildren();
      items.setAttribute('aria-busy', 'true');
      if (!file) {
        releaseStatus.textContent = chinese ? '当前版本未收录所选产品，请选择其他产品或版本。' : 'This product is not listed. Choose another product or release.';
        items.setAttribute('aria-busy', 'false'); return;
      }
      releaseStatus.textContent = chinese ? '正在读取所选版本的安装包。' : 'Retrieving packages for the selected release.';
      try {
        const url = new URL(file.path, location.origin);
        if (url.origin !== location.origin || !url.pathname.startsWith('/releases/manifests/')) throw new Error(chinese ? '发布清单路径不在本站版本目录中' : 'Manifest path is outside the release directory');
        const response = await fetch(url, { signal: currentController.signal, credentials: 'same-origin' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        let manifest: unknown;
        try { manifest = await response.json(); } catch { throw new Error(chinese ? '清单不是有效的 JSON' : 'Manifest is not valid JSON'); }
        if (!record(manifest) || manifest.schemaVersion !== 1) throw new Error(chinese ? '清单结构无法识别' : 'Manifest schema is not supported');
        if (!currentController.signal.aborted) renderManifest(manifest, file);
      } catch (error) {
        if (currentController.signal.aborted) return;
        const reason = error instanceof Error ? error.message : (chinese ? '连接中断' : 'Connection interrupted');
        releaseStatus.textContent = chinese ? `无法读取所选版本（${reason}）。请重试。` : `Could not retrieve the selected release (${reason}). Retry.`;
        retry.hidden = false;
      } finally {
        if (controller === currentController) items.setAttribute('aria-busy', 'false');
      }
    };
    const params = new URL(location.href).searchParams;
    let preferredProduct = Object.hasOwn(productLabels, params.get('product') || '') ? params.get('product')! : '';
    let preferredPath = '';
    const selectVersion = (updateUrl: boolean) => {
      const files = config.files.filter(file => file.version === versionSelect.value);
      const options = document.createDocumentFragment();
      files.forEach(file => {
        const option = make('option', [productLabels[file.product], file.arch].filter(Boolean).join(' · '));
        option.value = file.path; options.append(option);
      });
      manifestSelect.replaceChildren(options);
      const preferred = files.find(file => file.path === preferredPath) || files.find(file => file.product === preferredProduct);
      if(preferred) manifestSelect.value = preferred.path;
      else if(preferredProduct && files.length){
        const missing = make('option', chinese ? '该版本未收录所选产品，请选择其他产品' : 'This product is not listed; choose another product');
        missing.value = ''; missing.disabled = true; missing.selected = true; manifestSelect.prepend(missing);
      }
      manifestSelect.disabled = files.length === 0;
      if (updateUrl) {
        const url = new URL(location.href); url.searchParams.set('version', versionSelect.value); history.replaceState(null, '', url);
        versionNotice.hidden = true;
      }
      void loadManifest();
    };
    const requested = params.get('version');
    versionSelect.value = requested && config.versions.includes(requested) ? requested : config.defaultVersion;
    if (requested && !config.versions.includes(requested)) {
      versionNotice.hidden = false;
      versionNotice.textContent = chinese ? `链接中的版本未收录，当前显示 ${config.defaultVersion}。` : `The requested version is not listed. Showing ${config.defaultVersion}.`;
    }
    versionSelect.addEventListener('change', () => selectVersion(true));
    manifestSelect.addEventListener('change', () => {
      const file = config.files.find(entry => entry.path === manifestSelect.value);
      preferredProduct = file?.product || ''; preferredPath = file?.path || '';
      const url = new URL(location.href); url.searchParams.set('version',versionSelect.value);
      if(preferredProduct)url.searchParams.set('product',preferredProduct); else url.searchParams.delete('product');
      history.replaceState(null,'',url); void loadManifest();
    });
    retry.addEventListener('click', () => { void loadManifest(); });
    selectVersion(false);
  }
</script>
