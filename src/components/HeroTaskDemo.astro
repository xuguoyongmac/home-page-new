---
import type { Locale } from '../data/types';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const zh = locale === 'zh';
const description = zh
  ? '语音交办客户经营分析任务并转成文字，数字员工跨系统取数、分析资产变化、识别跟进客户，交付经营简报与客户清单。'
  : 'A voice request becomes a written client-review task. The digital employee connects business systems, analyzes asset changes, identifies retention risks, and delivers a briefing and follow-up list.';
const poster = `/images/hero/task-execution-${locale}-poster_V1.2.webp`;
---
<div class="banner-execution-visual banner-visual">
  <div class="execution-concept" role="img" aria-label={description}>
    <img class="execution-video-poster" data-hero-src={poster} alt="" width="1600" height="1000" loading="lazy" decoding="async" />
    <video class="execution-video" data-hero-task-video muted playsinline loop preload="none" width="1600" height="1000" aria-hidden="true" tabindex="-1">
      <source data-hero-src={`/images/hero/task-execution-${locale}_V1.2.webm`} type="video/webm" />
    </video>
  </div>
</div>
